@{
    Layout = null;
    ViewData["Title"] = "About Zaytouna";
    ViewData["ZtPage"] = "about";
}
<!DOCTYPE html>
<html lang="en">
<head>
@await Html.PartialAsync("_ZtHead")
<style>
html{scrollbar-width:auto}html::-webkit-scrollbar{display:block}
.zab-eye{font-family:'DM Mono',monospace;font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:#4E6B2F}
.zab-h2{margin:14px 0 16px;font-family:'Bricolage Grotesque',sans-serif;font-weight:600;font-size:clamp(36px,4.6vw,62px);line-height:1.02;letter-spacing:-.015em;color:#17402A}
.zab-h2 em,.zab-h1 em{font-family:'Cormorant Garamond',Georgia,serif;font-style:italic;font-weight:500;color:#B9800C;letter-spacing:0}
.zab-p{margin:0;max-width:520px;font-size:17px;line-height:1.65;color:#4A5A4E}
.zab-wrap{max-width:1280px;margin:0 auto;padding:0 32px}
/* 1 rings */
.zab-hero{position:relative;background:#17402A;color:#FBF3DF;padding:150px 0 100px;overflow:hidden}
.zab-hero .zab-wrap{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:40px;align-items:center}
.zab-crumbs{display:flex;gap:10px;font-family:'DM Mono',monospace;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#B9C7A8}.zab-crumbs a{color:#DCEB4B;text-decoration:none}
.zab-h1{margin:18px 0 18px;font-family:'Bricolage Grotesque',sans-serif;font-weight:600;font-size:clamp(44px,6vw,86px);line-height:.98;letter-spacing:-.02em}
.zab-h1 em{color:#E9C46A}
.zab-hero .zab-p{color:#C9D3BC}
.zab-ms{list-style:none;margin:28px 0 0;padding:0;position:relative;min-height:120px}
.zab-ms li{position:absolute;inset:0;opacity:0;transform:translateY(10px);transition:opacity .45s,transform .5s;pointer-events:none}
.zab-ms li.on{opacity:1;transform:none}
.zab-ms span{font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:56px;line-height:1;color:#DCEB4B}
.zab-ms b{display:block;margin:8px 0 4px;font-size:20px}.zab-ms small{font-size:15px;color:#C9D3BC;line-height:1.5}
.zab-trunk{position:relative;width:100%;max-width:620px;justify-self:end}
.zab-trunk svg{width:100%;height:auto;display:block;overflow:visible}
.zab-bark{fill:#3B2717;stroke:#24170C;stroke-width:6}
.zab-wood{fill:url(#zab-woodg)}
.zab-ring{fill:none;stroke:#8A5A2B;opacity:.55;stroke-dasharray:1;stroke-dashoffset:1;animation:zab-draw 1.2s var(--d) cubic-bezier(.4,0,.2,1) forwards;transition:stroke .3s,opacity .3s}
.zab-ring.hl{stroke:#DCEB4B;opacity:1;stroke-width:3}
@@keyframes zab-draw{to{stroke-dashoffset:0}}
.zab-crack{stroke:#5A3A1E;stroke-width:1.4;fill:none;opacity:.5}
.zab-dot{cursor:pointer;opacity:0;animation:zab-in .5s calc(1.3s + var(--i,0)*.08s) forwards}
.zab-dot circle:nth-child(2){fill:#FBF3DF;stroke:#17402A;stroke-width:2;transition:fill .3s}
.zab-dot-halo{fill:#DCEB4B;opacity:0;transition:opacity .3s}
.zab-dot text{font:700 12px 'DM Mono',monospace;fill:#FBF3DF;opacity:0;transition:opacity .3s;paint-order:stroke;stroke:#3B2717;stroke-width:3px}
.zab-dot.on circle:nth-child(2){fill:#DCEB4B}.zab-dot.on .zab-dot-halo{opacity:.35}.zab-dot.on text,.zab-dot:hover text{opacity:1}
.zab-dot:focus{outline:none}
@@keyframes zab-in{to{opacity:1}}
.zab-hint{position:absolute;left:50%;bottom:-6px;transform:translateX(-50%);font-family:'DM Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#B9C7A8}
/* 2 letter */
.zab-letter{background:#FBF3DF;padding:120px 0}
.zab-letter .zab-wrap{display:grid;grid-template-columns:minmax(0,.75fr) minmax(0,1.25fr);gap:70px;align-items:center}
.zab-polaroid{position:relative;justify-self:center;width:min(340px,100%);padding:16px 16px 60px;background:#fff;box-shadow:0 30px 60px -30px rgba(16,38,26,.5);transform:rotate(-4deg)}
.zab-polaroid img{display:block;width:100%;aspect-ratio:1;object-fit:cover;filter:sepia(.55) contrast(1.05) saturate(.8)}
.zab-polaroid span{position:absolute;left:0;right:0;bottom:18px;text-align:center;font-family:'Cormorant Garamond',serif;font-style:italic;font-size:21px;color:#3A2A1A}
.zab-polaroid::before{content:"";position:absolute;left:50%;top:-14px;width:110px;height:30px;margin-left:-55px;background:rgba(240,228,194,.85);transform:rotate(3deg)}
.zab-paper{position:relative;padding:44px 48px 40px;background:#FFFCF3;border-radius:6px;box-shadow:0 30px 60px -36px rgba(16,38,26,.45);background-image:repeating-linear-gradient(0deg,rgba(23,64,42,.06) 0 1px,transparent 1px 36px);background-position:0 30px}
.zab-paper p{margin:0;font-family:'Cormorant Garamond',Georgia,serif;font-size:clamp(20px,2vw,25px);line-height:36px;color:#2A3A2E}
.zab-paper p+p{margin-top:12px}
.zab-line{opacity:0;filter:blur(4px);transform:translateY(6px);transition:opacity .7s,filter .7s,transform .7s}
.zab-line.in{opacity:1;filter:none;transform:none}
.zab-sign{display:flex;align-items:flex-end;gap:18px;margin-top:20px}
.zab-sign svg{width:200px;height:auto}
.zab-sign path{fill:none;stroke:#17402A;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:1;stroke-dashoffset:1;transition:stroke-dashoffset 2.2s cubic-bezier(.4,0,.2,1)}
.zab-sign.in path{stroke-dashoffset:0}
.zab-sign small{font-family:'DM Mono',monospace;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#6A7A6E;padding-bottom:10px}
/* 3 wheel */
.zab-year{position:relative;height:300vh;background:#F0E4C2}
.zab-year-in{position:sticky;top:0;height:100vh;display:flex;align-items:center;overflow:hidden}
.zab-year .zab-wrap{width:100%;display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:40px;align-items:center}
.zab-wheelbox{position:relative;width:min(600px,78vh);aspect-ratio:1;justify-self:center}
.zab-wheel{position:absolute;inset:0;transition:transform .2s linear}
.zab-wheel svg{width:100%;height:100%}
.zab-seg{fill:#FFFCF3;stroke:#F0E4C2;stroke-width:4;transition:fill .4s}
.zab-seg.harvest{fill:#E7EDC9}
.zab-seg.on{fill:#17402A}
.zab-mlab{font:600 13px 'DM Mono',monospace;letter-spacing:.14em;fill:#17402A;transition:fill .4s}
.zab-mlab.on{fill:#DCEB4B}
.zab-pointer{position:absolute;left:50%;top:-6px;width:0;height:0;margin-left:-12px;border-left:12px solid transparent;border-right:12px solid transparent;border-top:20px solid #B9800C;z-index:2}
.zab-hub{position:absolute;inset:24%;border-radius:50%;background:#17402A;color:#FBF3DF;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:24px;box-sizing:border-box;box-shadow:inset 0 0 0 8px rgba(220,235,75,.15)}
.zab-hub small{font-family:'DM Mono',monospace;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:#DCEB4B}
.zab-hub b{margin:8px 0 6px;font-family:'Bricolage Grotesque',sans-serif;font-size:clamp(22px,2.6vw,32px);line-height:1.05}
.zab-hub span{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:19px;color:#E9C46A}
.zab-buy{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px}
.zab-buy span{padding:8px 14px;border-radius:999px;background:#17402A;color:#FBF3DF;font-size:14px;font-weight:600;animation:zab-chip .4s both}
@@keyframes zab-chip{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.zab-buy-lbl{margin-top:26px;font-family:'DM Mono',monospace;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:#6A7A6E}
/* 4 map */
.zab-journey{background:#FBF3DF;padding:120px 0}
.zab-journey .zab-wrap{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:60px;align-items:center}
.zab-map{position:relative;justify-self:center;width:min(460px,100%)}
.zab-map svg{width:100%;height:auto;display:block;overflow:visible}
.zab-route-bg{fill:none;stroke:rgba(185,128,12,.25);stroke-width:3;stroke-dasharray:4 5}
.zab-route{fill:none;stroke:#E0A215;stroke-width:3.4;stroke-linecap:round}
.zab-st circle:last-child{fill:#FBF3DF;stroke:#17402A;stroke-width:1.6;transition:fill .3s}
.zab-st-h{fill:#DCEB4B;opacity:0;transition:opacity .3s}
.zab-st.on circle:last-child{fill:#17402A}.zab-st.on .zab-st-h{opacity:.5}
.zab-drop{fill:url(#zab-dropg)}
.zab-stlist{list-style:none;margin:30px 0 0;padding:0;display:grid}
.zab-stlist li{display:grid;grid-template-columns:40px 1fr;column-gap:12px;padding:14px 0;border-top:1px solid rgba(23,64,42,.15);opacity:.35;transition:opacity .4s}
.zab-stlist li.on{opacity:1}
.zab-stlist span{grid-row:1/3;font-family:'DM Mono',monospace;font-size:12px;color:#B9800C;padding-top:3px}
.zab-stlist b{font-size:18px;color:#17402A}.zab-stlist small{font-size:14px;color:#5A6A5E}
/* 5 waste */
.zab-waste{background:#17402A;color:#FBF3DF;padding:120px 0 130px;text-align:center;overflow:hidden}
.zab-waste .zab-h2{color:#FBF3DF}.zab-waste .zab-h2 em{color:#E9C46A}.zab-waste .zab-eye{color:#DCEB4B}
.zab-waste .zab-p{margin:0 auto;color:#C9D3BC}
.zab-burst{position:relative;width:min(820px,100%);height:460px;margin:50px auto 0}
.zab-olive{position:absolute;left:50%;top:50%;width:150px;height:190px;margin:-95px 0 0 -75px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#C9D84A,#6E8F3A 55%,#2E4A1A);box-shadow:0 30px 50px -20px rgba(0,0,0,.6);transition:transform .9s cubic-bezier(.3,1.4,.5,1)}
.zab-olive::after{content:"";position:absolute;left:28%;top:16%;width:22%;height:16%;border-radius:50%;background:rgba(255,255,255,.35);filter:blur(2px)}
.zab-waste.in .zab-olive{transform:scale(.82)}
.zab-part{position:absolute;left:50%;top:50%;width:200px;margin:-60px 0 0 -100px;display:flex;flex-direction:column;align-items:center;gap:8px;opacity:0;transform:translate(0,0) scale(.3);transition:transform 1s cubic-bezier(.2,.8,.2,1),opacity .6s}
.zab-waste.in .zab-part{opacity:1;transform:translate(var(--x),var(--y))}
.zab-part:nth-of-type(2){transition-delay:.12s}.zab-part:nth-of-type(3){transition-delay:.24s}.zab-part:nth-of-type(4){transition-delay:.36s}
.zab-part i{display:grid;place-items:center;width:78px;height:78px;border-radius:50%;background:#FBF3DF;color:#17402A;font-style:normal;font-size:34px;box-shadow:0 0 0 6px rgba(220,235,75,.18)}
.zab-part b{font-size:17px}.zab-part small{font-size:13.5px;color:#C9D3BC;line-height:1.4}
.zab-burst svg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
.zab-burst line{stroke:rgba(220,235,75,.35);stroke-width:1.5;stroke-dasharray:4 6;opacity:0;transition:opacity .6s .6s}
.zab-waste.in .zab-burst line{opacity:1}
/* 6 jars */
.zab-nums{background:#FBF3DF;padding:120px 0 100px}
.zab-jars{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:50px}
.zab-jar{display:flex;flex-direction:column;align-items:center;text-align:center;gap:6px}
.zab-jar-g{position:relative;width:150px;height:190px;margin-bottom:14px}
.zab-jar-lid{position:absolute;left:22px;right:22px;top:0;height:22px;border-radius:5px;background:linear-gradient(90deg,#9A7A12,#E0C74A,#9A7A12)}
.zab-jar-body{position:absolute;left:0;right:0;top:20px;bottom:0;border-radius:22px 22px 26px 26px;border:3px solid rgba(23,64,42,.25);background:rgba(255,255,255,.5);overflow:hidden}
.zab-jar-oil{position:absolute;left:0;right:0;bottom:0;height:0;background:linear-gradient(180deg,#F3C437,#C98A0C);transition:height 1.8s cubic-bezier(.2,.8,.2,1)}
.zab-jar-oil::before{content:"";position:absolute;left:-10%;right:-10%;top:-6px;height:12px;border-radius:50%;background:#FFE38A}
.zab-jar-body::after{content:"";position:absolute;left:14px;top:14px;bottom:18px;width:8px;border-radius:8px;background:rgba(255,255,255,.55)}
.zab-jar b{font-family:'Bricolage Grotesque',sans-serif;font-size:48px;line-height:1;color:#17402A}
.zab-jar span{font-weight:700;color:#17402A}.zab-jar small{font-size:13.5px;color:#5A6A5E;max-width:200px}
/* 7 team */
.zab-team{background:#F0E4C2;padding:120px 0 110px;overflow:hidden}
.zab-team-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:20px}
.zab-shelf{position:relative;margin-top:60px;display:grid;grid-template-columns:repeat(7,1fr);gap:10px;align-items:end;padding:0 10px}
.zab-shelf::after{content:"";position:absolute;left:-20px;right:-20px;bottom:-22px;height:24px;border-radius:4px;background:linear-gradient(#8A5A2B,#5A3A1E);box-shadow:0 18px 30px -12px rgba(59,39,23,.6)}
.zab-b{position:relative;height:calc(320px - var(--h));display:flex;justify-content:center;outline:none;cursor:pointer;perspective:700px;transition:transform .5s cubic-bezier(.2,.8,.2,1)}
.zab-glass{height:100%;width:auto;filter:drop-shadow(6px 10px 10px rgba(16,38,26,.25))}
.zab-b:hover,.zab-b:focus{transform:translateY(-16px) rotate(-3deg)}
.zab-label{position:absolute;left:50%;bottom:22%;width:112px;height:120px;margin-left:-56px;transform-style:preserve-3d;transition:transform .7s cubic-bezier(.2,.8,.2,1)}
.zab-b:hover .zab-label,.zab-b:focus .zab-label{transform:rotateY(180deg)}
.zab-face{position:absolute;inset:0;backface-visibility:hidden;border-radius:4px;background:#FBF3DF;box-shadow:0 2px 0 rgba(0,0,0,.08);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:10px;box-sizing:border-box;color:#17402A}
.zab-back{transform:rotateY(180deg);background:#17402A;color:#FBF3DF}
.zab-no{font-family:'DM Mono',monospace;font-size:9px;letter-spacing:.14em;color:#B9800C}
.zab-front b{font-family:'Cormorant Garamond',serif;font-size:24px;line-height:1.05;margin:4px 0 2px}
.zab-front small{font-size:10.5px;font-weight:700;line-height:1.25}
.zab-est{margin-top:6px;padding-top:5px;border-top:1px solid rgba(23,64,42,.25);font-family:'DM Mono',monospace;font-size:7.5px;letter-spacing:.08em;color:#6A7A6E}
.zab-av{display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:#DCEB4B;color:#17402A;font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:20px;margin-bottom:6px}
.zab-back p{margin:0;font-size:11px;line-height:1.35;color:#E6EBD9}
.zab-team-note{margin-top:56px;text-align:center;font-family:'DM Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#6A7A6E}
/* 8 grow */
.zab-grow{position:relative;height:200vh;background:#17402A;color:#FBF3DF}
.zab-grow-in{position:sticky;top:0;height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;overflow:hidden;padding:80px 20px 0;box-sizing:border-box}
.zab-tree{width:min(380px,60vw);height:auto;overflow:visible}
.zab-tree .tk{fill:none;stroke:#C9A060;stroke-width:9;stroke-linecap:round}
.zab-tree .br{fill:none;stroke:#C9A060;stroke-width:4.5;stroke-linecap:round}
.zab-tree .lf{fill:#6E8F3A;transform-box:fill-box;transform-origin:center;transform:scale(0);transition:transform .5s cubic-bezier(.3,1.6,.5,1)}
.zab-tree .lf.on{transform:none}
.zab-tree .ol{fill:#DCEB4B}
.zab-ground{fill:#10261A}
.zab-grow h2{margin:20px 0 10px;font-family:'Bricolage Grotesque',sans-serif;font-weight:600;font-size:clamp(34px,4.4vw,60px);line-height:1.02;opacity:0;transform:translateY(16px);transition:opacity .6s,transform .6s}
.zab-grow h2 em{font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:500;color:#E9C46A}
.zab-grow .zab-cta{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;margin-top:14px;opacity:0;transform:translateY(16px);transition:opacity .6s .15s,transform .6s .15s}
.zab-grow.done h2,.zab-grow.done .zab-cta{opacity:1;transform:none}
.zab-cta a{display:inline-flex;align-items:center;gap:10px;min-height:54px;padding:0 28px;border-radius:999px;font-weight:700;font-size:16px;text-decoration:none}
.zab-cta a:first-child{background:#DCEB4B;color:#17402A}.zab-cta a+a{border:1px solid rgba(251,243,223,.4);color:#FBF3DF}
/* album */
.zab-album{background:#F0E4C2;padding:120px 0 110px;overflow:hidden}
.zab-album-head{text-align:center;max-width:720px;margin:0 auto}.zab-album-head .zab-p{margin:0 auto}
.zab-pages{position:relative;height:440px;margin-top:40px}
.zab-pic{position:absolute;left:50%;top:50%;width:min(260px,40vw);margin:0;padding:12px 12px 46px;background:#fff;box-shadow:0 26px 50px -26px rgba(59,39,23,.6);transform:translate(-50%,-50%) translate(0,-60vh) rotate(calc(var(--r) * 3));opacity:0;transition:transform 1.1s cubic-bezier(.2,.8,.2,1),opacity .5s}
.zab-pic:nth-child(2){transition-delay:.15s}.zab-pic:nth-child(3){transition-delay:.3s}.zab-pic:nth-child(4){transition-delay:.45s}
.zab-album.in .zab-pic{opacity:1;transform:translate(-50%,-50%) translate(calc(var(--x) * 2.2),var(--y)) rotate(var(--r))}
.zab-pic img{display:block;width:100%;aspect-ratio:4/5;object-fit:cover;filter:sepia(.35) saturate(.85) contrast(1.03)}
.zab-pic figcaption{position:absolute;left:0;right:0;bottom:12px;text-align:center;font-family:'Cormorant Garamond',serif;font-style:italic;font-size:19px;color:#3A2A1A}
.zab-pic:hover{z-index:5;transform:translate(-50%,-50%) translate(calc(var(--x) * 2.2),calc(var(--y) - 14px)) rotate(0deg) scale(1.05)!important}
.zab-pic::before{content:"";position:absolute;left:50%;top:-12px;width:80px;height:24px;margin-left:-40px;background:rgba(240,228,194,.85);transform:rotate(-4deg)}
.zab-album-note{margin:20px 0 0;text-align:center;font-family:'DM Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#6A7A6E}
/* recipes */
.zab-recipes{background:#FBF3DF;padding:120px 0}
.zab-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;margin-top:50px}
.zab-card{border:0;padding:0;background:none;cursor:pointer;perspective:900px;height:300px;transform:rotate(var(--r));font:inherit;text-align:left}
.zab-card-in{position:relative;display:block;width:100%;height:100%;transform-style:preserve-3d;transition:transform .8s cubic-bezier(.2,.8,.2,1)}
.zab-card.flip .zab-card-in{transform:rotateY(180deg)}
.zab-card-f,.zab-card-b{position:absolute;inset:0;backface-visibility:hidden;border-radius:6px;padding:28px 26px;box-sizing:border-box;display:flex;flex-direction:column;box-shadow:0 24px 44px -26px rgba(59,39,23,.55)}
.zab-card-f{background:#FFFCF3;background-image:repeating-linear-gradient(0deg,rgba(185,128,12,.14) 0 1px,transparent 1px 30px);background-position:0 70px;border-top:10px solid #B4411E}
.zab-card-b{transform:rotateY(180deg);background:#17402A;color:#FBF3DF;justify-content:center}
.zab-card small{font-family:'DM Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#B9800C}
.zab-card-f b{margin:16px 0 10px;font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:600;font-size:40px;line-height:1;color:#17402A}
.zab-card-f i{font-style:normal;font-size:15px;line-height:30px;color:#4A5A4E}
.zab-card-f em{margin-top:auto;font-style:normal;font-family:'DM Mono',monospace;font-size:11px;color:#6A7A6E}
.zab-card-b small{color:#DCEB4B}.zab-card-b p{margin:14px 0 0;font-family:'Cormorant Garamond',serif;font-style:italic;font-size:24px;line-height:1.3}
/* rules */
.zab-rules{background:#FBF3DF;padding:0 0 120px}
.zab-board{position:relative;padding:56px 60px 50px;border-radius:14px;background:radial-gradient(120% 120% at 30% 20%,#2A4A36,#17302A);color:#FBF3DF;box-shadow:0 0 0 14px #8A5A2B,0 0 0 16px #5A3A1E,0 40px 70px -30px rgba(0,0,0,.6)}
.zab-board-h{margin:12px 0 26px;font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:500;font-size:clamp(44px,5vw,70px);line-height:1;color:#FBF3DF}
.zab-board ol{margin:0;padding:0;list-style:none;counter-reset:r;display:grid;grid-template-columns:1fr 1fr;gap:26px 50px}
.zab-board li{counter-increment:r;display:grid;grid-template-columns:44px 1fr;gap:4px 10px}
.zab-board li::before{content:counter(r);grid-row:1/3;font-family:'Cormorant Garamond',serif;font-size:44px;line-height:.9;color:#E9C46A}
.zab-board b{font-family:'Cormorant Garamond',serif;font-size:26px;font-weight:600}
.zab-board li span{font-size:15px;line-height:1.5;color:#C9D3BC}
.zab-chalk-sign{display:block;margin-top:30px;text-align:right;font-family:'Cormorant Garamond',serif;font-style:italic;font-size:24px;color:#E9C46A}
@@media (max-width:960px){.zab-pages{height:640px}.zab-album.in .zab-pic{transform:translate(-50%,-50%) translate(calc(var(--x) * .6),calc(var(--y) * 5)) rotate(var(--r))}.zab-cards{grid-template-columns:1fr}.zab-board{padding:36px 26px}.zab-board ol{grid-template-columns:1fr}}
@@media (max-width:960px){.zab-hero .zab-wrap,.zab-letter .zab-wrap,.zab-year .zab-wrap,.zab-journey .zab-wrap{grid-template-columns:1fr}.zab-trunk{justify-self:center}.zab-jars{grid-template-columns:1fr 1fr}.zab-shelf{grid-template-columns:repeat(4,1fr);row-gap:60px}.zab-burst{height:620px}.zab-wheelbox{width:min(420px,86vw)}.zab-paper{padding:30px 24px}}
@@media (prefers-reduced-motion:reduce){.zab-ring,.zab-dot{animation:none;stroke-dashoffset:0;opacity:1}.zab-line{opacity:1;filter:none;transform:none}.zab-year,.zab-grow{height:auto}.zab-year-in,.zab-grow-in{position:relative;height:auto;padding:80px 0}}
</style>
</head>
<body>
<div style="font-family: 'DM Sans', system-ui, sans-serif; color: #10261A; background: #FBF3DF; overflow-x: clip">
  @await Html.PartialAsync("_ZtNav")

  <!-- 1. Tree rings -->
  <section class="zab-hero" aria-labelledby="zab-title">
    <div class="zab-wrap">
      <div>
        <nav class="zab-crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>About</span></nav>
        <h1 class="zab-h1" id="zab-title">Three generations.<br><em>One olive tree.</em></h1>
        <p class="zab-p">Zaytouna is not a factory with a family name. It is a family that happens to make oil. Every ring of this trunk is a year we spent together. Hover one to read it.</p>
        <ul class="zab-ms" id="zab-ms" aria-live="polite"><li data-i="0" class="on"><span>1998</span><b>Jiddo's first press</b><small>Grandpa Yousef presses his first olives in Irbid, with two stones and three neighbours helping.</small></li><li data-i="1" class=""><span>2001</span><b>Teta's kitchen</b><small>Grandma Huda starts selling her makdous and labneh from the family kitchen.</small></li><li data-i="2" class=""><span>2005</span><b>The children join</b><small>Mahmoud and Rima leave university early to help with the harvest. They never leave.</small></li><li data-i="3" class=""><span>2010</span><b>The first bottle</b><small>The family designs its own bottle. Teta chooses the green.</small></li><li data-i="4" class=""><span>2014</span><b>Across the border</b><small>Mahmoud drives the first export order to the Gulf himself.</small></li><li data-i="5" class=""><span>2019</span><b>A new mill</b><small>A cold-press mill arrives. Jiddo still tastes every batch.</small></li><li data-i="6" class=""><span>2023</span><b>Third generation</b><small>The grandchildren start working the harvest, laptops in their bags.</small></li><li data-i="7" class=""><span>2026</span><b>Going digital</b><small>The family opens its purchasing to everyone, fairly, on one platform.</small></li></ul>
      </div>
