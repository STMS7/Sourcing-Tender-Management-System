[].forEach.call(document.querySelectorAll('.zab-card'),function(b){b.addEventListener('click',function(){b.classList.toggle('flip')})});
// 8. tree
var grow=document.getElementById('zab-grow'),tk=[].slice.call(grow.querySelectorAll('.tk,.br')),lg=document.getElementById('zab-leaves'),lv='',seed=7;
function rnd(){seed=(seed*9301+49297)%233280;return seed/233280}
var tips=[[86,160],[218,128],[104,84],[200,76],[150,60],[120,120],[180,110],[150,90]];
tips.forEach(function(t,k){for(var n=0;n<7;n++){var x=t[0]+(rnd()-.5)*48,y=t[1]+(rnd()-.5)*36,a=Math.round(rnd()*180);lv+='<ellipse class="lf" data-k="'+(k*7+n)+'" cx="'+x.toFixed(0)+'" cy="'+y.toFixed(0)+'" rx="11" ry="4.5" transform="rotate('+a+' '+x.toFixed(0)+' '+y.toFixed(0)+')"/>'}if(k%2===0)lv+='<circle class="lf ol" data-k="'+(k*7+6)+'" cx="'+(t[0]+6)+'" cy="'+(t[1]+8)+'" r="5"/>'});
lg.innerHTML=lv;var leaves=[].slice.call(lg.children);tk.forEach(function(p){p.style.strokeDasharray=1;p.style.strokeDashoffset=1});
function upd(){vh=innerHeight;
// wheel
var r=year.getBoundingClientRect(),p=reduce?0:c(-r.top/(year.offsetHeight-vh)),i=Math.min(11,Math.round(p*11));wheel.style.transform='rotate('+(-p*330).toFixed(2)+'deg)';setMonth(i);
// tree
var g=grow.getBoundingClientRect(),gp=reduce?1:c(-g.top/(grow.offsetHeight-vh)+.12);
tk.forEach(function(path,k){var s=k===0?0:.18+k*.06,len=k===0?.35:.25;path.style.strokeDashoffset=(1-c((gp-s)/len)).toFixed(3)});
leaves.forEach(function(l,k){l.classList.toggle('on',gp>.45+k/leaves.length*.45)});grow.classList.toggle('done',gp>.9)}
addEventListener('scroll',function(){requestAnimationFrame(upd)},{passive:true});addEventListener('resize',upd);upd();
