function onRm(){L.reduced=rmq.matches;relayout()}
if(rmq.addEventListener)rmq.addEventListener('change',onRm);
updateDom();
var timers=[];
if(!L.reduced)for(var t=0;t<n;t++)(function(i){timers.push(setTimeout(function(){impulse(i,(i%2?-1:1)*(30-(i%4)*3))},60+i*70))})(t);
addEventListener('pagehide',function(){cancelAnimationFrame(s.raf);s.raf=0;timers.forEach(clearTimeout);ro.disconnect();if(io)io.disconnect();document.removeEventListener('visibilitychange',onVis)});
})();
