 if(size.carousel){var c=L.active!=null?L.active:L.carouselIndex;if(hit!=null&&hit===c&&L.active!==hit)setActive(hit);return}
 if(hit!=null&&hit!==ptr.hoverHit)impulse(hit,clamp(-hv*22,-24,24));
