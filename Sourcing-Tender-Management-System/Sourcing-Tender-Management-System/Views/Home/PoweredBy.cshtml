});
document.addEventListener('keydown',function(e){if(e.key==='Escape'&&L.flipped!=null&&!stage.contains(e.target))setFlipped(null)});
R.forEach(function(r,i){
 r.btn.addEventListener('focus',function(){focusIdx=i;if(ptr.id<0)setActive(i)});
 r.btn.addEventListener('click',function(e){var p=pendingOpen;pendingOpen=-1;if(e.detail===0||p===i)toggle(i)});
 [].forEach.call(r.links.querySelectorAll('a'),function(a){a.addEventListener('pointerdown',function(e){e.stopPropagation()})});
