 if(im){var bad=function(){if(im.parentNode)im.parentNode.removeChild(im)};im.addEventListener('error',bad);if(im.complete&&im.naturalWidth===0)bad()}
});
function go(d){var c=L.active!=null?L.active:L.carouselIndex,nx=L.cyclic?(((c+d)%n)+n)%n:clamp(c+d,0,n-1);focusIdx=nx;setActive(nx)}
document.getElementById('pb-prev').addEventListener('click',function(){go(-1)});
document.getElementById('pb-next').addEventListener('click',function(){go(1)});

function measure(width){
 var railW=Math.min(MAX_W,(width-40)/(n*PITCH_MIN+.4)),carousel=railW<MIN_RAIL_W,W=Math.round((carousel?clamp(width*.38,128,150):railW)*4)/4;
