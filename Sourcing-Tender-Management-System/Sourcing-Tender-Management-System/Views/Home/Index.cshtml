})();
</script>
<script>
(function(){var root=document.querySelector('.zt-phases');if(!root)return;
var tabs=[].slice.call(root.querySelectorAll('.zt-tab')),slides=[].slice.call(root.querySelectorAll('.zt-slide')),track=root.querySelector('.zt-strip'),vp=root.querySelector('.zt-viewport'),counter=root.querySelector('.zt-counter b');
var cur=0,timer=null,reduce=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches,DUR=7000;
function offset(i){var sl=slides[i];return sl.offsetLeft-slides[0].offsetLeft}
function show(i,focus){cur=(i+slides.length)%slides.length;
track.style.transform='translateX('+(-offset(cur))+'px)';
slides.forEach(function(sl,j){var on=j===cur;sl.classList.toggle('is-on',on);sl.setAttribute('aria-hidden',!on);if(on)sl.removeAttribute('inert');else sl.setAttribute('inert','')});
tabs.forEach(function(t,j){var on=j===cur;t.setAttribute('aria-selected',on);t.tabIndex=on?0:-1;t.classList.toggle('is-done',j<cur)});
counter.textContent=('0'+(cur+1)).slice(-2);
var bar=tabs[cur].querySelector('.zt-seg-fill');bar.style.animation='none';void bar.offsetWidth;bar.style.animation='';
if(focus)tabs[cur].focus();var tl=root.querySelector('.zt-tablist');if(tl.scrollWidth>tl.clientWidth){tl.scrollTo({left:tabs[cur].offsetLeft-tl.offsetLeft-8,behavior:'smooth'})}}
function stop(){root.classList.remove('is-auto');clearInterval(timer);timer=null}
function start(){if(reduce||timer)return;root.classList.add('is-auto');timer=setInterval(function(){show(cur+1)},DUR)}
function user(i,f){stop();show(i,f);root.dataset.touched='1'}
tabs.forEach(function(t,i){t.addEventListener('click',function(){user(i)});
t.addEventListener('keydown',function(e){var k=e.key,n=null;if(k==='ArrowRight'||k==='ArrowDown')n=i+1;if(k==='ArrowLeft'||k==='ArrowUp')n=i-1;if(k==='Home')n=0;if(k==='End')n=tabs.length-1;if(n!==null){e.preventDefault();user(n,true)}})});
root.querySelectorAll('.zt-arrow').forEach(function(b){b.addEventListener('click',function(){user(cur+(+b.dataset.dir))})});
slides.forEach(function(sl,j){sl.addEventListener('click',function(){if(j!==cur&&!moved)user(j)})});
var sx=0,dx=0,down=false,moved=false;
vp.addEventListener('pointerdown',function(e){down=true;moved=false;sx=e.clientX;dx=0;vp.classList.add('is-drag');track.style.transition='none'});
addEventListener('pointermove',function(e){if(!down)return;dx=e.clientX-sx;if(Math.abs(dx)>6)moved=true;track.style.transform='translateX('+(-offset(cur)+dx)+'px)'});
addEventListener('pointerup',function(){if(!down)return;down=false;vp.classList.remove('is-drag');track.style.transition='';if(dx<-60)user(cur+1);else if(dx>60)user(cur-1);else show(cur);setTimeout(function(){moved=false},0)});
vp.addEventListener('mouseenter',function(){if(timer){clearInterval(timer);timer=null;root.classList.remove('is-auto');root.dataset.paused='1'}});
vp.addEventListener('mouseleave',function(){if(root.dataset.paused==='1'&&root.dataset.touched!=='1'){root.dataset.paused='';start()}});
addEventListener('resize',function(){track.style.transition='none';show(cur);requestAnimationFrame(function(){track.style.transition=''})});
show(0);
if('IntersectionObserver' in window){var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){if(root.dataset.touched!=='1')start()}else stop()})},{threshold:.35});io.observe(root)}})();
</script>
<script>
