.zt-slide.is-on .zt-slide-body>*:nth-child(2){animation-delay:.12s}.zt-slide.is-on .zt-slide-body>*:nth-child(3){animation-delay:.2s}.zt-slide.is-on .zt-slide-body>*:nth-child(4){animation-delay:.28s}
