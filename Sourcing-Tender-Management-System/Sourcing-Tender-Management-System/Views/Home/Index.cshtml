var sp=rel(spout);sp.x+=0;var vis=pouring*(1-drain*.6);pour.setAttribute('opacity',vis>0.02?1:0);
if(vis>0.02){var N=40,cen=[],W=[];
for(var k=0;k<=N;k++){var f=k/N,y=sp.y+f*FALL;
