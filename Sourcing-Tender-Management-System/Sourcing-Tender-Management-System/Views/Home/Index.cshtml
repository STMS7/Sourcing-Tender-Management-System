@@media (max-width:900px){.zt-viewport{margin:0 -20px;padding:8px 20px 20px}.zt-slide{flex-basis:90%;grid-template-columns:1fr}.zt-slide-media{min-height:240px}.zt-slide-body{padding:28px 24px}.zt-slide-title{font-size:26px}.zt-slide-steps{margin-top:8px}.zt-strip{gap:16px}}
