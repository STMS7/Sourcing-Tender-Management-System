// press test
var data=[{price:92,quality:64,delivery:70},{price:70,quality:90,delivery:60},{price:78,quality:76,delivery:95}];
var keys=['price','quality','delivery'],wraps=document.querySelectorAll('.zt-bottle-wrap');
function calc(){var w={},tot=0;keys.forEach(function(k){var v=+document.getElementById('zt-w-'+k).value;w[k]=v;tot+=v;document.getElementById('zt-w-'+k+'-out').textContent=v+'%'});
var scores=data.map(function(d){if(!tot)return 0;return keys.reduce(function(a,k){return a+d[k]*w[k]},0)/tot});var best=Math.max.apply(null,scores);
wraps.forEach(function(el,i){var sc=scores[i];el.querySelector('.zt-score').textContent=sc.toFixed(1);
var f=Math.min(1,Math.max(0.08,(sc-55)/40));var top=290-f*240;el.querySelector('.zt-liquid').style.transform='translateY('+top+'px)';el.classList.toggle('is-win',tot>0&&sc===best)})}
keys.forEach(function(k){document.getElementById('zt-w-'+k).addEventListener('input',calc)});
