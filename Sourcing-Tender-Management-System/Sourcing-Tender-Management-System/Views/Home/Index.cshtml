  <!-- Roles: the same record, seen through each role -->
  <style>
/* roles: one tender travelling through seven hands */
.zrj{position:relative;height:220vh;background:#FBF3DF;color:#17402A}
.zrj-pin{position:sticky;top:0;height:100vh;min-height:620px;display:flex;flex-direction:column;justify-content:center;gap:clamp(40px,7vh,80px);max-width:1280px;margin:0 auto;padding:80px 32px 40px;box-sizing:border-box}
.zrj-eye{font-family:'DM Mono',monospace;font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:#4E6B2F}
.zrj-h2{margin:10px 0 10px;font-family:'Bricolage Grotesque',sans-serif;font-weight:600;font-size:clamp(34px,4.2vw,60px);line-height:1.05;letter-spacing:-.015em}
.zrj-h2 em{font-family:'Cormorant Garamond',Georgia,serif;font-style:italic;font-weight:500;color:#B9800C}
.zrj-head p{margin:0;max-width:560px;font-size:16px;line-height:1.6;color:#5A6A5E}
.zrj-track{position:relative;padding-top:86px}
.zrj-rail{position:absolute;left:calc(100%/14);right:calc(100%/14);top:126px;height:4px;border-radius:4px;background:repeating-linear-gradient(90deg,rgba(23,64,42,.22) 0 8px,transparent 8px 14px)}
.zrj-rail i{position:absolute;left:0;top:0;bottom:0;width:0;border-radius:4px;background:linear-gradient(90deg,#9DB34A,#E0A215);box-shadow:0 0 10px rgba(224,162,21,.5)}
.zrj-file{position:absolute;top:0;left:calc(100%/14);transform:translateX(-50%);width:150px;padding:10px 12px 12px;border-radius:6px 12px 12px 12px;background:#17402A;color:#FBF3DF;box-shadow:0 18px 30px -16px rgba(23,64,42,.7);transition:transform .15s}
.zrj-file::before{content:"";position:absolute;left:0;top:-9px;width:54px;height:10px;border-radius:6px 6px 0 0;background:#2E6A42}
.zrj-file::after{content:"";position:absolute;left:50%;bottom:-9px;margin-left:-8px;border:8px solid transparent;border-bottom:0;border-top-color:#17402A}
.zrj-file span{display:block;font:500 10px 'DM Mono',monospace;letter-spacing:.12em;color:#DCEB4B}
.zrj-file b{display:block;margin-top:3px;font-size:13px;line-height:1.2}
.zrj-list{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(7,1fr);gap:8px}
.zrj-st{display:flex;flex-direction:column;align-items:center;text-align:center;gap:4px;opacity:.45;transition:opacity .4s}
.zrj-dot{display:grid;place-items:center;width:80px;height:80px;margin-bottom:12px;border-radius:50%;background:#FBF3DF;border:2px solid rgba(23,64,42,.25);color:#17402A;transition:background .4s,border-color .4s,color .4s,transform .4s,box-shadow .4s}
