function setBottle(a){ang=a;bottle.style.transform='rotate('+a+'deg)'}
function build(){var keep=ang;setBottle(MAXT);var sp=rel(spout);setBottle(keep);
var start={x:sp.x,y:sp.y+FALL};var wr=rel(document.getElementById('zt-word')),cx=sec.offsetWidth/2,endY=wr.y-wr.h*0.42;wordTop=endY;wordH=wr.h*0.84;
var d='M'+start.x+' '+start.y+' C'+start.x+' '+(start.y+120)+' '+cx+' '+(start.y+60)+' '+cx+' '+(start.y+240);
var steps=6,span=(endY-(start.y+240))/steps;for(var i=1;i<=steps;i++){var y0=start.y+240+span*(i-1),y1=y0+span,sw=(i%2?1:-1)*14;d+=' C'+(cx+sw)+' '+(y0+span*.35)+' '+(cx+sw)+' '+(y1-span*.35)+' '+cx+' '+y1}
path.setAttribute('d',d);bg.setAttribute('d',d);U.setAttribute('d',d);H.setAttribute('d',d);L=path.getTotalLength();[path,U,H].forEach(function(e){e.style.strokeDasharray=L;e.style.strokeDashoffset=L});
samples=[];for(var k=0;k<=400;k++)samples.push(path.getPointAtLength(L*k/400).y)}
function lenAtY(y){for(var k=0;k<samples.length;k++){if(samples[k]>=y)return L*k/400}return L}
var target=0,tilt=0;
function measure(){var q=sec.getBoundingClientRect(),vh=innerHeight;tilt=Math.min(1,Math.max(0,(vh*0.8-q.top)/(vh*0.6)));target=tilt<1?0:Math.min(L,lenAtY(vh*0.62-q.top))}
function frame(now){var t=(now-t0)/1000;
// ease length toward target for liquid feel
len+= (target-len)*0.07;if(Math.abs(target-len)<.5)len=target;
var e=tilt*tilt*(3-2*tilt);pouring=e>.92&&len<L-4?1:Math.max(0,pouring-0.05);
