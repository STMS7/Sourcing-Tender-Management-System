.zt-pop{animation:zt-pop .7s .1s cubic-bezier(.2,.8,.2,1) both}
.zt-spin{animation:zt-spin 18s linear infinite}
.zt-float{animation:zt-float 6s ease-in-out infinite}
.zt-card{transition:transform .25s cubic-bezier(.2,.8,.2,1),box-shadow .25s}
