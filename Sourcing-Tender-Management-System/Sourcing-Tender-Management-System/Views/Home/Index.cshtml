.zt-dot{position:relative;width:20px;height:20px;border-radius:50%;background:#FBF3DF;border:2px solid rgba(23,64,42,.3);box-sizing:border-box;transition:background .6s,border-color .6s,transform .6s}
.zt-dot i{position:absolute;top:26px;left:50%;transform:translateX(-50%);font-style:normal;font-family:'DM Mono',monospace;font-size:11px;letter-spacing:.08em;color:#8A988D;transition:color .6s}
.zt-tab.is-done .zt-dot,.zt-tab[aria-selected="true"] .zt-dot{background:#17402A;border-color:#17402A}
.zt-tab[aria-selected="true"] .zt-dot{transform:scale(1.15);box-shadow:0 0 0 5px rgba(220,235,75,.55)}
.zt-tab.is-done .zt-dot i,.zt-tab[aria-selected="true"] .zt-dot i{color:#17402A}
.zt-tab[aria-selected="true"] .zt-dot:nth-child(2){transition-delay:.1s}.zt-tab[aria-selected="true"] .zt-dot:nth-child(3){transition-delay:.2s}.zt-tab[aria-selected="true"] .zt-dot:nth-child(4){transition-delay:.3s}
.zt-phase-media{position:relative;aspect-ratio:21/9;border-radius:24px;overflow:hidden;background:#E8E0C8}
