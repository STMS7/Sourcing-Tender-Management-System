<text font-family="DM Mono, monospace" font-size="9.5" letter-spacing="3.2" fill="#1F5A36"><textPath href="#zd-ring">ZAYTOUNA · PROCUREMENT · 2026 ·</textPath></text>
<path d="M70 48 C62 56 62 64 70 70 C78 64 78 56 70 48Z" fill="#4E6B2F"/><path d="M70 70 V58" stroke="#FBF3DF" stroke-width="1.2"/>
<text x="70" y="88" text-anchor="middle" font-family="Bricolage Grotesque, sans-serif" font-weight="800" font-size="15" letter-spacing="1" fill="#1F5A36">AWARDED</text></g></defs></svg>
    <div class="zd-sticky">
      <div class="zd-grid">
        <div class="zd-left">
          <span class="zd-eyebrow">How It Works</span>
