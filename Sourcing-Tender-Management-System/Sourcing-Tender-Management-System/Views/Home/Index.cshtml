<script>
(function(){var sec=document.getElementById('story'),drop=document.getElementById('zt-drop'),bottle=document.getElementById('zt-bottle'),spout=document.getElementById('zt-spout'),path=document.getElementById('zt-trail-path'),bg=document.getElementById('zt-trail-bg'),
lvl=document.getElementById('zb-level'),pour=document.getElementById('zt-pour'),pb=document.getElementById('zt-pour-body'),ph=document.getElementById('zt-pour-hi'),pool=document.getElementById('zt-pool'),U=document.getElementById('zt-trail-under'),H=document.getElementById('zt-trail-hi'),ph2=document.getElementById('zt-pour-hi2'),blobG=document.getElementById('zt-blobs'),splG=document.getElementById('zt-spl'),NS='http://www.w3.org/2000/svg';
