// oil level stays horizontal and drains as it pours
var drain=L?len/L:0;var lv=-55+drain*110;lvl.setAttribute('transform','rotate('+(-ang)+' 80 200) translate(0 '+lv+')');
document.getElementById('zb-surf').setAttribute('d','M-300 200 Q'+(80+Math.sin(t*3)*40)+' '+(200+Math.sin(t*4)*5*e)+' 460 200');
path.style.strokeDashoffset=L-len;U.style.strokeDashoffset=L-len;H.style.strokeDashoffset=L-len;var bd='';if(len>40){for(var bi=0;bi<4;bi++){var pl=((t*70+bi*len/4)%len);var bp=path.getPointAtLength(pl),rr=3.4+Math.sin(t*2+bi)*.6;bd+='<ellipse cx="'+bp.x.toFixed(1)+'" cy="'+bp.y.toFixed(1)+'" rx="'+(rr*.9).toFixed(1)+'" ry="'+(rr*1.3).toFixed(1)+'" fill="url(#zg-blob)"/><circle cx="'+(bp.x-1.2).toFixed(1)+'" cy="'+(bp.y-1.6).toFixed(1)+'" r="1.1" fill="#FFFBE6"/>'}}document.getElementById('zt-beads').innerHTML=bd;
