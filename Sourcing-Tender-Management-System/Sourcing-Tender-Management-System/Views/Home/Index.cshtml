@@media (max-width:900px){.zt-tablist{grid-template-columns:repeat(6,minmax(140px,1fr));overflow-x:auto;padding-bottom:8px}.zt-tab-text{flex-direction:column;gap:4px}.zt-tab-name{font-size:22px}.zt-phase-media{aspect-ratio:4/3}.zt-steps{grid-template-columns:repeat(2,minmax(0,1fr))}}
