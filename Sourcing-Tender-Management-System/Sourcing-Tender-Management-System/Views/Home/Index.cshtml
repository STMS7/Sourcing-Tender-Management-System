var wordTop=0,wordH=1,wOil=document.getElementById('zt-oil'),fillP=0,beats=[].slice.call(sec.querySelectorAll('.zt-beat')),L=0,marks=[],samples=[],FALL=130,MAXT=-122,ang=-8,len=0,pouring=0,t0=performance.now();
