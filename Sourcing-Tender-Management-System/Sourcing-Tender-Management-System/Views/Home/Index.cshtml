.zt-steps li{display:flex;flex-direction:column;gap:8px;padding-top:16px;border-top:1px solid rgba(23,64,42,.18)}
.zt-step-n{font-family:'DM Mono',monospace;font-size:13px;letter-spacing:.1em;color:#4E6B2F}
