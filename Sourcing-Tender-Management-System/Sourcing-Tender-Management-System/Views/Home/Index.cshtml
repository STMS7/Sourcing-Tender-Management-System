.zt-phase-img.is-on{opacity:1;transform:scale(1)}
.zt-panel{padding-top:32px}
.zt-panel.is-on .zt-steps li{animation:zt-step-in .7s cubic-bezier(.2,.8,.2,1) both}
.zt-panel.is-on .zt-steps li:nth-child(2){animation-delay:.08s}.zt-panel.is-on .zt-steps li:nth-child(3){animation-delay:.16s}.zt-panel.is-on .zt-steps li:nth-child(4){animation-delay:.24s}
@@keyframes zt-step-in{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
