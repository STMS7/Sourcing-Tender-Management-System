.zt-card:hover{transform:translateY(-4px)!important;box-shadow:0 18px 40px -24px rgba(16,38,26,.45)!important}
.zt-btn:hover{transform:translateY(-1px)!important}
.zt-beat.is-in .zt-wiggle,.zt-beat:hover .zt-wiggle{animation:none!important}
.zt-track{animation-duration:70s!important}
.zt-reveal{transition-duration:1.2s!important}
body::after{opacity:.045!important}
.zt-phases{display:flex;flex-direction:column;gap:40px}
.zt-tablist{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:0}
.zt-tab{all:unset;box-sizing:border-box;cursor:pointer;display:flex;flex-direction:column;gap:18px;padding:0 0 4px;color:#8A988D;transition:color .5s}
.zt-tab:focus-visible{outline:2px solid #17402A;outline-offset:6px;border-radius:6px}
