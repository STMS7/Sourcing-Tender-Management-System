<style>
body{margin:0;background:#FBF3DF}html{scroll-behavior:smooth;scroll-padding-top:72px}
a{color:#17402A}a:hover{color:#0B2416}
@@keyframes zt-marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
