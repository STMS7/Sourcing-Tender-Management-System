@model Sourcing_Tender_Management_System.Models.TeamMember
@* Contact links for one team member. Missing fields are skipped, never replaced by placeholders. *@
@{
    var compact = ViewData["compact"] as bool? ?? false;
}
<ul class="pb-links@(compact ? " pb-links-sm" : "")">
@if (!string.IsNullOrWhiteSpace(Model.Email))
{
    <li><a href="mailto:@Model.Email" aria-label="Email @Model.FullName at @Model.Email"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><span class="pb-lk"><b>Email</b>@if (!compact){<small>@Model.Email</small>}</span></a></li>
}
@if (!string.IsNullOrWhiteSpace(Model.LinkedInUrl))
{
    <li><a href="@Model.LinkedInUrl" target="_blank" rel="noopener noreferrer" aria-label="@Model.FullName on LinkedIn (opens in a new tab)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg><span class="pb-lk"><b>LinkedIn</b></span></a></li>
}
@if (!string.IsNullOrWhiteSpace(Model.GitHubUrl))
{
    <li><a href="@Model.GitHubUrl" target="_blank" rel="noopener noreferrer" aria-label="@Model.FullName on GitHub (opens in a new tab)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65S8.93 17.38 9 18v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg><span class="pb-lk"><b>GitHub</b></span></a></li>
}
</ul>
