@* Search box and notification bell for the top bar. Used by the staff layout and the supplier layout. *@
<link rel="stylesheet" href="~/css/top-tools.css" asp-append-version="true" />
<div id="tt" class="tt"
     data-search-url="@Url.Action("Index", "QuickSearch")"
     data-recent-url="@Url.Action("Recent", "Notifications")"
     data-read-url="@Url.Action("Read", "Notifications")"
     data-all-url="@Url.Action("Index", "Notifications")">
    <form class="tt-search" role="search" autocomplete="off">
        @Html.AntiForgeryToken()
        <svg class="tt-search-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="M16 16l4.5 4.5" /></svg>
        <input class="tt-input" type="search" maxlength="100" placeholder="Search tenders, reports..."
               aria-label="Search" role="combobox" aria-expanded="false" aria-controls="tt-results" />
        <kbd class="tt-kbd" aria-hidden="true">/</kbd>
        <div id="tt-results" class="tt-results" role="listbox" aria-label="Search results" hidden></div>
    </form>
    <div class="tt-bell">
        <button type="button" class="tt-btn" aria-label="Notifications" aria-expanded="false" aria-controls="tt-panel">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.7 21a2 2 0 0 1-3.4 0" /></svg>
            <span class="tt-count" hidden></span>
        </button>
        <div id="tt-panel" class="tt-panel" role="dialog" aria-label="Notifications" hidden>
            <div class="tt-panel-head">Notifications</div>
            <div class="tt-list"></div>
            <a class="tt-all" href="@Url.Action("Index", "Notifications")">View all notifications</a>
        </div>
    </div>
</div>
<script src="~/js/top-tools.js" asp-append-version="true" defer></script>
