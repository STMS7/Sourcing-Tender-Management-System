@model WorkspaceSearchViewModel
@{
    var languageData = new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) {
        ["VoiceLanguageId"] = Model.Id + "-language"
    };
}
<form method="get" action="@Model.Action" class="zt-search-toolbar my-3" role="search"
      data-live-search data-local-search="@(Model.Local ? "" : null)" data-search-response="@(Model.Local ? null : "document")" data-results="@Model.ResultsId"
      data-row-selector="[data-search-item]" data-search-status="@(Model.Id)-status"
      data-empty-state="@(Model.Id)-empty" hidden>
    <label for="@Model.Id" class="form-label">@Model.Label</label>
    <div class="zt-search-line">
        <div class="zt-search-shell">
            <input id="@Model.Id" name="search" value="@Model.SearchValue" type="search" class="form-control zt-search-input" placeholder="@Model.Placeholder"
                   dir="auto" autocomplete="off" data-search-input />
            <partial name="_SearchVoiceTools" view-data="languageData" />
        </div>
        <button class="btn btn-primary zt-search-submit" type="submit">Search</button>
        <button class="btn btn-outline-secondary zt-search-clear" type="button" data-search-reset>Clear</button>
    </div>
    <p class="small text-secondary mb-0 mt-2" id="@(Model.Id)-status" role="status">Search the records loaded on this page.</p>
</form>
<p id="@(Model.Id)-empty" class="alert alert-info" data-search-empty hidden>No matching records. Clear the search to show all records.</p>
