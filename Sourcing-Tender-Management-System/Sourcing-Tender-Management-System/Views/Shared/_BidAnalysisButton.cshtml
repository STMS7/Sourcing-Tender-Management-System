@model BidAnalysisButtonViewModel
@* The AI analysis popup. It is opened by the page's own "AI analysis" button (data-bs-target="#bid-analysis-modal");
   there is no floating button of its own any more, because the bottom-right corner belongs to the chat assistant.
   The result is advisory only. *@
<link rel="stylesheet" href="~/css/bid-analysis.css" asp-append-version="true" />
<div id="bid-analysis" data-url="@Model.Url">
    @Html.AntiForgeryToken()
    <div class="modal fade" id="bid-analysis-modal" tabindex="-1" aria-labelledby="bid-analysis-title" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="bid-analysis-title">AI assistant</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="bid-analysis-body" aria-live="polite"></div>
            </div>
        </div>
    </div>
</div>
<script src="~/js/bid-analysis.js" asp-append-version="true"></script>
