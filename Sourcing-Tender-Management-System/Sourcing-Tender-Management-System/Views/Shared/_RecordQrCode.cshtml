@model Sourcing_Tender_Management_System.Models.RecordQrCodeViewModel
@{
    var qrAction = Model.Kind == "Tender" ? "Tender" : "PurchaseRequest";
    var pdfAction = Model.Kind == "Tender" ? "TenderPdf" : "PurchaseRequestPdf";
    var targetUrl = Url.Action(pdfAction, "QrCodes", new { id = Model.Id }, Context.Request.Scheme, Context.Request.Host.Value);
}
<section class="card my-4" aria-label="QR code for @Model.Reference">
    <div class="card-body d-flex flex-wrap align-items-center gap-4">
        <img src="@Url.Action(qrAction, "QrCodes", new { id = Model.Id })" width="200" height="200" alt="QR code linking to a PDF for @Model.Reference" />
        <div class="flex-grow-1">
            <h2 class="h5">Printable record</h2>
            <p class="text-muted mb-2">Scan to open a live PDF with the latest record details and the Source Officer watermark. No sign-in is required.</p>
            <a class="btn btn-outline-primary" asp-area="" asp-controller="QrCodes" asp-action="@qrAction" asp-route-id="@Model.Id" asp-route-download="true">Download QR (PNG)</a>
        </div>
    </div>
</section>
