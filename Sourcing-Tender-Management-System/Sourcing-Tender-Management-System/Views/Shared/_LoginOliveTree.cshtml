@{
    var crowns = new[] {
        (X:250,Y:332,Angle:0,Stage:0.0), (X:190,Y:270,Angle:-28,Stage:0.12),
        (X:310,Y:266,Angle:25,Stage:0.19), (X:145,Y:222,Angle:-32,Stage:0.27),
        (X:360,Y:220,Angle:32,Stage:0.34), (X:190,Y:169,Angle:-18,Stage:0.42),
        (X:303,Y:168,Angle:22,Stage:0.49), (X:100,Y:274,Angle:-47,Stage:0.55),
        (X:404,Y:271,Angle:43,Stage:0.60), (X:230,Y:117,Angle:-12,Stage:0.67),
        (X:290,Y:111,Angle:15,Stage:0.73), (X:250,Y:65,Angle:0,Stage:0.79)
    };
}
<svg class="auth-tree" data-auth-tree viewBox="0 0 500 470" fill="none" aria-hidden="true" focusable="false">
    <ellipse cx="250" cy="437" rx="87" ry="9" fill="#10261A" opacity=".2" />
    <path class="auth-tree-trunk" pathLength="1" d="M250 432C244 396 257 366 248 332C239 295 252 256 248 221C245 189 256 149 250 107" stroke="#F0E4C2" stroke-width="12" stroke-linecap="round" />
    <path d="M250 427L225 441M250 425L276 440" stroke="#F0E4C2" stroke-width="5" stroke-linecap="round" />
    <g class="auth-tree-limbs" stroke="#F0E4C2" stroke-linecap="round">
        <path pathLength="1" d="M247 355Q206 320 173 288Q140 259 112 249" stroke-width="6" data-tree-limb="0.10" />
        <path pathLength="1" d="M250 354Q292 314 336 282Q370 255 400 252" stroke-width="6" data-tree-limb="0.18" />
        <path pathLength="1" d="M248 285Q212 250 184 213Q168 194 145 190" stroke-width="5" data-tree-limb="0.29" />
        <path pathLength="1" d="M249 282Q291 246 315 209Q339 183 361 181" stroke-width="5" data-tree-limb="0.38" />
        <path pathLength="1" d="M249 211Q217 176 198 141Q184 123 170 116" stroke-width="4" data-tree-limb="0.48" />
        <path pathLength="1" d="M251 204Q281 169 300 137Q319 115 337 108" stroke-width="4" data-tree-limb="0.57" />
        <path pathLength="1" d="M249 143Q233 108 230 84M251 141Q277 106 285 80" stroke-width="3" data-tree-limb="0.68" />
    </g>
    @foreach (var crown in crowns) {
        <g transform="translate(@crown.X @crown.Y) rotate(@crown.Angle)">
            <g class="auth-tree-crown" data-tree-stage="@crown.Stage.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                @foreach (var angle in new[] { -70, -39, -12, 18, 47, 76 }) {
                    <g transform="rotate(@angle)"><path d="M0 0C-18-19-15-46 0-67C14-45 17-20 0 0Z" fill="@(angle % 2 == 0 ? "#EEF0DC" : "#F0E4C2")" /><path d="M0-5V-53" stroke="#4E6B2F" stroke-width="1" opacity=".5" /></g>
                }
            </g>
        </g>
    }
    <g class="auth-tree-fruit" data-tree-stage="0.62">
        <ellipse cx="165" cy="238" rx="10" ry="14" transform="rotate(18 165 238)" fill="#4E6B2F" stroke="#F0E4C2" />
        <ellipse cx="336" cy="251" rx="10" ry="14" transform="rotate(-16 336 251)" fill="#17402A" stroke="#F0E4C2" />
        <ellipse cx="222" cy="172" rx="9" ry="13" fill="#4E6B2F" stroke="#F0E4C2" />
        <ellipse cx="297" cy="147" rx="10" ry="14" transform="rotate(16 297 147)" fill="#17402A" stroke="#F0E4C2" />
        <ellipse cx="253" cy="257" rx="10" ry="14" transform="rotate(-12 253 257)" fill="#4E6B2F" stroke="#F0E4C2" />
    </g>
</svg>
