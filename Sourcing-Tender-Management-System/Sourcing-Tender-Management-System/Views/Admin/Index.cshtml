@{
    ViewData["Title"] = "Admin";
}

<div id="admin-overview-search-results">
<div class="py-4">
    <h1>Admin Dashboard</h1>
    <p>Welcome, @User.Identity?.Name. Your Admin role is active.</p>
    <a class="btn btn-outline-success mb-3" asp-controller="Analytics" asp-action="Index">Open procurement analytics →</a>
    @if (TempData["Message"] is string message)
    {
        <div class="alert alert-success" role="status">@message</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }
    <partial name="_WorkspaceSearch" model="@(new WorkspaceSearchViewModel { Id = "admin-overview-search", ResultsId = "admin-overview-search-results", Label = "Search administration summaries and links" })" />
<ul class="zt-bento" aria-label="Administration summary">
        <li data-search-item><a class="zt-tile" asp-controller="Admin" asp-action="Users"><span class="zt-tile-label">Users</span><span class="zt-tile-value">@ViewBag.UserCount</span><span class="zt-tile-note">@ViewBag.ActiveUserCount active</span></a></li>
        <li data-search-item><a class="zt-tile" asp-controller="AdminCatalog" asp-action="Departments"><span class="zt-tile-label">Departments</span><span class="zt-tile-value">@ViewBag.DepartmentCount</span></a></li>
        <li data-search-item><a class="zt-tile" asp-controller="AdminCatalog" asp-action="Categories"><span class="zt-tile-label">Categories</span><span class="zt-tile-value">@ViewBag.CategoryCount</span></a></li>
        <li data-search-item><a class="zt-tile" asp-controller="AdminCatalog" asp-action="Suppliers"><span class="zt-tile-label">Suppliers</span><span class="zt-tile-value">@ViewBag.SupplierCount</span></a></li>
        <li data-search-item><a class="zt-tile" asp-controller="AdminCatalog" asp-action="Suppliers"><span class="zt-tile-label">Pending suppliers</span><span class="zt-tile-value">@ViewBag.PendingSupplierCount</span><span class="zt-tile-note">Waiting for approval</span></a></li>
        <li data-search-item><div class="zt-tile"><span class="zt-tile-label">Purchase requests</span><span class="zt-tile-value">@ViewBag.ProcurementRequestCount</span></div></li>
        <li data-search-item><a class="zt-tile" asp-controller="AdminCommittee" asp-action="Index"><span class="zt-tile-label">Tenders</span><span class="zt-tile-value">@ViewBag.TenderCount</span><span class="zt-tile-note">Assign committees</span></a></li>
    </ul>
</div>

</div>
