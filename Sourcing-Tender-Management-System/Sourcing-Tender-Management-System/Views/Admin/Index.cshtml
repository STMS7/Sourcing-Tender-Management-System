@{
    ViewData["Title"] = "Admin";
}

<div id="admin-overview-search-results">
<div class="py-4">
    <h1>Admin Dashboard</h1>
    <p>Welcome, @User.Identity?.Name. Your Admin role is active.</p>
    <partial name="_WorkspaceSearch" model="@(new WorkspaceSearchViewModel { Id = "admin-overview-search", ResultsId = "admin-overview-search-results", Label = "Search administration summaries and links" })" />
<div class="row g-3 mb-4">
        <div data-search-item class="col-md-4"><div class="card card-body">Users: @ViewBag.UserCount (@ViewBag.ActiveUserCount active)</div></div>
        <div data-search-item class="col-md-4"><div class="card card-body">Departments: @ViewBag.DepartmentCount</div></div>
        <div data-search-item class="col-md-4"><div class="card card-body">Categories: @ViewBag.CategoryCount</div></div>
        <div data-search-item class="col-md-4"><div class="card card-body">Suppliers: @ViewBag.SupplierCount</div></div>
        <div data-search-item class="col-md-4"><div class="card card-body">Pending suppliers: @ViewBag.PendingSupplierCount</div></div>
        <div data-search-item class="col-md-4"><div class="card card-body">Purchase requests: @ViewBag.ProcurementRequestCount</div></div>
        <div data-search-item class="col-md-4"><div class="card card-body">Tenders: @ViewBag.TenderCount</div></div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a data-search-item class="btn btn-primary" asp-controller="Admin" asp-action="Users">Users</a>
        <a data-search-item class="btn btn-outline-primary" asp-controller="AdminCatalog" asp-action="Departments">Departments</a>
        <a data-search-item class="btn btn-outline-primary" asp-controller="AdminCatalog" asp-action="Categories">Categories</a>
        <a data-search-item class="btn btn-outline-primary" asp-controller="AdminCatalog" asp-action="Suppliers">Suppliers</a>
        <a data-search-item class="btn btn-outline-primary" asp-controller="AdminCatalog" asp-action="Roles">Roles</a>
        <a data-search-item class="btn btn-outline-primary" asp-controller="AdminCatalog" asp-action="AuditLogs">Audit log</a>
        <a data-search-item class="btn btn-outline-primary" asp-controller="AdminCommittee" asp-action="Index">Evaluation committees</a>
    </div>
</div>

</div>
