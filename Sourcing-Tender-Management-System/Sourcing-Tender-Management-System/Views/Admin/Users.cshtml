@model IReadOnlyList<Sourcing_Tender_Management_System.Models.AdminUserListItemViewModel>
@{
    ViewData["Title"] = "Users";
    var currentPage = ViewBag.CurrentPage is int page ? page : 1;
    var totalPages = ViewBag.TotalPages is int pages ? pages : 1;
    var totalCount = ViewBag.TotalCount is int count ? count : Model.Count;
    const int pageSize = 4;
    var firstResult = totalCount == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    var lastResult = Math.Min(currentPage * pageSize, totalCount);
}

<div class="py-4">
    <h1>Users</h1>
    <p>Accounts and roles in the system.</p>
    <nav class="d-flex flex-wrap gap-2 mb-4" aria-label="User and organization management">
        <button class="btn btn-outline-primary" type="button" data-user-modal-url="@Url.Action("CreateUserModal", "Admin")" data-user-modal-title="Create user">Create user</button>
        <a class="btn btn-outline-primary" asp-controller="AdminCatalog" asp-action="Roles">Roles</a>
        <a class="btn btn-outline-primary" asp-controller="AdminCatalog" asp-action="Categories">Categories</a>
        <a class="btn btn-outline-primary" asp-controller="AdminCommittee" asp-action="Index">Evaluation committees</a>
    </nav>
    @if (TempData["Message"] is string message)
    {
        <div class="alert alert-success">@message</div>
    }
    <partial name="_WorkspaceSearch" model="@(new WorkspaceSearchViewModel { Id = "admin-user-search", ResultsId = "admin-user-results", Label = "Search name or email", Placeholder = "Search name or email", Action = Url.Action("Users", "Admin"), SearchValue = ViewBag.Search, Local = false })" />
    <div id="admin-user-results" aria-busy="false">
    <span hidden data-result-count="@totalCount"></span>
    <div class="d-flex justify-content-between align-items-center mb-2 px-1 text-secondary small">
        <span>Showing @firstResult–@lastResult of @totalCount users</span>
        <span>Page @currentPage of @totalPages</span>
    </div>
    <div class="table-responsive shadow-sm zt-admin-table">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Roles</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr data-search-item>
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td><span class="badge rounded-pill text-bg-light border">@user.Roles</span></td>
                        <td>
                            <span class="badge rounded-pill @(user.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                @(user.IsActive ? "Active" : "Disabled")
                            </span>
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                <a class="btn btn-sm btn-outline-primary" asp-action="EditUser" asp-route-id="@user.Id" data-user-modal-url="@Url.Action("EditUser", "Admin", new { id = user.Id })" data-user-modal-title="Edit user">Edit</a>
                                <a class="btn btn-sm btn-outline-secondary" asp-action="ResetPassword" asp-route-id="@user.Id" data-user-modal-url="@Url.Action("ResetPassword", "Admin", new { id = user.Id })" data-user-modal-title="Reset password">Reset password</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.Count == 0)
    {
        <p>No users found.</p>
    }

    @if (totalPages > 1)
    {
        <nav class="mt-4" aria-label="Users pages">
            <ul class="pagination justify-content-center flex-wrap">
                <li class="page-item @(currentPage == 1 ? "disabled" : null)">
                    <a class="page-link" asp-action="Users" asp-route-search="@ViewBag.Search" asp-route-page="@(currentPage - 1)">Previous</a>
                </li>
                @for (var number = 1; number <= totalPages; number++)
                {
                    <li class="page-item @(number == currentPage ? "active" : null)">
                        <a class="page-link" asp-action="Users" asp-route-search="@ViewBag.Search" asp-route-page="@number" aria-current="@(number == currentPage ? "page" : null)">@number</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : null)">
                    <a class="page-link" asp-action="Users" asp-route-search="@ViewBag.Search" asp-route-page="@(currentPage + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }
    </div>
</div>

<div class="modal fade" id="create-user-modal" tabindex="-1" aria-labelledby="create-user-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title h4 mb-1" id="create-user-modal-title" data-user-modal-heading>User account</h2>
                    <p class="text-secondary small mb-0">Manage account information securely.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" data-create-user-body>
                <div class="d-flex justify-content-center py-5">
                    <div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var modalElement = document.getElementById('create-user-modal');
            var body = modalElement && modalElement.querySelector('[data-create-user-body]');
            var heading = modalElement && modalElement.querySelector('[data-user-modal-heading]');
            if (!modalElement || !body) return;

            var modal = bootstrap.Modal.getOrCreateInstance(modalElement);

            function syncDepartment() {
                var role = body.querySelector('#Role');
                var group = body.querySelector('#department-group');
                var department = body.querySelector('#DepartmentId');
                if (!role || !group || !department) return;
                var applies = ['DepartmentRequester', 'DepartmentRepresentative', 'RequestingDepartment'].indexOf(role.value) !== -1;
                group.hidden = !applies;
                department.disabled = !applies;
                if (!applies) department.value = '';
            }

            function wireForm() {
                var form = body.querySelector('[data-user-modal-form]');
                var role = body.querySelector('#Role');
                if (!form) return;
                if (role) role.addEventListener('change', syncDepartment);
                syncDepartment();

                form.addEventListener('submit', async function (event) {
                    event.preventDefault();
                    var submit = form.querySelector('[data-user-modal-submit]');
                    if (submit) submit.disabled = true;
                    try {
                        var response = await fetch(form.action, {
                            method: 'POST',
                            body: new FormData(form),
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });
                        var contentType = response.headers.get('content-type') || '';
                        if (contentType.indexOf('application/json') !== -1) {
                            var result = await response.json();
                            if (result.success) window.location.href = result.redirect;
                            return;
                        }
                        body.innerHTML = await response.text();
                        wireForm();
                    } catch (_) {
                        body.insertAdjacentHTML('afterbegin', '<div class="alert alert-danger">The user could not be created. Please try again.</div>');
                        if (submit) submit.disabled = false;
                    }
                });
            }

            document.addEventListener('click', async function (event) {
                var trigger = event.target.closest('[data-user-modal-url]');
                if (!trigger) return;
                event.preventDefault();
                var formUrl = trigger.getAttribute('data-user-modal-url');
                if (heading) heading.textContent = trigger.getAttribute('data-user-modal-title') || 'User account';
                body.innerHTML = '<div class="d-flex justify-content-center py-5"><div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div></div>';
                modal.show();
                try {
                    var response = await fetch(formUrl, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    body.innerHTML = await response.text();
                    wireForm();
                } catch (_) {
                    body.innerHTML = '<div class="alert alert-danger mb-0">The form could not be loaded. Please try again.</div>';
                }
            });
        })();
    </script>
}
