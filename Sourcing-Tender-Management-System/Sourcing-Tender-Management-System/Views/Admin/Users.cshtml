@model IReadOnlyList<Sourcing_Tender_Management_System.Models.AdminUserListItemViewModel>
@{
    ViewData["Title"] = "Users";
}

<div class="py-4">
    <h1>Users</h1>
    <p>Accounts and roles in the system.</p>
    @if (TempData["Message"] is string message)
    {
        <div class="alert alert-success">@message</div>
    }
    <form method="get" asp-action="Users" class="row g-3 align-items-end mb-3" role="search"
          data-live-search data-search-response="document" data-results="admin-user-results" data-search-status="admin-user-search-status">
        <div class="col-md-6"><label for="admin-user-search" class="form-label">Search name or email</label><input id="admin-user-search" class="form-control" type="search" name="search" value="@ViewBag.Search" dir="auto" data-search-input /></div>
        <div class="col-md-3"><partial name="_VoiceLanguage" /></div>
        <div class="col-md-3 d-flex flex-wrap gap-2"><button class="btn btn-outline-primary" type="button" data-voice-search aria-pressed="false">Search by voice</button><button class="btn btn-primary" type="submit">Search</button><button class="btn btn-link" type="button" data-search-reset>Clear search</button></div>
    </form>
    <p id="admin-user-search-status" role="status" class="small text-secondary"></p>
    <a class="btn btn-primary mb-3" asp-action="CreateUser">Create user</a>
    <div id="admin-user-results" aria-busy="false">
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Roles</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr data-search-item>
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td>@user.Roles</td>
                        <td>@(user.IsActive ? "Active" : "Disabled")</td>
                        <td>
                            <a asp-action="EditUser" asp-route-id="@user.Id">Edit</a>
                            <span class="mx-1">·</span>
                            <a asp-action="ResetPassword" asp-route-id="@user.Id">Reset password</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.Count == 0)
    {
        <p>No users found.</p>
    }
    </div>
</div>
