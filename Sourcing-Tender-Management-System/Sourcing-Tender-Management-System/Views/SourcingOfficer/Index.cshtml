@model SourcingDashboardViewModel
@inject Microsoft.AspNetCore.Identity.UserManager<Sourcing_Tender_Management_System.Models.ApplicationUser> UserManager
@{
    ViewData["Title"] = "Sourcing officer";
    var fullName = (await UserManager.GetUserAsync(User))?.FullName;
    var firstName = string.IsNullOrWhiteSpace(fullName) ? null : fullName.Trim().Split(' ')[0];
    const string svgOpen = "<svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"";
    const string svgClose = "\"></path></svg>";
    const string IconInbox = "M3 13h5l1 3h6l1-3h5M5 13l2-8h10l2 8v6H5z";
    const string IconCheck = "M6 3h9l4 4v14H6zM9 14l2 2 4-4";
    const string IconDoc = "M6 3h9l4 4v14H6zM14 3v5h5M9 13h6M9 17h6";
    const string IconSend = "M4 12l16-8-6 16-3-7z";
    const string IconScale = "M12 4v16M8 20h8M5 8h14M5 8l-3 6a3 3 0 006 0zM19 8l-3 6a3 3 0 006 0z";
    const string IconChat = "M4 5h16v11H9l-5 4z";
    const string IconList = "M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01";
}
<link rel="stylesheet" href="~/css/officer-workspace.css" asp-append-version="true" />
<div class="ow">
    <header class="ow-head">
        <div>
            <p class="ow-kicker">Sourcing officer</p>
            <h1>@(firstName == null ? "Welcome back" : $"Welcome back, {firstName}")</h1>
            <p>Manage approved purchase requests, prepare tenders and move compliant offers to evaluation.</p>
        </div>
    </header>

    <ul class="ow-kpis" aria-label="Sourcing summary">
        <li><a class="ow-kpi is-gold" asp-action="Requests"><span class="ow-kpi-icon">@Html.Raw(svgOpen + IconInbox + svgClose)</span><span class="ow-kpi-value">@Model.IncomingRequests</span><span class="ow-kpi-label">Requests awaiting review</span><span class="ow-kpi-note">Waiting for your review</span></a></li>
        <li><a class="ow-kpi" asp-action="Requests" asp-route-status="Approved"><span class="ow-kpi-icon">@Html.Raw(svgOpen + IconCheck + svgClose)</span><span class="ow-kpi-value">@Model.ApprovedRequests</span><span class="ow-kpi-label">Approved requests</span><span class="ow-kpi-note">Ready to become tenders</span></a></li>
        <li><a class="ow-kpi" asp-action="Tenders" asp-route-status="Draft"><span class="ow-kpi-icon">@Html.Raw(svgOpen + IconDoc + svgClose)</span><span class="ow-kpi-value">@Model.DraftTenders</span><span class="ow-kpi-label">Draft tenders</span><span class="ow-kpi-note">Still being prepared</span></a></li>
        <li><a class="ow-kpi" asp-action="Tenders" asp-route-status="Published"><span class="ow-kpi-icon">@Html.Raw(svgOpen + IconSend + svgClose)</span><span class="ow-kpi-value">@Model.PublishedTenders</span><span class="ow-kpi-label">Published tenders</span><span class="ow-kpi-note">Open for supplier offers</span></a></li>
        <li><a class="ow-kpi is-dark" asp-action="Tenders" asp-route-status="Closed"><span class="ow-kpi-icon">@Html.Raw(svgOpen + IconScale + svgClose)</span><span class="ow-kpi-value">@Model.PendingCompliance</span><span class="ow-kpi-label">Offers awaiting compliance</span><span class="ow-kpi-note">Closed tenders to review</span></a></li>
    </ul>

    <h2 class="ow-section-title">Quick actions</h2>
    <ul class="ow-actions">
        <li><a class="ow-action" asp-action="Requests"><span class="ow-action-icon">@Html.Raw(svgOpen + IconList + svgClose)</span><strong>Review requests</strong><span>Open the purchase requests</span></a></li>
        <li><a class="ow-action" asp-action="Requests" asp-route-status="Approved"><span class="ow-action-icon">@Html.Raw(svgOpen + IconDoc + svgClose)</span><strong>Create a tender</strong><span>Start from an approved request</span></a></li>
        <li><a class="ow-action" asp-action="Tenders" asp-route-status="Closed"><span class="ow-action-icon">@Html.Raw(svgOpen + IconScale + svgClose)</span><strong>Review offer compliance</strong><span>Open a tender to compare offers</span></a></li>
        <li><a class="ow-action" asp-action="Messages"><span class="ow-action-icon">@Html.Raw(svgOpen + IconChat + svgClose)</span><strong>Open messages</strong><span>Questions and clarifications</span></a></li>
    </ul>

    <div class="ow-grid">
        <section class="ow-panel" aria-labelledby="recent-tenders-title">
            <div class="ow-panel-head"><h2 id="recent-tenders-title">Recent tenders</h2><a asp-action="Tenders">View all tenders</a></div>
            <partial name="_TenderTable" model="Model.RecentTenders" />
        </section>

        <section class="ow-panel" aria-labelledby="my-tasks-title">
            <div class="ow-panel-head"><h2 id="my-tasks-title">My tasks &amp; deadlines</h2></div>
            <div class="ow-panel-body">
                <form class="zt-search-toolbar" role="search" id="task-search-form" data-live-search data-local-search data-results="task-list" data-search-status="voice-status" data-empty-state="no-tasks">
                    <label for="task-search" class="form-label">Search tasks</label>
                    <div class="zt-search-line"><div class="zt-search-shell"><input id="task-search" type="search" class="form-control zt-search-input" placeholder="Search your tasks" data-search-input /><partial name="_SearchVoiceTools" /></div><button type="submit" class="btn btn-primary">Search</button><button type="button" class="btn btn-outline-secondary" data-search-reset>Clear</button></div>
                </form>
                <p id="voice-status" role="status" class="small text-secondary mb-0 mt-2"></p>
                <ul class="ow-tasks" id="task-list">
                @foreach (var task in Model.Tasks)
                {
                    var late = task.DueAt != null && task.DueAt.Value < DateTime.UtcNow;
                    <li class="ow-task" data-task="@task.Title @task.Description">
                        <div class="ow-task-top"><strong>@task.Title</strong> <span class="ow-chip">@task.Status</span></div>
                        <p>@task.Description</p>
                        <div class="ow-task-meta">
                            @if (task.DueAt != null) { <span class="ow-due @(late ? "is-late" : null)">@(late ? "Overdue · " : "")Due @task.DueAt.Value.ToString("dd MMM yyyy HH:mm") UTC</span> }
                            @if (task.TenderId != null) { <a asp-action="Details" asp-route-id="@task.TenderId">Open tender</a> }
                            else if (task.ProcurementRequestId != null) { <a asp-action="RequestDetails" asp-route-id="@task.ProcurementRequestId">Open request</a> }
                        </div>
                    </li>
                }
                </ul>
                <p id="no-tasks" class="ow-empty empty-state" hidden="@(Model.Tasks.Count > 0)">No matching tasks.</p>
            </div>
        </section>
    </div>
</div>
