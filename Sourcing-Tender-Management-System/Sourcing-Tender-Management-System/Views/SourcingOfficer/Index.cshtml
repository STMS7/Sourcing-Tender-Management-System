@model SourcingDashboardViewModel
@{ ViewData["Title"] = "Sourcing officer"; }
<h1>Sourcing officer dashboard</h1>
<p class="text-secondary">Review department requests, prepare supplier invitations and send compliant offers to evaluation.</p>
<partial name="_SourcingCycle" model="@(-1)" />
<section class="so-next" aria-labelledby="start-heading">
    <h2 id="start-heading">Start with a department request</h2>
    <p>Review the request and choose: accept into a tender, return with a message for changes, or reject permanently. After acceptance, prepare the supplier invitation and follow the steps above.</p>
    <a class="btn btn-primary" asp-action="Requests">Review incoming requests</a>
</section>
<ul class="zt-bento" aria-label="Sourcing summary">
    <li><a class="zt-tile" asp-action="Requests"><span class="zt-tile-label">Requests awaiting review</span><span class="zt-tile-value">@Model.IncomingRequests</span></a></li>
    <li><a class="zt-tile" asp-action="Requests"><span class="zt-tile-label">Approved requests</span><span class="zt-tile-value">@Model.ApprovedRequests</span></a></li>
    <li><a class="zt-tile" asp-action="Tenders" asp-route-status="Draft"><span class="zt-tile-label">Draft tenders</span><span class="zt-tile-value">@Model.DraftTenders</span></a></li>
    <li><a class="zt-tile" asp-action="Tenders" asp-route-status="Published"><span class="zt-tile-label">Published tenders</span><span class="zt-tile-value">@Model.PublishedTenders</span></a></li>
    <li><a class="zt-tile" asp-action="Tenders" asp-route-status="Closed"><span class="zt-tile-label">Offers awaiting compliance</span><span class="zt-tile-value">@Model.PendingCompliance</span></a></li>
</ul>
<h2>Recent tenders</h2>
<partial name="_TenderTable" model="Model.RecentTenders" />
<h2>My tasks</h2>
<form class="row g-3 align-items-end mb-3" role="search" id="task-search-form" data-live-search data-local-search data-results="task-list" data-search-status="voice-status" data-empty-state="no-tasks">
    <div class="col-md-6"><label for="task-search" class="form-label">Search tasks</label><input id="task-search" type="search" class="form-control" placeholder="Search your tasks" data-search-input /></div>
    <div class="col-md-3"><partial name="_VoiceLanguage" /></div>
    <div class="col-md-3"><button type="button" id="voice-search" class="btn btn-outline-primary" data-voice-search aria-pressed="false">Search by voice</button></div>
</form>
<p id="voice-status" role="status" class="small text-secondary"></p>
<ul class="list-group list-group-flush" id="task-list">
@foreach (var task in Model.Tasks)
{
    <li class="list-group-item px-0" data-task="@task.Title @task.Description">
        <strong>@task.Title</strong> <span class="status">@task.Status</span>
        <p class="mb-1">@task.Description</p>
        @if (task.DueAt != null) { <small>Due @task.DueAt.Value.ToString("dd MMM yyyy HH:mm") UTC</small> }
        @if (task.TenderId != null) { <a asp-action="Details" asp-route-id="@task.TenderId">Open tender</a> }
        else if (task.ProcurementRequestId != null) { <a asp-action="RequestDetails" asp-route-id="@task.ProcurementRequestId">Open request</a> }
    </li>
}
</ul>
<p id="no-tasks" class="empty-state" hidden="@(Model.Tasks.Count > 0)">No matching tasks.</p>
