@model List<Tender>
@{ ViewData["Title"] = "My tenders"; }
<h1>My tenders</h1>
<p class="text-secondary">Tenders you created or have been assigned to manage.</p>
<form asp-action="Tenders" method="get" class="zt-search-toolbar mb-3" role="search" data-live-search data-results="tender-results" data-search-status="tender-search-status">
    <label for="search" class="form-label">Title or tender number</label>
    <div class="zt-search-line"><div class="zt-search-shell"><input type="search" name="search" id="search" value="@ViewBag.Search" class="form-control zt-search-input" placeholder="Results update as you type" data-search-input /><partial name="_SearchVoiceTools" /></div><button class="btn btn-primary" type="submit">Search</button><a asp-action="Tenders" data-search-reset class="btn btn-outline-secondary">Clear</a></div>
    <div class="mt-3" style="max-width:360px"><label for="status" class="form-label">Status</label><select name="status" id="status" class="form-select"><option value="">All statuses</option>
    @foreach (var status in Enum.GetValues<TenderStatus>()) { <option value="@status" selected="@(ViewBag.Status != null && (TenderStatus)ViewBag.Status == status)">@status</option> }
    </select></div>
</form>
<p id="tender-search-status" role="status" class="small text-secondary">Results update as you type. Status changes apply immediately.</p>
<div id="tender-results" aria-busy="false"><partial name="_TenderResults" model="Model" /></div>
