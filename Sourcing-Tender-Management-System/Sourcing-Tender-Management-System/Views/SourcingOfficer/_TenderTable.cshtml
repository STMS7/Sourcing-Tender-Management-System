@model List<Tender>
@if (Model.Count == 0)
{
    <div class="empty-state"><p class="mb-2">No tenders to display.</p><a asp-action="Requests">Start from an approved purchase request</a></div>
}
else
{
    <div class="table-responsive">
        <table class="table"><caption class="visually-hidden">Sourcing tenders</caption>
            <thead><tr><th scope="col">Tender</th><th scope="col">Status</th><th scope="col">Deadline (UTC)</th><th scope="col">Action</th></tr></thead>
            <tbody>@foreach (var tender in Model) {
                <tr><td><strong>@tender.Title</strong><br /><small class="text-secondary">@tender.TenderNumber</small></td><td><span class="status">@tender.Status</span></td><td>@tender.SubmissionDeadline.ToString("dd MMM yyyy HH:mm")</td><td><a asp-action="Details" asp-route-id="@tender.Id">Manage <span class="visually-hidden">@tender.Title</span></a></td></tr>
            }</tbody>
        </table>
    </div>
}
