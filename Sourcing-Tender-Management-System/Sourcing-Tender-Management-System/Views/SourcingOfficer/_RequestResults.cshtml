@model List<ProcurementRequest>
<p class="small text-secondary" data-result-count="@Model.Count">@Model.Count request(s) found.</p>
@if (Model.Count == 0) { <p class="empty-state">No matching requests are available. Submitted requests appear here when sent by a department. Requests assigned to another officer are excluded.</p> }
else {
<div class="table-responsive"><table class="table"><caption class="visually-hidden">Purchase requests</caption><thead><tr><th scope="col">Request</th><th scope="col">Department</th><th scope="col">Status</th><th scope="col">Priority</th><th scope="col">Required by</th><th scope="col">Action</th></tr></thead><tbody>
@foreach (var request in Model) {
<tr><td><strong>@request.Title</strong><br /><small>@request.RequestNumber</small></td><td>@request.Department.Name</td><td><span class="status">@request.Status</span></td><td>@request.Priority</td><td>@(request.RequiredByDate?.ToString("dd MMM yyyy") ?? "Not specified")</td><td><a asp-action="RequestDetails" asp-route-id="@request.Id">Review <span class="visually-hidden">@request.Title</span></a></td></tr>
}
</tbody></table></div>
}
