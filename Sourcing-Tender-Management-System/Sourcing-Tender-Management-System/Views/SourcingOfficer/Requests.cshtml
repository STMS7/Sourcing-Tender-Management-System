@model List<ProcurementRequest>
@{ ViewData["Title"] = "Purchase requests"; }
<h1>Purchase requests</h1>
<p class="text-secondary">Review requests sent by departments. Return them with a reason, or accept them and create a tender.</p>
<form asp-action="Requests" method="get" class="row g-3 align-items-end mb-3" role="search"
      data-live-search data-results="request-results" data-search-status="request-search-status">
    <div class="col-md-6"><label for="search" class="form-label">Request title or number</label><input type="search" name="search" id="search" class="form-control" value="@ViewBag.Search" placeholder="Results update as you type" data-search-input /></div>
    <div class="col-md-3"><label for="request-status" class="form-label">Request status</label><select id="request-status" name="status" class="form-select">
        <option value="">Active requests</option>
        @foreach (var status in new[] { ProcurementRequestStatus.Submitted, ProcurementRequestStatus.UnderReview, ProcurementRequestStatus.Returned, ProcurementRequestStatus.Approved, ProcurementRequestStatus.Rejected, ProcurementRequestStatus.ConvertedToTender }) {
            <option value="@status" selected="@(ViewBag.Status != null && (ProcurementRequestStatus)ViewBag.Status == status)">@status</option>
        }
    </select></div>
    <div class="col-md-3"><partial name="_VoiceLanguage" /></div>
    <div class="col-md-3 actions"><button class="btn btn-outline-primary" type="button" data-voice-search aria-pressed="false">Search by voice</button><button class="btn btn-primary" type="submit">Search</button></div>
    <div class="col-12"><a asp-action="Requests" data-search-reset>Clear search</a></div>
</form>
<p id="request-search-status" role="status" class="small text-secondary">Results update as you type. Voice search uses your selected language.</p>
<div id="request-results" aria-busy="false"><partial name="_RequestResults" model="Model" /></div>
@section Scripts { <script src="~/js/sourcing-search.js" asp-append-version="true"></script> }
