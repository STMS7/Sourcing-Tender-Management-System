@model Tender
@using Sourcing_Tender_Management_System.Services
@{
    ViewData["Title"] = Model.Title;
    var draft = Model.Status == TenderStatus.Draft;
    var preparing = draft && Model.EvaluationCriteriaLockedAt == null;
    var preApproved = ViewBag.PrePublicationApproved is true;
    var publication = (SourcingPublicationReadiness)ViewBag.PublicationReadiness;
    var resultAction = ViewBag.ResultStep is TenderResultFlow.Step resultActionStep ? resultActionStep : TenderResultFlow.Step.None;
    var resultActionLabel = resultAction switch {
        TenderResultFlow.Step.AtOfficerToForward => "Forward report to sourcing manager",
        TenderResultFlow.Step.AtOfficerToAnnounce => "Send result to suppliers",
        TenderResultFlow.Step.AtOfficerToSendBack => "Send back to evaluation committee",
        _ => null };
    var suppliers = (List<Supplier>)ViewBag.Suppliers;
    var history = (List<WorkflowTransition>)ViewBag.History;
    var handoff = (SourcingEvaluationReadiness)ViewBag.Handoff;
    var responsibilityStatuses = (List<TenderResponsibilityStatus>)(ViewBag.ResponsibilityStatuses ?? new List<TenderResponsibilityStatus>());
    var agreedWeights = Sourcing_Tender_Management_System.Services.CommitteeWeighting.Agree(
        Sourcing_Tender_Management_System.Services.CommitteeWeighting.ReadProposals(Model.EvaluationCriteria));
    var preparationReasons = (List<string>)(ViewBag.PreparationWaitingReasons ?? new List<string>());
    var canRequestPreparation = preparing && ViewBag.HasOffers is not true && preparationReasons.Count == 0 &&
        Model.Items.Count > 0 && !string.IsNullOrWhiteSpace(Model.TermsAndConditions) &&
        Model.SubmissionDeadline > DateTime.UtcNow && (Model.OpeningDate == null || Model.OpeningDate >= Model.SubmissionDeadline);
    var canReadOffers = (bool)ViewBag.CanReadOffers;
    var canClarify = Model.Status is TenderStatus.Closed or TenderStatus.UnderEvaluation;
    var showWorkflowBar = draft || Model.Status == TenderStatus.Published || canReadOffers || resultActionLabel != null;
    var longTerms = (Model.TermsAndConditions?.Length ?? 0) > 450;
    // Status colours are never the only signal: every chip also carries the status text.
    string Tone(string status) => status switch {
        "Awarded" or "Approved" or "Accepted" or "CommitteeApproved" or "ManagerApproved" => "ok",
        "Cancelled" or "Rejected" or "Declined" or "Expired" or "CommitteeRejected" or "ManagerRejected" => "bad",
        "Draft" or "Invited" or "Pending" or "PendingManagerReview" or "PendingCommitteeDecision" or "AwaitingManagerReview" or "AwaitingCommitteeDecision" or "ReturnedForReview" => "warn",
        _ => "info"
    };
    string Words(string value) => System.Text.RegularExpressions.Regex.Replace(value, "(?<=[a-z])(?=[A-Z])", " ");
    const string svgOpen = "<svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"";
    const string svgClose = "\"></path></svg>";
    const string IconClock = "M12 7v5l3 2M21 12a9 9 0 11-18 0 9 9 0 0118 0z";
    const string IconOpen = "M3 9l9-6 9 6v11H3zM9 20v-6h6v6";
    const string IconCoin = "M12 3v18M16 7.5c0-1.7-1.8-3-4-3s-4 1.1-4 2.8c0 3.9 8 1.9 8 5.8 0 1.8-1.8 3-4 3s-4-1.3-4-3";
    const string IconScale = "M12 4v16M8 20h8M5 8h14M5 8l-3 6a3 3 0 006 0zM19 8l-3 6a3 3 0 006 0z";
    const string IconChat = "M4 5h16v11H9l-5 4z";
    const string IconDoc = "M6 3h9l4 4v14H6zM14 3v5h5M9 13h6M9 17h6";
    const string IconTrack = "M3 12h4l3-8 4 16 3-8h4";
}
<link rel="stylesheet" href="~/css/officer-workspace.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/officer-tender.css" asp-append-version="true" />
<div id="tender-details-search-results">
<div class="od" data-tender-id="@Model.Id">
    <nav class="od-crumbs" aria-label="Breadcrumb"><a asp-action="Tenders">Tenders</a><span aria-hidden="true">/</span><span aria-current="page">Tender details</span></nav>

    <header class="od-head">
        <div class="od-head-main">
            <h1>@Model.Title</h1>
            <p class="od-ref"><span class="od-chip" data-tone="@Tone(Model.Status.ToString())">@Words(Model.Status.ToString())</span><span>@Model.Category.Name</span></p>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Tenders">Back to my tenders</a>
    </header>

    <nav class="od-tabs od-tabs-top" role="tablist" aria-label="Tender sections" data-od-tabs hidden>
        <button type="button" role="tab" id="tab-overview-btn" aria-controls="tab-overview" aria-selected="true" data-tab="overview">Overview</button>
        <button type="button" role="tab" id="tab-items-btn" aria-controls="tab-items" aria-selected="false" data-tab="items" tabindex="-1">Tender items <span class="od-count">@Model.Items.Count</span></button>
        @if (Model.DocumentRequirements.Count > 0) { <button type="button" role="tab" id="tab-documents-btn" aria-controls="tab-documents" aria-selected="false" data-tab="documents" tabindex="-1">Documents <span class="od-count">@Model.DocumentRequirements.Count</span></button> }
        <button type="button" role="tab" id="tab-suppliers-btn" aria-controls="tab-suppliers" aria-selected="false" data-tab="suppliers" tabindex="-1">Suppliers <span class="od-count">@Model.Invitations.Count</span></button>
        <button type="button" role="tab" id="tab-evaluation-btn" aria-controls="tab-evaluation" aria-selected="false" data-tab="evaluation" tabindex="-1">Evaluation</button>
        <button type="button" role="tab" id="tab-activity-btn" aria-controls="tab-activity" aria-selected="false" data-tab="activity" tabindex="-1">Activity history <span class="od-count">@history.Count</span></button>
    </nav>

    @if (responsibilityStatuses.Count > 0) {
    <section class="od-owner-panel" aria-labelledby="waiting-on-title">
        <div class="od-owner-head"><div><span class="od-owner-kicker">Current responsibility</span><h2 id="waiting-on-title">Who are we waiting on?</h2></div><span class="od-owner-summary">@responsibilityStatuses.Count(x => x.IsWaiting) pending</span></div>
        <div class="od-owner-grid">
        @foreach (var owner in responsibilityStatuses) {
            <article class="od-owner @(owner.IsWaiting ? "is-waiting" : owner.IsComplete ? "is-complete" : null)">
                <span class="od-owner-state">@owner.State</span><strong>@owner.Role</strong><span class="od-owner-person">@owner.Person</span><p>@owner.Detail</p>
            </article>
        }
        </div>
    </section>
    }

    @if (showWorkflowBar) {
    <section class="od-workflow" aria-label="Tender workflow actions">
        <div class="od-next-action"><span>Next step</span><strong>@(publication.Ready ? "Publish the tender" : publication.OfficerTasks.FirstOrDefault() ?? (draft ? "Waiting for evaluation preparation" : Words(Model.Status.ToString())))</strong></div>
        <div class="actions">
        @if (draft) {
            @if (preparing) {
            @if (canRequestPreparation) {
            <form asp-action="RequestWeightApproval" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.Id" />
                <button class="btn btn-primary" type="submit">Send for evaluation preparation</button>
            </form>
            } else if (publication.OfficerTasks.Any(t => t.Contains("supplier", StringComparison.OrdinalIgnoreCase))) {
                <a class="btn btn-primary" href="#suppliers" data-goto-tab="suppliers">Select suppliers</a>
            } else {
                <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Complete tender details</a>
            }
            } else {
            <form asp-action="ReopenPreparation" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.Id" />
                <button class="btn btn-outline-secondary" type="submit" disabled="@(ViewBag.HasOffers is true)">Reopen preparation</button>
            </form>
            }
            @if (publication.Ready) { <form asp-action="Publish" method="post"><input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-primary" type="submit">Publish and send invitations</button></form> }
        }
        @if (Model.Status == TenderStatus.Published) {
            <form asp-action="Close" method="post" data-close-bidding data-deadline="@DateTime.SpecifyKind(Model.SubmissionDeadline, DateTimeKind.Utc).ToString("O")" hidden="@(Model.SubmissionDeadline > DateTime.UtcNow)"><input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-primary" type="submit">Close bidding &amp; compare offers</button></form>
        }
        @if (draft && preparing) {
            <div class="dropdown od-more-actions"><button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">More options</button><ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@Model.Id">Edit tender details</a></li>
                <li><a class="dropdown-item" href="#suppliers" data-goto-tab="suppliers">Manage supplier invitations</a></li>
                <li><a class="dropdown-item" href="#documents" data-goto-tab="documents">Manage required documents</a></li>
            </ul></div>
        }
        @if (canReadOffers) {
            <a class="btn btn-primary" asp-action="Offers" asp-route-id="@Model.Id">Compare offers and review compliance</a>
        }
        @if (Model.Status == TenderStatus.Closed) {
            <a class="btn btn-outline-primary" href="#evaluation" data-goto-tab="evaluation">Review evaluation handoff</a>
        }
        @if (resultActionLabel != null) {
            <a class="btn btn-primary" href="#evaluation" data-goto-tab="evaluation">@resultActionLabel</a>
        }
        @if (canClarify) {
            <a class="btn btn-outline-secondary" asp-action="Messages" asp-route-group="EvaluationCommittee" asp-route-context="@($"tender:{Model.Id}")">Message evaluation committee</a>
        }
        </div>
        @if (Model.Status == TenderStatus.Published && Model.SubmissionDeadline > DateTime.UtcNow) {
            <p class="od-note mt-3 mb-0" data-close-waiting>Close bidding becomes available automatically at the submission deadline. Supplier offers remain sealed.</p>
        }
    </section>
    }

    @if (Model.Status == TenderStatus.Published) { <p class="od-note">Offers remain sealed. After the deadline, close bidding to begin compliance review. Suppliers must be prevented from submitting after the deadline.</p> }
    @if (!draft && !preApproved) {
        <p class="alert alert-warning od-warning" role="note"><strong>Historical tender.</strong> This historical tender has no verified approval recorded before publication. Do not change weights after receiving offers. Resolve it through the team's documented procedure before evaluation.</p>
    }

    <ul class="od-stats" aria-label="Tender summary">
        <li><span class="od-stat-icon">@Html.Raw(svgOpen + IconClock + svgClose)</span><span class="od-stat-label">Submission deadline</span><strong class="od-stat-value"><time class="device-local-time" datetime="@DateTime.SpecifyKind(Model.SubmissionDeadline, DateTimeKind.Utc).ToString("O")">@Model.SubmissionDeadline.ToString("dd MMM yyyy HH:mm") UTC</time></strong><span class="od-stat-note">Shown in your device time</span></li>
        <li><span class="od-stat-icon">@Html.Raw(svgOpen + IconOpen + svgClose)</span><span class="od-stat-label">Bid opening</span><strong class="od-stat-value">@if (Model.OpeningDate is DateTime openingDate) { <time class="device-local-time" datetime="@DateTime.SpecifyKind(openingDate, DateTimeKind.Utc).ToString("O")">@openingDate.ToString("dd MMM yyyy HH:mm") UTC</time> } else { <span>After deadline and closure</span> }</strong><span class="od-stat-note">Shown in your device time</span></li>
        <li><span class="od-stat-icon">@Html.Raw(svgOpen + IconCoin + svgClose)</span><span class="od-stat-label">Estimated value</span><strong class="od-stat-value">@Model.EstimatedValue.ToString("N2")</strong><span class="od-stat-note">As entered for this tender</span></li>
    </ul>

    @* ---------------- Overview ---------------- *@
    <section class="od-panel" id="tab-overview" role="tabpanel" aria-labelledby="tab-overview-btn" data-panel="overview">
        <div class="od-split">
            <article class="od-card" aria-labelledby="overview-title">
                <header class="od-card-head"><h2 id="overview-title">Tender overview</h2></header>
                <dl class="od-facts">
                    <div><dt>Department request</dt><dd>
                        @if (Model.ProcurementRequestId != null && Model.Status is TenderStatus.Draft or TenderStatus.Published or TenderStatus.Closed or TenderStatus.UnderEvaluation) {
                            <a class="od-inline-link" asp-action="RequestDetails" asp-route-id="@Model.ProcurementRequestId">Open request and messages</a>
                        } else { <span>Not linked</span> }</dd></div>
                    <div><dt>Category</dt><dd>@Model.Category.Name</dd></div>
                    <div><dt>Submission deadline (device time)</dt><dd><time class="device-local-time" datetime="@DateTime.SpecifyKind(Model.SubmissionDeadline, DateTimeKind.Utc).ToString("O")">@Model.SubmissionDeadline.ToString("dd MMM yyyy HH:mm") UTC</time></dd></div>
                    <div><dt>Bid opening (device time)</dt><dd>@if (Model.OpeningDate is DateTime opening) { <time class="device-local-time" datetime="@DateTime.SpecifyKind(opening, DateTimeKind.Utc).ToString("O")">@opening.ToString("dd MMM yyyy HH:mm") UTC</time> } else { <span>After deadline and closure</span> }</dd></div>
                    <div><dt>Estimated value</dt><dd>@Model.EstimatedValue.ToString("N2")</dd></div>
                    <div><dt>Evaluation split</dt><dd>
                    @if (preApproved && agreedWeights != null) {
                        <span>Technical @agreedWeights.Technical% / Financial @agreedWeights.Financial% — agreed by the evaluation committee</span>
                    } else {
                        <span>Waiting for technical and financial approval.</span>
                    }
                    </dd></div>
                </dl>
            </article>

            <aside class="od-card" aria-labelledby="quick-title">
                <header class="od-card-head"><h2 id="quick-title">Quick actions</h2></header>
                <ul class="od-actions">
                    <li>
                    @if (canReadOffers) {
                        <a class="od-action" asp-action="Offers" asp-route-id="@Model.Id"><span class="od-action-icon">@Html.Raw(svgOpen + IconScale + svgClose)</span><strong>Compare offers and review compliance</strong><span>Open the offer comparison</span></a>
                    } else {
                        <div class="od-action is-off"><span class="od-action-icon">@Html.Raw(svgOpen + IconScale + svgClose)</span><strong>Compare offers</strong><span>Available once bidding has closed</span></div>
                    }
                    </li>
                    <li>
                    @if (canClarify) {
                        <a class="od-action" asp-action="Clarifications" asp-route-tenderId="@Model.Id"><span class="od-action-icon">@Html.Raw(svgOpen + IconChat + svgClose)</span><strong>Clarify with evaluation committee</strong><span>Ask or answer questions</span></a>
                    } else {
                        <div class="od-action is-off"><span class="od-action-icon">@Html.Raw(svgOpen + IconChat + svgClose)</span><strong>Clarify with evaluation committee</strong><span>Available after bidding closes</span></div>
                    }
                    </li>
                    <li><a class="od-action" href="#documents" data-goto-tab="documents"><span class="od-action-icon">@Html.Raw(svgOpen + IconDoc + svgClose)</span><strong>View documents</strong><span>@Model.DocumentRequirements.Count required @(Model.DocumentRequirements.Count == 1 ? "document" : "documents")</span></a></li>
                    <li><a class="od-action" href="#evaluation" data-goto-tab="evaluation"><span class="od-action-icon">@Html.Raw(svgOpen + IconTrack + svgClose)</span><strong>Track progress</strong><span>Stage: @Words(Model.Status.ToString())</span></a></li>
                </ul>
            </aside>
        </div>

        <article class="od-card" aria-labelledby="terms-title">
            <header class="od-card-head"><h2 id="terms-title">Description and terms</h2></header>
            <div class="od-prose">
                <p class="preserve-lines">@Model.Description</p>
                @if (!string.IsNullOrWhiteSpace(Model.TermsAndConditions)) {
                    <details class="od-more" open="@(!longTerms)"><summary>Terms and conditions</summary><p class="preserve-lines">@Model.TermsAndConditions</p></details>
                }
            </div>
        </article>
    </section>

    @* ---------------- Items ---------------- *@
    <section class="od-panel" id="tab-items" role="tabpanel" aria-labelledby="tab-items-btn" data-panel="items">
        <article class="od-card" aria-labelledby="items-title">
            <header class="od-card-head"><h2 id="items-title">Tender items</h2><span class="od-count">@Model.Items.Count</span></header>
            <div class="table-responsive"><table class="table"><caption class="visually-hidden">Tender items</caption><thead><tr><th scope="col">Item</th><th scope="col">Quantity / unit</th><th scope="col">Specifications</th></tr></thead><tbody>
            @foreach (var item in Model.Items) { <tr data-search-item><td>@item.ItemName</td><td>@item.Quantity.ToString("N3") @item.Unit</td><td class="preserve-lines">@item.Specifications</td></tr> }
            </tbody></table></div>
        </article>
    </section>

    @* ---------------- Documents ---------------- *@
    <section class="od-panel" id="tab-documents" role="tabpanel" aria-labelledby="tab-documents-btn" data-panel="documents">
        <article class="od-card" aria-labelledby="docs-title">
            <header class="od-card-head"><h2 id="docs-title">Required documents</h2><span class="od-count">@Model.DocumentRequirements.Count</span></header>
            @if (Model.DocumentRequirements.Count == 0) { <p class="od-empty">No document requirements configured. Review whether your tender needs quality certificates or other mandatory documents.</p> }
            else {
            <ul class="od-list">
            @foreach (var requirement in Model.DocumentRequirements) {
            <li data-search-item><div><strong>@requirement.DocumentType</strong> <span class="od-chip" data-tone="@(requirement.IsMandatory ? "warn" : "info")">@(requirement.IsMandatory ? "Mandatory" : "Optional")</span><p class="mb-0">@requirement.Description</p></div>
            @if (preparing) { <form asp-action="RemoveRequirement" method="post"><input type="hidden" name="id" value="@requirement.Id" /><button type="submit" class="btn btn-sm btn-outline-danger">Remove <span class="visually-hidden">@requirement.DocumentType</span></button></form> }
            </li>
            }
            </ul>
            }
            @if (preparing) {
            <details class="od-more od-add"><summary>Add document requirement</summary><form asp-action="AddRequirement" method="post" class="form-panel mt-3">
            <input type="hidden" name="TenderId" value="@Model.Id" />
            <div class="mb-3"><label for="document-type" class="form-label">Document type</label><input id="document-type" name="DocumentType" maxlength="100" required class="form-control" /></div>
            <div class="mb-3"><label for="document-description" class="form-label">Description</label><textarea id="document-description" name="Description" maxlength="500" class="form-control"></textarea></div>
            <div class="form-check mb-3"><input id="mandatory-document" type="checkbox" name="IsMandatory" value="true" checked class="form-check-input" /><input type="hidden" name="IsMandatory" value="false" /><label for="mandatory-document" class="form-check-label">Mandatory</label></div>
            <button type="submit" class="btn btn-outline-primary">Add requirement</button></form></details>
            }
        </article>
    </section>

    @* ---------------- Suppliers ---------------- *@
    <section class="od-panel" id="tab-suppliers" role="tabpanel" aria-labelledby="tab-suppliers-btn" data-panel="suppliers">
        <article class="od-card" aria-labelledby="inv-title">
            <header class="od-card-head"><h2 id="inv-title">Supplier invitations</h2><span class="od-count">@Model.Invitations.Count</span></header>
            <p class="od-note">Choose approved suppliers in the <strong>@Model.Category.Name</strong> category. Invitations are sent when published.</p>
            @if (Model.Invitations.Count == 0) { <p class="od-empty">No suppliers selected yet.</p> }
            else {
            <div class="table-responsive"><table class="table"><caption class="visually-hidden">Supplier invitations</caption><thead><tr><th scope="col">Supplier</th><th scope="col">Invitation</th><th scope="col">Response</th>@if (draft) { <th scope="col">Action</th> }</tr></thead><tbody>
            @foreach (var invitation in Model.Invitations) {
            <tr data-search-item><td><strong>@invitation.Supplier.CompanyName</strong><small class="od-supplier-email">@invitation.Supplier.Email</small> @if (!invitation.Supplier.IsActive || invitation.Supplier.RegistrationStatus != SupplierRegistrationStatus.Approved) { <span class="od-chip" data-tone="bad">Not eligible</span> }</td><td>@if (draft) { <span class="od-chip" data-tone="warn">Ready</span> } else { <span class="od-chip" data-tone="@Tone(invitation.Status.ToString())">@invitation.Status</span> }</td><td>@(string.IsNullOrWhiteSpace(invitation.ResponseReason) ? "—" : invitation.ResponseReason)</td>@if (draft) { <td><form asp-action="RemoveInvitation" method="post"><input type="hidden" name="id" value="@invitation.Id" /><button type="submit" class="btn btn-sm btn-link text-danger">Remove <span class="visually-hidden">@invitation.Supplier.CompanyName</span></button></form></td> }</tr>
            }
            </tbody></table></div>
            }
            @if (draft && suppliers.Count > 0) {
            <form asp-action="Invite" method="post" class="od-invite"><input type="hidden" name="tenderId" value="@Model.Id" /><fieldset><legend>Available suppliers</legend><div class="od-supplier-options">
            @foreach (var supplier in suppliers) { <label data-search-item class="od-supplier-option" for="supplier-@supplier.Id"><input id="supplier-@supplier.Id" type="checkbox" name="supplierIds" value="@supplier.Id" /><span class="od-supplier-check" aria-hidden="true">✓</span><span><strong>@supplier.CompanyName</strong><small>@supplier.Email</small></span></label> }
            </div></fieldset><div class="od-invite-footer"><span data-supplier-selection-status>No suppliers selected</span><button type="submit" class="btn btn-primary" disabled>Add suppliers</button></div></form>
            }
            else if (draft && suppliers.Count == 0) { <p class="od-note">No additional approved, active suppliers match this category. Ask the supplier-registration owner to verify category assignments.</p> }
        </article>
    </section>

    @* ---------------- Evaluation ---------------- *@
    <section class="od-panel" id="tab-evaluation" role="tabpanel" aria-labelledby="tab-evaluation-btn" data-panel="evaluation">
        <article class="od-card" aria-labelledby="eval-title">
            <header class="od-card-head"><h2 id="eval-title">Evaluation tracking</h2><span class="od-chip" data-tone="@Tone(Model.Status.ToString())">@Words(Model.Status.ToString())</span></header>
            @if (Model.Status == TenderStatus.Closed) {
                <div class="od-eval-intro"><span class="od-owner-kicker">Next step</span><h3>Send eligible offers for evaluation</h3><p>The technical and financial members will evaluate only the offers you marked as compliant.</p></div>
                @if (canReadOffers) {
                    <div class="od-eval-stats"><div><span>Submitted</span><strong>@handoff.SubmittedOffers</strong></div><div><span>Eligible</span><strong>@handoff.CompliantOffers</strong></div><div><span>Excluded / pending</span><strong>@(handoff.SubmittedOffers - handoff.CompliantOffers)</strong></div></div>
                }
                @if (handoff.Issues.Count > 0) {
                    <div class="alert alert-warning"><p class="mb-2">Complete these steps before sending:</p><ul class="mb-0">
                    @foreach (var issue in handoff.Issues) { <li>@issue</li> }
                    </ul></div>
                }
                @if (handoff.TeamDependencies.Count > 0) {
                    <div class="alert alert-info"><p class="mb-2"><strong>Waiting on the responsible team</strong></p><ul class="mb-0">@foreach (var issue in handoff.TeamDependencies) { <li>@issue</li> }</ul></div>
                }
                <form asp-action="ForwardToEvaluation" method="post" class="od-eval-action">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div><strong>@(handoff.Ready ? "Ready to send" : "Not ready yet")</strong><span>@(handoff.Ready ? "All required reviews are complete." : "Resolve the items above before sending.")</span></div>
                    <button type="submit" class="btn btn-primary" disabled="@(!handoff.Ready)">Send to evaluation committee</button>
                </form>
            }
            @if (ViewBag.EvaluationSentAt is DateTime sentAt) {
                <p role="status">Sent to the evaluation committee on <strong>@sentAt.ToString("dd MMM yyyy HH:mm") UTC</strong>. Assigned technical and financial members receive a link to their evaluation page.</p>
            }
            <div class="od-eval-flow"><span>Current stage</span><strong>@Words(Model.Status.ToString())</strong><p>Evaluation committee → Sourcing manager → Top Committee</p></div>
        </article>

        @if (ViewBag.ResultReport is EvaluationReport resultReport && ViewBag.ResultStep is Sourcing_Tender_Management_System.Services.TenderResultFlow.Step resultStep) {
        <section class="od-card od-result" aria-labelledby="result-cycle-heading">
        <header class="od-card-head"><h2 id="result-cycle-heading">Result cycle — report round @resultReport.Round</h2></header>
        <p>Chosen bid: <strong>@resultReport.RecommendedBid?.Supplier.CompanyName (@resultReport.RecommendedBid?.BidNumber)</strong></p>
        @switch (resultStep) {
            case Sourcing_Tender_Management_System.Services.TenderResultFlow.Step.AtOfficerToForward:
                <p>The evaluation committee sent you its report and chosen bid. Forward it to the sourcing manager.</p>
                <form asp-action="ForwardReportToManager" method="post"><input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-primary">Forward report to sourcing manager</button></form>
                break;
            case Sourcing_Tender_Management_System.Services.TenderResultFlow.Step.AtManagerReview:
                <p role="status">Waiting for the sourcing manager's decision.</p>
                break;
            case Sourcing_Tender_Management_System.Services.TenderResultFlow.Step.AtTopCommittee:
                <p role="status">Waiting for the Top Committee's vote.</p>
                break;
            case Sourcing_Tender_Management_System.Services.TenderResultFlow.Step.AtManagerToForwardDecision:
                <p role="status">The Top Committee decided (@resultReport.Status). Waiting for the sourcing manager to forward the decision to you.</p>
                break;
            case Sourcing_Tender_Management_System.Services.TenderResultFlow.Step.AtOfficerToAnnounce:
                @if (resultReport.Status == RecommendationStatus.CommitteeApproved) {
                    <p>The Top Committee approved the award. Send the winning message to the chosen supplier and a "not selected" message to the other bidders.</p>
                } else {
                    <p>The Top Committee rejected the recommendation and the tender is cancelled. Tell every bidder that no offer was awarded.</p>
                }
                <form asp-action="AnnounceResult" method="post"><input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-success">Send result to suppliers</button></form>
                break;
            case Sourcing_Tender_Management_System.Services.TenderResultFlow.Step.AtOfficerToSendBack:
                <p>The Top Committee asked for further details. Send the tender back to the evaluation committee for a new round.</p>
                <form asp-action="SendBackToCommittee" method="post"><input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-outline-primary">Send back to evaluation committee</button></form>
                break;
            case Sourcing_Tender_Management_System.Services.TenderResultFlow.Step.Done:
                <p role="status">This round is finished: the result was sent to the suppliers, or the tender went back to the committee.</p>
                break;
        }
        </section>
        }

        @if (Model.EvaluationReports.Count > 0) {
        <article class="od-card" aria-labelledby="reports-title">
            <header class="od-card-head"><h2 id="reports-title">Committee reports</h2><span class="od-count">@Model.EvaluationReports.Count</span></header>
            <ul class="od-reports">
            @foreach (var report in Model.EvaluationReports.OrderByDescending(r => r.Round)) {
            <li>
                <div class="od-report-head"><strong>Report round @report.Round</strong><span class="od-chip" data-tone="@Tone(report.Status.ToString())">@Words(report.Status.ToString())</span><span class="od-muted">@(report.SubmittedAt?.ToString("dd MMM yyyy HH:mm") ?? "Not submitted")</span></div>
                @if (report.RecommendedBid is { } chosenBid) {
                <p class="mb-0">Chosen bid: <strong>@chosenBid.Supplier.CompanyName (@chosenBid.BidNumber)</strong> · @chosenBid.TotalAmount.ToString("N2") @chosenBid.Currency</p>
                }
                @if (!string.IsNullOrWhiteSpace(report.Summary)) {
                <details class="od-more"><summary>Committee report round @report.Round</summary><pre class="preserve-lines">@report.Summary</pre>
                @if (!string.IsNullOrWhiteSpace(report.RecommendationReason)) { <p>@report.RecommendationReason</p> }</details>
                }
            </li>
            }
            </ul>
        </article>
        }
    </section>

    @* ---------------- Activity ---------------- *@
    <section class="od-panel" id="tab-activity" role="tabpanel" aria-labelledby="tab-activity-btn" data-panel="activity">
        <article class="od-card" aria-labelledby="history-title">
            <header class="od-card-head"><h2 id="history-title">Workflow history</h2><span class="od-count">@history.Count</span></header>
            @if (history.Count == 0) { <p class="od-empty">No workflow events recorded.</p> }
            else {
            <ol class="od-timeline">
            @for (var i = 0; i < history.Count; i++) {
                var entry = history[i];
                <li data-search-item class="@(i == 0 ? "is-latest" : null)">
                    <span class="od-dot" aria-hidden="true"></span>
                    <div class="od-event">
                        <div class="od-event-top"><strong>@Words(entry.FromStage.ToString()) → @Words(entry.ToStage.ToString())</strong><span class="od-chip" data-tone="@Tone(entry.Action.ToString())">@Words(entry.Action.ToString())</span></div>
                        <p class="od-muted mb-1">@(entry.PerformedByUser?.FullName ?? "System") · <time datetime="@DateTime.SpecifyKind(entry.CreatedAt, DateTimeKind.Utc).ToString("O")">@entry.CreatedAt.ToString("dd MMM yyyy HH:mm") UTC</time></p>
                        @if (!string.IsNullOrWhiteSpace(entry.Reason)) { <p class="mb-0">@entry.Reason</p> }
                    </div>
                </li>
            }
            </ol>
            }
        </article>
    </section>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const closeForm = document.querySelector('[data-close-bidding]');
    const closeWaiting = document.querySelector('[data-close-waiting]');
    if (closeForm) {
        const deadline = new Date(closeForm.dataset.deadline).getTime();
        const syncCloseAction = function () {
            const ready = Number.isFinite(deadline) && Date.now() >= deadline;
            closeForm.hidden = !ready;
            if (closeWaiting) closeWaiting.hidden = ready;
            return ready;
        };
        if (!syncCloseAction()) {
            const closeTimer = window.setInterval(function () {
                if (syncCloseAction()) window.clearInterval(closeTimer);
            }, 1000);
        }
    }

    const form = document.querySelector('.od-invite');
    if (!form) return;
    const boxes = Array.from(form.querySelectorAll('input[name="supplierIds"]'));
    const status = form.querySelector('[data-supplier-selection-status]');
    const button = form.querySelector('button[type="submit"]');
    function sync() {
        const count = boxes.filter(x => x.checked).length;
        status.textContent = count ? `${count} selected` : 'No suppliers selected';
        button.disabled = count === 0;
    }
    boxes.forEach(x => x.addEventListener('change', sync)); sync();
});
</script>
</div>
@section Scripts { <script src="~/js/officer-tender-tabs.js" asp-append-version="true"></script> }
