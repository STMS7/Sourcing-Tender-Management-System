@model Tender
@using Sourcing_Tender_Management_System.Services
@{
    ViewData["Title"] = "Assign evaluation committee";
    var candidates = (Dictionary<CommitteeMemberRole, List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>>)ViewBag.CommitteeCandidates;
    var canAssign = ViewBag.CanAssign is true;
}
<a asp-action="Index">Back to evaluation committees</a>
<h1 class="mt-3">Assign evaluation committee</h1>
<p>@Model.TenderNumber · @Model.Title · <span class="badge bg-secondary">@Model.Status</span></p>
@if (TempData["Error"] is string error) { <p class="alert alert-danger" role="alert">@error</p> }
@if (TempData["Message"] is string message) { <p class="alert alert-success" role="status">@message</p> }
@if (canAssign) {
    <p>Select four distinct active employees with the required roles. This assigns members to this tender without changing their account roles.</p>
    <form asp-action="Assign" method="post" class="col-lg-8">
    <input type="hidden" name="TenderId" value="@Model.Id" />
    @foreach (var position in EvaluationPreparation.Positions) {
        var field = position switch { CommitteeMemberRole.SourcingManager => "ManagerUserId", CommitteeMemberRole.DepartmentRepresentative => "DepartmentUserId", CommitteeMemberRole.TechnicalRepresentative => "TechnicalUserId", _ => "FinancialUserId" };
        var label = position switch { CommitteeMemberRole.SourcingManager => "Sourcing manager", CommitteeMemberRole.DepartmentRepresentative => "Department representative", CommitteeMemberRole.TechnicalRepresentative => "Technical representative", _ => "Financial representative" };
        var current = Model.CommitteeMembers.FirstOrDefault(m => m.CommitteeType == CommitteeType.Evaluation && m.RoleType == position)?.UserId;
        <div class="mb-3"><label for="@field" class="form-label">@label</label><select id="@field" name="@field" class="form-select" required>
        <option value="">Choose a member</option>
        @foreach (var candidate in candidates[position]) { <option value="@candidate.Value" selected="@(candidate.Value == current)">@candidate.Text</option> }
        </select>
        @if (candidates[position].Count == 0) { <p class="small text-secondary mt-1">No eligible employee. Activate an account with this role in user management.</p> }
        </div>
    }
    <button type="submit" class="btn btn-primary">Save evaluation committee</button>
    </form>
} else {
    <p class="alert alert-info">Committee assignment is locked during approval and after publication. Before publication, the sourcing officer can reopen preparation if reassignment is needed.</p>
}
<h2 class="h4 mt-4">Assigned members</h2>
@if (!Model.CommitteeMembers.Any(m => m.CommitteeType == CommitteeType.Evaluation)) { <p>No evaluation committee assigned yet.</p> }
else { <ul>
@foreach (var member in Model.CommitteeMembers.Where(m => m.CommitteeType == CommitteeType.Evaluation)) {
    <li>@member.User.FullName — @(member.RoleType?.ToString() ?? member.Role)</li>
}
</ul> }
