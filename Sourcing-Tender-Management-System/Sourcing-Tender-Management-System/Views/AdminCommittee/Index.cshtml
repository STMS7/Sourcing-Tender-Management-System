@model IReadOnlyList<Tender>
@{
    ViewData["Title"] = "Evaluation committees";
    var currentPage = ViewBag.CurrentPage is int page ? page : 1;
    var totalPages = ViewBag.TotalPages is int pages ? pages : 1;
    var totalCount = ViewBag.TotalCount is int count ? count : Model.Count;
    const int pageSize = 4;
    var firstResult = totalCount == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    var lastResult = Math.Min(currentPage * pageSize, totalCount);
}

<div class="py-4">
    <a class="btn btn-sm btn-outline-primary mb-3" asp-controller="Admin" asp-action="Users">← Back to users</a>
    <h1>Evaluation committees</h1>
    <p class="text-secondary">Assign the four evaluation members for each tender before preparation approval.</p>

    <partial name="_WorkspaceSearch" model="@(new WorkspaceSearchViewModel { Id = "committee-search", ResultsId = "committee-results", Label = "Search tenders", Placeholder = "Search tender number or title", Action = Url.Action("Index", "AdminCommittee"), SearchValue = ViewBag.Search, Local = false })" />

    <div id="committee-results" aria-busy="false">
    <span hidden data-result-count="@totalCount"></span>
    <div class="d-flex justify-content-between align-items-center mb-2 px-1 small text-secondary">
        <span>Showing @firstResult–@lastResult of @totalCount tenders</span>
        <span>Page @currentPage of @totalPages</span>
    </div>

    <div class="table-responsive shadow-sm rounded-4 zt-admin-table">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Tender</th><th>Status</th><th>Assignment</th><th class="text-end">Action</th></tr></thead>
            <tbody>
            @foreach (var tender in Model)
            {
                var memberCount = tender.CommitteeMembers.Count(m => m.CommitteeType == CommitteeType.Evaluation);
                var complete = memberCount == 4;
                <tr>
                    <td><strong>@tender.TenderNumber</strong><div class="small text-secondary mt-1">@tender.Title</div></td>
                    <td><span class="badge rounded-pill text-bg-light border">@tender.Status</span></td>
                    <td><span class="badge rounded-pill @(complete ? "text-bg-success" : "text-bg-warning")">@memberCount of 4 members</span></td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@tender.Id" aria-label="Manage committee for @tender.TenderNumber">Manage committee</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (Model.Count == 0) { <div class="alert alert-light border mt-3">No tenders found.</div> }

    @if (totalPages > 1)
    {
        <nav class="mt-4" aria-label="Evaluation committee pages">
            <ul class="pagination justify-content-center flex-wrap">
                <li class="page-item @(currentPage == 1 ? "disabled" : null)"><a class="page-link" asp-action="Index" asp-route-search="@ViewBag.Search" asp-route-page="@(currentPage - 1)">Previous</a></li>
                @for (var number = 1; number <= totalPages; number++)
                { <li class="page-item @(number == currentPage ? "active" : null)"><a class="page-link" asp-action="Index" asp-route-search="@ViewBag.Search" asp-route-page="@number">@number</a></li> }
                <li class="page-item @(currentPage == totalPages ? "disabled" : null)"><a class="page-link" asp-action="Index" asp-route-search="@ViewBag.Search" asp-route-page="@(currentPage + 1)">Next</a></li>
            </ul>
        </nav>
    }
    </div>
</div>
