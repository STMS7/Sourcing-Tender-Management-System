@model TopCommitteeStatisticsViewModel
@{
    ViewData["Title"] = "Statistics";

    // Same numbers as before, only drawn as rings and bars. Each chart also lists its numbers as text, so colour is never the only signal.
    string Tone(string status) => status switch
    {
        "Approved" or "Awarded" or "Accepted" or "Compliant" => "ok",
        "Pending" or "UnderEvaluation" or "PendingClarification" or "Draft" or "Submitted" or "Awaiting decision" => "warn",
        "Rejected" or "Cancelled" or "NonCompliant" or "Disqualified" => "bad",
        "ReturnedForRevision" or "ReturnedForDetails" or "Returned for details" => "info",
        "ConvertedToTender" or "Published" or "Closed" => "olive",
        _ => "neutral"
    };
    string Color(string tone) => tone switch
    {
        "ok" => "#3D4A2A", "warn" => "#C9A84C", "bad" => "#B4411E", "info" => "#8C9A55", "olive" => "#6B7B3A", _ => "#B3B7A2"
    };
    string Words(string value) => System.Text.RegularExpressions.Regex.Replace(value ?? string.Empty, "(?<!^)([A-Z])", m => " " + m.Value.ToLowerInvariant());
    string Ring(IEnumerable<(string Label, int Count, string Tone)> parts)
    {
        var list = parts.ToList();
        var total = list.Sum(p => p.Count);
        if (total == 0) { return "conic-gradient(#E4DCC8 0 100%)"; }
        double start = 0;
        var stops = new List<string>();
        foreach (var p in list.Where(p => p.Count > 0))
        {
            var end = start + 100.0 * p.Count / total;
            stops.Add($"{Color(p.Tone)} {start.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}% {end.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%");
            start = end;
        }
        return "conic-gradient(" + string.Join(", ", stops) + ")";
    }
    string Summary(string title, IEnumerable<(string Label, int Count, string Tone)> parts) => title + ": " + string.Join(", ", parts.Select(p => p.Label + " " + p.Count));
    var decisions = new List<(string Label, int Count, string Tone)>
    {
        ("Awaiting decision", Model.Decisions.AwaitingDecision, "warn"),
        ("Approved", Model.Decisions.Approved, "ok"),
        ("Rejected", Model.Decisions.Rejected, "bad"),
        ("Returned for details", Model.Decisions.ReturnedForDetails, "info")
    };
    var tenders = Model.TenderStatuses.Select(s => (Label: Words(s.Status), s.Count, Tone: Tone(s.Status))).ToList();
    var supplierStatuses = Model.SupplierStatuses.Select(s => (Label: Words(s.Status), s.Count, Tone: Tone(s.Status))).ToList();
    var requestStatuses = Model.RequestStatuses.Select(s => (Label: Words(s.Status), s.Count, Tone: Tone(s.Status))).ToList();
    var maxTender = Math.Max(1, tenders.Select(t => t.Count).DefaultIfEmpty(0).Max());
    var decisionTotal = decisions.Sum(d => d.Count);
    var suppliersWithBids = Model.Suppliers.Count(s => s.BidsSubmitted > 0);
    const string svgOpen = "<svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"";
    const string svgClose = "\"></path></svg>";
    const string IconPeople = "M9 11a3 3 0 100-6 3 3 0 000 6zM3 20c.8-3 3-5 6-5s5.2 2 6 5M16 5a3 3 0 010 6M18 15c1.6.6 2.6 2.4 3 5";
    const string IconCheck = "M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6zM9 12l2 2 4-4";
    const string IconBuilding = "M4 21V5l8-3 8 3v16M9 21v-5h6v5M8 9h.01M12 9h.01M16 9h.01M8 13h.01M12 13h.01M16 13h.01";
    const string IconList = "M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01";
    const string IconDoc = "M6 3h9l4 4v14H6zM14 3v5h5M9 13h6M9 17h6";
    const string IconBids = "M6 3h9l4 4v14H6zM9 14l2 2 4-4";
    const string IconContract = "M5 4h14v16H5zM8 9h8M8 13h8M8 17h5";
    const string IconCoin = "M12 3v18M16 7.5c0-1.7-1.8-3-4-3s-4 1.1-4 2.8c0 3.9 8 1.9 8 5.8 0 1.8-1.8 3-4 3s-4-1.3-4-3";
    var cards = new (string Label, string Value, string Note, string Icon)[]
    {
        ("Suppliers", Model.Totals.Suppliers.ToString(), "Registered suppliers", IconPeople),
        ("Approved suppliers", Model.Totals.ApprovedSuppliers.ToString(), "Allowed to bid", IconCheck),
        ("Departments", Model.Totals.Departments.ToString(), "Requesting departments", IconBuilding),
        ("Purchase requests", Model.Totals.ProcurementRequests.ToString(), "All requests", IconList),
        ("Tenders", Model.Totals.Tenders.ToString(), "Created tenders", IconDoc),
        ("Submitted bids", Model.Totals.Bids.ToString(), "Received offers", IconBids),
        ("Contracts", Model.Totals.Contracts.ToString(), "Signed contracts", IconContract),
        ("Contracts value", Model.Totals.ContractsValue.ToString("N2"), "Total as stored (JOD by default)", IconCoin)
    };
}
<link rel="stylesheet" href="~/css/committee-statistics.css" asp-append-version="true" />

<div id="statistics-search-results">
<h1 class="h3 mb-3">Top Committee</h1>
<partial name="_Nav" model="@("Statistics")" />

<div class="st">
    <div class="st-head">
        <div>
            <p class="st-kicker">Procurement performance</p>
            <p class="st-meta">Generated @Model.GeneratedAt.ToString("yyyy-MM-dd HH:mm") UTC</p>
        </div>
        <a class="btn btn-success" asp-action="DownloadStatistics">Download as CSV (Excel)</a>
    </div>

    <partial name="_WorkspaceSearch" model="@(new WorkspaceSearchViewModel { Id = "statistics-search", ResultsId = "statistics-search-results", Label = "Search statistics and supplier dealings" })" />

    <ul class="st-kpis" aria-label="Totals">
        @for (var i = 0; i < cards.Length; i++)
        {
            var c = cards[i];
            <li data-search-item class="st-kpi @(i == 0 ? "is-dark" : null)">
                <span class="st-kpi-icon">@Html.Raw(svgOpen + c.Icon + svgClose)</span>
                <span class="st-kpi-value">@c.Value</span>
                <span class="st-kpi-label">@c.Label</span>
                <span class="st-kpi-note">@c.Note</span>
            </li>
        }
    </ul>

    <div class="st-grid">
        <section class="st-panel" aria-labelledby="st-decisions">
            <h2 id="st-decisions">Top Committee decisions</h2>
            <div class="st-donut-row">
                <div class="st-donut" role="img" aria-label="@Summary("Committee decisions", decisions)" style="--ring: @Ring(decisions)"><span><strong>@decisionTotal</strong>Decisions</span></div>
                <ul class="st-legend">
                    @foreach (var d in decisions)
                    {
                        <li data-search-item><i data-tone="@d.Tone" aria-hidden="true"></i><span>@d.Label</span><b>@d.Count</b></li>
                    }
                </ul>
            </div>
        </section>

        <section class="st-panel" aria-labelledby="st-tenders">
            <h2 id="st-tenders">Tenders by status</h2>
            @if (tenders.Count == 0) { <p class="st-empty">No tenders yet.</p> }
            else
            {
                <ul class="st-bars">
                    @foreach (var t in tenders)
                    {
                        <li data-search-item><span class="st-bar-label">@t.Label</span><span class="st-bar-track"><span data-tone="@t.Tone" style="width: @((100.0 * t.Count / maxTender).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></span></span><b>@t.Count</b></li>
                    }
                </ul>
            }
        </section>

        <section class="st-panel" aria-labelledby="st-suppliers">
            <h2 id="st-suppliers">Suppliers by status</h2>
            <div class="st-donut-row">
                <div class="st-donut" role="img" aria-label="@Summary("Suppliers by status", supplierStatuses)" style="--ring: @Ring(supplierStatuses)"><span><strong>@supplierStatuses.Sum(s => s.Count)</strong>Suppliers</span></div>
                <ul class="st-legend">
                    @foreach (var s in supplierStatuses)
                    {
                        <li data-search-item><i data-tone="@s.Tone" aria-hidden="true"></i><span>@s.Label</span><b>@s.Count</b></li>
                    }
                </ul>
            </div>
        </section>

        <section class="st-panel" aria-labelledby="st-requests">
            <h2 id="st-requests">Purchase requests by status</h2>
            <div class="st-donut-row">
                <div class="st-donut" role="img" aria-label="@Summary("Purchase requests by status", requestStatuses)" style="--ring: @Ring(requestStatuses)"><span><strong>@requestStatuses.Sum(s => s.Count)</strong>Requests</span></div>
                <ul class="st-legend">
                    @foreach (var s in requestStatuses)
                    {
                        <li data-search-item><i data-tone="@s.Tone" aria-hidden="true"></i><span>@s.Label</span><b>@s.Count</b></li>
                    }
                </ul>
            </div>
        </section>
    </div>

    <section class="st-panel st-insights" aria-labelledby="st-insights">
        <h2 id="st-insights">Procurement insights</h2>
        <ul>
            <li data-search-item><strong>@Model.Decisions.AwaitingDecision</strong><span>Pending committee decisions</span><small>@(Model.Decisions.AwaitingDecision == 1 ? "Tender" : "Tenders") awaiting a decision</small></li>
            <li data-search-item><strong>@Model.Totals.Bids</strong><span>Supplier participation</span><small>Submitted bids across @suppliersWithBids @(suppliersWithBids == 1 ? "supplier" : "suppliers")</small></li>
            <li data-search-item><strong>@Model.Totals.Contracts</strong><span>Contracts awarded</span><small>@(Model.Totals.Contracts == 0 ? "No contracts yet" : "Total value " + Model.Totals.ContractsValue.ToString("N2"))</small></li>
        </ul>
    </section>

    <section class="st-panel st-table-panel" aria-labelledby="st-dealings">
        <h2 id="st-dealings">Dealings with each supplier</h2>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Supplier</th>
                        <th>Status</th>
                        <th class="text-center">Invitations</th>
                        <th class="text-center">Bids submitted</th>
                        <th class="text-center">Tenders awarded</th>
                        <th class="text-end">Awarded amount</th>
                        <th class="text-center">Contracts</th>
                        <th class="text-end">Contracts value</th>
                        <th class="text-center">Purchase orders</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var s in Model.Suppliers)
                {
                    <tr data-search-item>
                        <td class="fw-semibold">@s.CompanyName</td>
                        <td><partial name="_Badge" model="@s.RegistrationStatus.ToString()" /></td>
                        <td class="text-center">@s.Invitations</td>
                        <td class="text-center">@s.BidsSubmitted</td>
                        <td class="text-center">@s.TendersAwarded</td>
                        <td class="text-end">@s.AwardedAmount.ToString("N2")</td>
                        <td class="text-center">@s.Contracts</td>
                        <td class="text-end">@s.ContractsValue.ToString("N2")</td>
                        <td class="text-center">@s.PurchaseOrders</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</div>
</div>
