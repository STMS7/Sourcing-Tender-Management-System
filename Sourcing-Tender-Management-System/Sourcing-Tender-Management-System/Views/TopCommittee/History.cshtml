@model TopCommitteeHistoryViewModel
@{
    ViewData["Title"] = "Decision history";
}
<div class="manager-page ec-page dp-page">
<div class="dp-head">
    <div class="manager-page-heading">
        <h1 class="manager-title mb-1">Decision history</h1>
        <p class="manager-intro mb-0">Every tender the Top Committee has decided, with its votes and award.</p>
    </div>
</div>
<partial name="_Nav" model="@("History")" />

<ul class="zt-bento" aria-label="History summary">
    <li><div class="zt-tile"><span class="zt-tile-label">Decisions</span><span class="zt-tile-value">@Model.Decisions.Count</span></div></li>
    <li><div class="zt-tile"><span class="zt-tile-label">Approved</span><span class="zt-tile-value">@Model.Decisions.Count(d => d.Outcome.ToString() == "Approved")</span></div></li>
    <li><div class="zt-tile"><span class="zt-tile-label">Rejected</span><span class="zt-tile-value">@Model.Decisions.Count(d => d.Outcome.ToString() == "Rejected")</span></div></li>
    <li><div class="zt-tile"><span class="zt-tile-label">Returned for details</span><span class="zt-tile-value">@Model.Decisions.Count(d => d.Outcome.ToString().StartsWith("Returned"))</span></div></li>
</ul>

<section class="dp-panel mb-4" aria-label="Search decisions">
    <form method="get" asp-action="History" class="zt-search-toolbar dp-filter" style="grid-template-columns:minmax(0,1fr) auto" role="search"
          data-live-search data-search-response="document" data-results="top-history-results" data-search-status="top-history-status">
        <div>
            <label for="top-history-search" class="form-label">Tender number or title</label>
            <div class="zt-search-shell"><input id="top-history-search" type="search" name="search" value="@Model.Search" class="form-control zt-search-input" placeholder="Search by tender number or title" dir="auto" data-search-input /><partial name="_SearchVoiceTools" /></div>
        </div>
        <div class="dp-filter-actions">
            <button class="btn btn-primary" type="submit">Search</button>
            <button class="btn btn-outline-secondary" type="button" data-search-reset>Clear</button>
        </div>
    </form>
    <p id="top-history-status" role="status" class="small text-secondary dp-filter-status"></p>
</section>

<section class="card manager-card mb-4">
    <div class="card-header dp-split"><h2 class="h5 mb-0">Decided tenders</h2><span class="badge">@Model.Decisions.Count</span></div>
    <div id="top-history-results" aria-busy="false">
    @if (Model.Decisions.Count == 0)
    {
        <p class="empty-state">No decisions found.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <caption class="visually-hidden">Top Committee decisions</caption>
                <thead>
                    <tr>
                        <th scope="col">Tender</th>
                        <th scope="col">Decided</th>
                        <th scope="col">Outcome</th>
                        <th scope="col" class="text-center">Votes<br /><span class="text-lowercase">✓ / ✗ / ↩</span></th>
                        <th scope="col">Awarded to</th>
                        <th scope="col">Tender status</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var d in Model.Decisions)
                {
                    <tr data-search-item>
                        <td>
                            <a class="dp-req-title" asp-action="Details" asp-route-id="@d.TenderId">@d.Title</a>
                            <span class="dp-num dp-num-wide" title="@d.TenderNumber">@d.TenderNumber</span>
                            @if (d.Round > 1) { <span class="badge mt-1">Round @d.Round</span> }
                        </td>
                        <td class="text-nowrap">@(d.DecidedAt?.ToString("dd MMM yyyy") ?? "—")</td>
                        <td><partial name="_Badge" model="@d.Outcome.ToString()" /></td>
                        <td class="text-center text-nowrap money">@d.ApprovedVotes / @d.RejectedVotes / @d.ReturnedVotes</td>
                        <td>
                            @if (d.AwardedSupplierName is not null)
                            {
                                <span class="fw-semibold d-block">@d.AwardedSupplierName</span>
                                <span class="dp-meta mt-0 money">@d.AwardedAmount?.ToString("N2")</span>
                            }
                            else
                            {
                                <span class="dp-meta mt-0">Recommended: @(d.RecommendedSupplierName ?? "—")</span>
                            }
                        </td>
                        <td><partial name="_Badge" model="@d.TenderStatus.ToString()" /></td>
                        <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@d.TenderId" aria-label="Details for @d.Title">Details</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    </div>
</section>
</div>
