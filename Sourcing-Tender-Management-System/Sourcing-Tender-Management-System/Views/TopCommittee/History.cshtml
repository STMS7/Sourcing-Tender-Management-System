@model TopCommitteeHistoryViewModel
@{
    ViewData["Title"] = "Decision history";
}

<h1 class="h3 mb-3">Top Committee</h1>
<partial name="_Nav" model="@("History")" />

<form method="get" asp-action="History" class="row g-3 align-items-end mb-3" role="search"
      data-live-search data-search-response="document" data-results="top-history-results" data-search-status="top-history-status">
    <div class="col-md-6">
        <label for="top-history-search" class="form-label">Tender number or title</label>
        <input id="top-history-search" type="search" name="search" value="@Model.Search" class="form-control"
               placeholder="Search by tender number or title" dir="auto" data-search-input />
    </div>
    <div class="col-md-3"><partial name="_VoiceLanguage" /></div>
    <div class="col-md-3 d-flex flex-wrap gap-2">
        <button class="btn btn-outline-primary" type="button" data-voice-search aria-pressed="false">Search by voice</button>
        <button class="btn btn-outline-primary" type="submit">Search</button>
        <button class="btn btn-link" type="button" data-search-reset>Clear search</button>
    </div>
</form>
<p id="top-history-status" role="status" class="small text-secondary"></p>
<div id="top-history-results" aria-busy="false">
@if (Model.Decisions.Count == 0)
{
    <div class="alert alert-secondary">No decisions found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Tender</th>
                    <th>Decided</th>
                    <th>Outcome</th>
                    <th class="text-center">Approve / Reject / Return</th>
                    <th>Recommended supplier</th>
                    <th>Awarded to</th>
                    <th>Tender status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var d in Model.Decisions)
            {
                <tr data-search-item>
                    <td>
                        <div class="fw-semibold">@d.TenderNumber</div>
                        <div class="small text-muted">@d.Title</div>
                        @if (d.Round > 1)
                        {
                            <span class="badge text-bg-secondary">Round @d.Round</span>
                        }
                    </td>
                    <td>@d.DecidedAt?.ToString("yyyy-MM-dd")</td>
                    <td><partial name="_Badge" model="@d.Outcome.ToString()" /></td>
                    <td class="text-center">@d.ApprovedVotes / @d.RejectedVotes / @d.ReturnedVotes</td>
                    <td>@(d.RecommendedSupplierName ?? "-")</td>
                    <td>
                        @if (d.AwardedSupplierName is not null)
                        {
                            <div>@d.AwardedSupplierName</div>
                            <div class="small text-muted">@d.AwardedAmount?.ToString("N2")</div>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                    <td><partial name="_Badge" model="@d.TenderStatus.ToString()" /></td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@d.TenderId">Details</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
</div>
