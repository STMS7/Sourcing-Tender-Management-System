@model string
<ul class="nav nav-pills mb-4">
    <li class="nav-item"><a class="nav-link @(Model == "Index" ? "active" : "")" asp-action="Index">Awaiting decision</a></li>
    <li class="nav-item"><a class="nav-link @(Model == "History" ? "active" : "")" asp-action="History">History</a></li>
    <li class="nav-item"><a class="nav-link @(Model == "Statistics" ? "active" : "")" asp-action="Statistics">Statistics</a></li>
</ul>
@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
