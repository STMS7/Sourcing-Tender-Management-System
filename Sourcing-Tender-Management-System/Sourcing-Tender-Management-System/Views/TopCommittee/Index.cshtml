@model TopCommitteeDashboardViewModel
@{
    ViewData["Title"] = "Top Committee";
}

<div id="top-committee-search-results" class="manager-page ec-page dp-page">
<div class="dp-head">
    <div class="manager-page-heading">
        <h1 class="manager-title mb-1">Top Committee</h1>
        <p class="manager-intro mb-0">@(Model.MyPendingVotesCount == 0 ? "No tender is waiting for your vote." : Model.MyPendingVotesCount == 1 ? "One tender is waiting for your vote." : $"{Model.MyPendingVotesCount} tenders are waiting for your vote.")</p>
    </div>
</div>
<partial name="_Nav" model="@("Index")" />

<ul class="zt-bento" aria-label="Top Committee summary">
    <li><div class="zt-tile"><span class="zt-tile-label">Awaiting decision</span><span class="zt-tile-value">@Model.AwaitingDecisionCount</span></div></li>
    <li><div class="zt-tile @(Model.MyPendingVotesCount > 0 ? "is-alert" : "")"><span class="zt-tile-label">Waiting for my vote</span><span class="zt-tile-value">@Model.MyPendingVotesCount</span>@if (Model.MyPendingVotesCount > 0) {<span class="zt-tile-note">Your vote is needed</span>}</div></li>
    <li><div class="zt-tile"><span class="zt-tile-label">Decided so far</span><span class="zt-tile-value">@Model.DecidedCount</span></div></li>
    <li><div class="zt-tile"><span class="zt-tile-label">Estimated value awaiting</span><span class="zt-tile-value">@Model.AwaitingTotalEstimatedValue.ToString("N0")</span></div></li>
</ul>

<section class="manager-search-panel mb-4" aria-label="Search tenders">
<partial name="_WorkspaceSearch" model="@(new WorkspaceSearchViewModel { Id = "top-committee-search", ResultsId = "top-committee-search-results", Label = "Search tenders awaiting a decision", Placeholder = "Tender, category or supplier" })" />
</section>
<section class="card manager-card mb-4">
<div class="card-header"><h2 class="h5 mb-0">Tenders awaiting the committee's decision</h2></div>
@if (Model.AwaitingTenders.Count == 0)
{
    <p class="empty-state">Nothing is waiting for a decision.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Tender</th>
                    <th>Category</th>
                    <th class="text-end">Estimated value</th>
                    <th class="text-center">Bids</th>
                    <th>Recommended supplier</th>
                    <th class="text-center">Votes</th>
                    <th>My vote</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var t in Model.AwaitingTenders)
            {
                <tr data-search-item>
                    <td>
                        <a class="dp-req-title" asp-action="Details" asp-route-id="@t.TenderId">@t.Title</a>
                        <span class="dp-num dp-num-wide" title="@t.TenderNumber">@t.TenderNumber</span>
                        @if (t.Round > 1)
                        {
                            <span class="badge text-bg-secondary">Round @t.Round</span>
                        }
                    </td>
                    <td>@t.CategoryName</td>
                    <td class="text-end">@t.EstimatedValue.ToString("N2")</td>
                    <td class="text-center">@t.BidCount</td>
                    <td>
                        @if (t.RecommendedSupplierName is not null)
                        {
                            <div>@t.RecommendedSupplierName</div>
                            <div class="small text-muted">@t.RecommendedAmount?.ToString("N2")</div>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                    <td class="text-center">@t.VotesCast / @t.VotesTotal</td>
                    <td>
                        @if (t.MyVote is { } mine)
                        {
                            <partial name="_Badge" model="@mine.ToString()" />
                        }
                        else
                        {
                            <span class="text-muted">not a member</span>
                        }
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-primary" asp-action="Details" asp-route-id="@t.TenderId">
                            @(t.MyVote == CommitteeDecision.Pending ? "Review and vote" : "Review")
                        </a>
                        @if (t.MyVote is not null)
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-action="Meeting" asp-route-id="@t.TenderId">Meeting</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
</section>
</div>
