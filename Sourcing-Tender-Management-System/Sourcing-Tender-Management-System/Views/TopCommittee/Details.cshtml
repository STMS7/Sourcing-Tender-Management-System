@model TopCommitteeReviewViewModel
@{
    ViewData["Title"] = Model.Title;
    var voted = Model.CommitteeVotes.Count(v => v.Decision != CommitteeDecision.Pending);
    string VoteLabel(CommitteeDecision d) => d switch
    {
        CommitteeDecision.Approved => "Approved",
        CommitteeDecision.Rejected => "Rejected",
        CommitteeDecision.ReturnedForRevision => "ReturnedForRevision",
        _ => "Pending"
    };
}
<div id="top-details-search-results" class="manager-page ec-page dp-page">
<div class="dp-head">
    <div class="manager-page-heading">
        <a asp-action="Index" class="dp-crumb"><span aria-hidden="true">←</span> Top Committee</a>
        <h1 class="manager-title mb-1">@Model.Title</h1>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <partial name="_Badge" model="@Model.Status.ToString()" />
            <span class="dp-num" title="@Model.TenderNumber">@Model.TenderNumber</span>
        </div>
    </div>
    @if (Model.MyVote is not null)
    {
        <div class="actions"><a class="btn btn-outline-primary" asp-action="Meeting" asp-route-id="@Model.TenderId">Committee meeting</a></div>
    }
</div>
<partial name="_Nav" model="@("")" />
@await Component.InvokeAsync("TenderJourney", new { tenderId = Model.TenderId, yourTurn = Model.MyVote == CommitteeDecision.Pending ? true : Model.MyVote != null ? false : (bool?)null, anchor = "vote" })

<div class="row g-4">
<div class="col-xl-8">

    @* ---------- At a glance: the few facts a committee member needs ---------- *@
    @{
        var recommendedBid = Model.Bids.FirstOrDefault(b => b.IsRecommended);
        var awardedBid = Model.Bids.FirstOrDefault(b => b.IsAwarded);
        var approvedVotes = Model.CommitteeVotes.Count(v => v.Decision == CommitteeDecision.Approved);
        var rejectedVotes = Model.CommitteeVotes.Count(v => v.Decision == CommitteeDecision.Rejected);
        var returnedVotes = Model.CommitteeVotes.Count(v => v.Decision == CommitteeDecision.ReturnedForRevision);
        var castVotes = approvedVotes + rejectedVotes + returnedVotes;
        var lowestBid = Model.Bids.OrderBy(b => b.TotalAmount).FirstOrDefault();
    }
    <ul class="zt-bento" aria-label="Decision at a glance">
        <li><div class="zt-tile"><span class="zt-tile-label">@(awardedBid != null ? "Awarded to" : "Recommended")</span><span class="zt-tile-value" style="font-size:1.2rem;line-height:1.2;white-space:normal;overflow-wrap:anywhere">@((awardedBid ?? recommendedBid)?.SupplierName ?? "—")</span><span class="zt-tile-note">@((awardedBid ?? recommendedBid) is { } chosen ? $"{chosen.TotalAmount:N2} {chosen.Currency}" : "No supplier")</span></div></li>
        <li><div class="zt-tile"><span class="zt-tile-label">Votes</span><span class="zt-tile-value">@castVotes / @Model.CommitteeVotes.Count</span><span class="zt-tile-note">@approvedVotes approve · @rejectedVotes reject · @returnedVotes return</span></div></li>
        <li><div class="zt-tile"><span class="zt-tile-label">Bids compared</span><span class="zt-tile-value">@Model.Bids.Count</span><span class="zt-tile-note">@(lowestBid is null ? "—" : $"Lowest {lowestBid.TotalAmount:N2} {lowestBid.Currency}")</span></div></li>
        <li><div class="zt-tile"><span class="zt-tile-label">Estimated value</span><span class="zt-tile-value" style="font-size:1.35rem">@Model.EstimatedValue.ToString("N2")</span><span class="zt-tile-note">@Model.CategoryName</span></div></li>
    </ul>

    @* ---------- Vote ---------- *@
    @if (Model.Report.IsAwaitingDecision && Model.MyVote == CommitteeDecision.Pending)
    {
        var recommended = Model.Bids.FirstOrDefault(b => b.IsRecommended);
        <section class="card manager-card mb-4 tc-decision" id="vote" aria-labelledby="decision-title">
            <div class="card-header"><h2 id="decision-title" class="h5 mb-0">Your vote</h2></div>
            <div class="card-body">
                <p class="mb-3">
                    The evaluation committee recommends
                    <strong>@(recommended?.SupplierName ?? "no supplier")</strong>@(recommended is null ? "" : $" ({recommended.TotalAmount:N2} {recommended.Currency})").
                    A justification is required if you reject or ask for more details.
                </p>
                <form asp-action="Vote" method="post">
                    <input type="hidden" name="EvaluationReportId" value="@Model.Report.EvaluationReportId" />
                    <div class="tc-choices" role="radiogroup" aria-label="Your decision">
                        <div class="tc-choice is-approve">
                            <input type="radio" name="Decision" id="dApprove" value="@((int)CommitteeDecision.Approved)" required>
                            <label for="dApprove"><strong>Approve</strong><span>Award the recommended supplier</span></label>
                        </div>
                        <div class="tc-choice is-reject">
                            <input type="radio" name="Decision" id="dReject" value="@((int)CommitteeDecision.Rejected)">
                            <label for="dReject"><strong>Reject</strong><span>Do not accept the recommendation</span></label>
                        </div>
                        <div class="tc-choice is-return">
                            <input type="radio" name="Decision" id="dReturn" value="@((int)CommitteeDecision.ReturnedForRevision)">
                            <label for="dReturn"><strong>Ask for more details</strong><span>Return the tender to the committee</span></label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="reason">Justification / notes</label>
                        <textarea class="form-control" id="reason" name="Reason" rows="3" maxlength="2000"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary"
                            onclick="return confirm('Your vote cannot be changed after it is recorded. Continue?');">
                        Record my vote
                    </button>
                </form>
            </div>
        </section>
    }
    else if (Model.MyVote is { } mine && mine != CommitteeDecision.Pending)
    {
        <div class="alert alert-info d-flex flex-wrap align-items-center gap-2">You voted <partial name="_Badge" model="@VoteLabel(mine)" /> A recorded vote cannot be changed.</div>
    }
    else if (Model.MyVote is null)
    {
        <div class="alert alert-secondary">You are not a voting member on this decision (read-only).</div>
    }

    @* ---------- Bids ---------- *@
    <section class="card manager-card mb-4">
        <div class="card-header dp-split"><h2 class="h5 mb-0">Bids compared</h2><span class="badge">@Model.Bids.Count</span></div>
        @if (Model.Bids.Count == 0) { <p class="empty-state">No bids on this report.</p> }
        else
        {
        @* Three columns so the table fits the card without a horizontal scroll bar. *@
        <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 tc-bids">
            <caption class="visually-hidden">Bids compared</caption>
            <thead>
                <tr>
                    <th scope="col">Supplier</th>
                    <th scope="col" class="text-end">Offer</th>
                    <th scope="col" class="text-end">Scores</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var b in Model.Bids)
            {
                <tr data-search-item class="@(b.IsRecommended ? "tc-recommended" : "")">
                    <td>
                        <span class="fw-semibold">@b.SupplierName</span>
                        @if (b.IsAwarded) { <span class="dp-status is-approved ms-1">Awarded</span> }
                        else if (b.IsRecommended) { <span class="dp-status is-returned ms-1">Recommended</span> }
                        <span class="dp-num dp-num-wide" title="@b.BidNumber">@b.BidNumber</span>
                        <span class="dp-meta mt-1 d-flex flex-wrap align-items-center gap-2">@b.DocumentCount documents
                            @if (b.ComplianceDecision is { } c) { <partial name="_Badge" model="@c.ToString()" /> }</span>
                        @if (!string.IsNullOrWhiteSpace(b.ReportNotes)) { <span class="d-block small mt-1 text-break">@b.ReportNotes</span> }
                    </td>
                    <td class="text-end text-nowrap">
                        <span class="fw-semibold money d-block">@b.TotalAmount.ToString("N2") @b.Currency</span>
                        <span class="dp-meta mt-0">@b.DeliveryDays days delivery</span>
                    </td>
                    <td class="text-end text-nowrap">
                        <span class="fw-semibold d-block">@(b.WeightedTotal?.ToString("0.##") ?? "—") weighted</span>
                        <span class="dp-meta mt-0">Tech. @(b.TechnicalScore?.ToString("0.##") ?? "—") · Fin. @(b.FinancialScore?.ToString("0.##") ?? "—")</span>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        </div>
        }
    </section>

    @* ---------- Committee votes ---------- *@
    <section class="card manager-card mb-4">
        <div class="card-header dp-split"><h2 class="h5 mb-0">Committee votes</h2><span class="badge">@voted of @Model.CommitteeVotes.Count voted</span></div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <caption class="visually-hidden">Committee votes</caption>
                <thead><tr><th scope="col">Member</th><th scope="col">Vote</th><th scope="col">Justification</th><th scope="col">Date</th></tr></thead>
                <tbody>
                @foreach (var v in Model.CommitteeVotes)
                {
                    <tr data-search-item>
                        <td><span class="fw-semibold d-block">@v.MemberName</span><span class="dp-meta mt-0">@(string.IsNullOrWhiteSpace(v.Position) ? "Member" : v.Position)</span></td>
                        <td><partial name="_Badge" model="@VoteLabel(v.Decision)" /></td>
                        <td class="preserve-lines">@(string.IsNullOrWhiteSpace(v.Reason) ? "—" : v.Reason)</td>
                        <td class="text-nowrap">@(v.DecidedAt?.ToString("dd MMM yyyy") ?? "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>

    @* Background the committee rarely needs: kept one click away. *@
    <details class="card manager-card mb-4 tc-more">
        <summary class="card-header dp-split"><h2 class="h5 mb-0">More details</h2><span class="dp-meta mt-0">Report, earlier approvals, request and criteria</span></summary>
        <div class="tc-more-body">
    @* ---------- Report ---------- *@
    <section class="card manager-card mb-4">
        <div class="card-header dp-split"><h2 class="h5 mb-0">Evaluation report</h2><span class="badge">Round @Model.Report.Round</span></div>
        @if (!string.IsNullOrWhiteSpace(Model.Report.Summary)) { <p class="dp-desc">@Model.Report.Summary</p> }
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <caption class="visually-hidden">Report details</caption>
                <tbody>
                    @if (!string.IsNullOrWhiteSpace(Model.Report.RecommendationReason))
                    {
                        <tr data-search-item><th scope="row" class="w-25">Reason for recommendation</th><td class="preserve-lines">@Model.Report.RecommendationReason</td></tr>
                    }
                    <tr><th scope="row" class="w-25">Prepared by</th><td>@Model.Report.PreparedBy</td></tr>
                    <tr><th scope="row">Submitted</th><td>@(Model.Report.SubmittedAt?.ToString("dd MMM yyyy") ?? "—")</td></tr>
                    <tr><th scope="row">Weights</th><td>Technical @Model.TechnicalWeight.ToString("0.##")% · Financial @Model.FinancialWeight.ToString("0.##")%</td></tr>
                </tbody>
            </table>
        </div>
    </section>

    @* ---------- Manager review ---------- *@
    <section class="card manager-card mb-4">
        <div class="card-header"><h2 class="h5 mb-0">Review before the committee</h2></div>
        @if (Model.ManagerApprovals.Count == 0)
        {
            <p class="empty-state">No earlier approval steps recorded.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <caption class="visually-hidden">Earlier approvals</caption>
                    <thead><tr><th scope="col">Step</th><th scope="col">Approver</th><th scope="col">Status</th><th scope="col">Comments</th><th scope="col">Date</th></tr></thead>
                    <tbody>
                    @foreach (var a in Model.ManagerApprovals)
                    {
                        <tr data-search-item>
                            <td>@a.Level</td>
                            <td>@a.ApproverName</td>
                            <td><partial name="_Badge" model="@a.Status.ToString()" /></td>
                            <td class="preserve-lines">@(string.IsNullOrWhiteSpace(a.Comments) ? "—" : a.Comments)</td>
                            <td class="text-nowrap">@(a.DecidedAt?.ToString("dd MMM yyyy") ?? "—")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @* ---------- Original request ---------- *@
    @if (Model.Request is { } r)
    {
        <section class="card manager-card mb-4">
            <div class="card-header"><h2 class="h5 mb-0">Original purchase request</h2></div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <caption class="visually-hidden">Request details</caption>
                    <tbody>
                        <tr><th scope="row" class="w-25">Request</th><td><span class="fw-semibold d-block">@r.Title</span><span class="dp-num dp-num-wide" title="@r.RequestNumber">@r.RequestNumber</span></td></tr>
                        <tr><th scope="row">Department</th><td>@r.DepartmentName</td></tr>
                        <tr><th scope="row">Requested by</th><td>@r.RequestedBy</td></tr>
                        <tr><th scope="row">Priority</th><td>@r.Priority</td></tr>
                        <tr><th scope="row">Estimated budget</th><td class="money">@r.EstimatedBudget.ToString("N2")</td></tr>
                        @if (!string.IsNullOrWhiteSpace(r.Description)) { <tr><th scope="row">Description</th><td class="preserve-lines">@r.Description</td></tr> }
                    </tbody>
                </table>
            </div>
            <h3 class="manager-label px-4 pt-3 mb-2">Items</h3>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <caption class="visually-hidden">Requested items</caption>
                    <thead><tr><th scope="col">Item</th><th scope="col" class="text-end">Quantity</th><th scope="col">Unit</th></tr></thead>
                    <tbody>
                    @foreach (var i in r.Items)
                    {
                        <tr data-search-item><td>@i.ItemName</td><td class="text-end money">@i.Quantity.ToString("0.###")</td><td>@i.Unit</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @* ---------- Criteria ---------- *@
    <section class="card manager-card mb-4">
        <div class="card-header"><h2 class="h5 mb-0">Evaluation criteria</h2></div>
        @if (Model.Criteria.Count == 0) { <p class="empty-state">No criteria recorded.</p> }
        else
        {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <caption class="visually-hidden">Evaluation criteria</caption>
                <thead><tr><th scope="col">Criterion</th><th scope="col">Type</th><th scope="col" class="text-end">Weight</th><th scope="col" class="text-end">Max score</th></tr></thead>
                <tbody>
                @foreach (var c in Model.Criteria)
                {
                    <tr data-search-item><td>@c.Name</td><td>@c.Type</td><td class="text-end">@c.Weight.ToString("0.##")</td><td class="text-end">@c.MaximumScore.ToString("0.##")</td></tr>
                }
                </tbody>
            </table>
        </div>
        }
    </section>
        </div>
    </details>
</div>

<div class="col-xl-4">
    <div class="dp-sticky">
        <section class="card manager-card mb-4">
            <div class="card-header"><h2 class="h5 mb-0">Tender</h2></div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <caption class="visually-hidden">Tender facts</caption>
                    <tbody>
                        <tr><th scope="row">Category</th><td>@Model.CategoryName</td></tr>
                        <tr><th scope="row">Estimated value</th><td class="money">@Model.EstimatedValue.ToString("N2")</td></tr>
                        <tr><th scope="row">Weights</th><td>@Model.TechnicalWeight.ToString("0.##")% / @Model.FinancialWeight.ToString("0.##")%</td></tr>
                        <tr><th scope="row">Bids</th><td>@Model.Bids.Count</td></tr>
                    </tbody>
                </table>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Description)) { <p class="dp-desc pt-3">@Model.Description</p> }
        </section>


    </div>
</div>
</div>
</div>

@if (Model.Bids.Count > 0)
{
    <partial name="_BidAnalysisButton" model="@(new BidAnalysisButtonViewModel { Url = Url.Action("AnalyzeBids", "TopCommittee", new { id = Model.TenderId })!, TenderNumber = Model.TenderNumber })" />
}
