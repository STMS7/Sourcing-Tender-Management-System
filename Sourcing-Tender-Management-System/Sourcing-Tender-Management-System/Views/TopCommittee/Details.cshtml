@model TopCommitteeReviewViewModel
@{
    ViewData["Title"] = Model.TenderNumber;
    var votes = Model.CommitteeVotes;
    var tally = new (string Label, int Count, string Tone)[]
    {
        ("Approved", votes.Count(v => v.Decision == CommitteeDecision.Approved), "ok"),
        ("Rejected", votes.Count(v => v.Decision == CommitteeDecision.Rejected), "bad"),
        ("Asked for details", votes.Count(v => v.Decision == CommitteeDecision.ReturnedForRevision), "info"),
        ("Waiting", votes.Count(v => v.Decision == CommitteeDecision.Pending), "warn")
    };
    var voted = votes.Count(v => v.Decision != CommitteeDecision.Pending);
    string Color(string tone) => tone switch { "ok" => "#3D4A2A", "warn" => "#C9A84C", "bad" => "#B4411E", "info" => "#8C9A55", _ => "#B3B7A2" };
    string Ring()
    {
        var total = tally.Sum(t => t.Count);
        if (total == 0) { return "conic-gradient(#E4DCC8 0 100%)"; }
        double start = 0;
        var stops = new List<string>();
        foreach (var t in tally.Where(t => t.Count > 0))
        {
            var end = start + 100.0 * t.Count / total;
            stops.Add($"{Color(t.Tone)} {start.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}% {end.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%");
            start = end;
        }
        return "conic-gradient(" + string.Join(", ", stops) + ")";
    }
    var recommended = Model.Bids.FirstOrDefault(b => b.IsRecommended);
    var maxWeighted = Math.Max(1m, Model.Bids.Select(b => b.WeightedTotal ?? 0m).DefaultIfEmpty(0m).Max());
    const string svgOpen = "<svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"";
    const string svgClose = "\"></path></svg>";
    const string IconCoin = "M12 3v18M16 7.5c0-1.7-1.8-3-4-3s-4 1.1-4 2.8c0 3.9 8 1.9 8 5.8 0 1.8-1.8 3-4 3s-4-1.3-4-3";
    const string IconBids = "M6 3h9l4 4v14H6zM9 14l2 2 4-4";
    const string IconStar = "M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z";
    const string IconScale = "M12 4v16M8 20h8M5 8h14M5 8l-3 6a3 3 0 006 0zM19 8l-3 6a3 3 0 006 0z";
}
<link rel="stylesheet" href="~/css/committee-statistics.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/committee-details.css" asp-append-version="true" />

<div id="top-details-search-results">
<h1 class="h3 mb-3">Top Committee</h1>
<partial name="_Nav" model="@("")" />

<div class="st td">
    <section class="st-panel td-head" aria-label="Tender">
        <div class="td-head-main">
            <p class="st-kicker">Tender @Model.TenderNumber</p>
            <h2 class="td-title">@Model.Title</h2>
            <p class="td-meta">@Model.CategoryName</p>
            @if (!string.IsNullOrWhiteSpace(Model.Description)) { <p class="td-desc">@Model.Description</p> }
        </div>
        <div class="td-head-side">
            <partial name="_Badge" model="@Model.Status.ToString()" />
            @if (Model.MyVote is not null)
            {
                <a class="btn btn-outline-primary" asp-action="Meeting" asp-route-id="@Model.TenderId">Committee meeting</a>
            }
        </div>
    </section>

    <ul class="st-kpis" aria-label="Tender summary">
        <li data-search-item class="st-kpi is-dark"><span class="st-kpi-icon">@Html.Raw(svgOpen + IconCoin + svgClose)</span><span class="st-kpi-value">@Model.EstimatedValue.ToString("N2")</span><span class="st-kpi-label">Estimated value</span><span class="st-kpi-note">Budget for this tender</span></li>
        <li data-search-item class="st-kpi"><span class="st-kpi-icon">@Html.Raw(svgOpen + IconBids + svgClose)</span><span class="st-kpi-value">@Model.Bids.Count</span><span class="st-kpi-label">Bids compared</span><span class="st-kpi-note">In report round @Model.Report.Round</span></li>
        <li data-search-item class="st-kpi"><span class="st-kpi-icon">@Html.Raw(svgOpen + IconStar + svgClose)</span><span class="st-kpi-value">@(recommended is null ? "-" : recommended.TotalAmount.ToString("N2"))</span><span class="st-kpi-label">@(recommended?.SupplierName ?? "No recommendation")</span><span class="st-kpi-note">Recommended offer@(recommended is null ? "" : " (" + recommended.Currency + ")")</span></li>
        <li data-search-item class="st-kpi"><span class="st-kpi-icon">@Html.Raw(svgOpen + IconScale + svgClose)</span><span class="st-kpi-value">@Model.TechnicalWeight.ToString("0.##")% / @Model.FinancialWeight.ToString("0.##")%</span><span class="st-kpi-label">Technical / Financial</span><span class="st-kpi-note">Evaluation weights</span></li>
    </ul>

    <partial name="_WorkspaceSearch" model="@(new WorkspaceSearchViewModel { Id = "top-details-search", ResultsId = "top-details-search-results", Label = "Search bids, votes, request items and criteria" })" />

    <div class="td-grid">
    <div class="td-main">

@* ---------- Vote ---------- *@
@if (Model.Report.IsAwaitingDecision && Model.MyVote == CommitteeDecision.Pending)
{
    <section class="tc-decision" aria-labelledby="decision-title">
        <div class="tc-decision-head">
            <span class="tc-kicker">Your vote</span>
            <h2 id="decision-title">Your decision</h2>
        </div>
        <div class="tc-decision-body">
            <p class="mb-3">
                The evaluation committee recommends
                <strong>@(recommended?.SupplierName ?? "no supplier")</strong>@(recommended is null ? "" : $" ({recommended.TotalAmount:N2} {recommended.Currency})").
                A justification is required if you reject or ask for more details.
            </p>
            <form asp-action="Vote" method="post">
                <input type="hidden" name="EvaluationReportId" value="@Model.Report.EvaluationReportId" />
                <div class="tc-choices" role="radiogroup" aria-label="Your decision">
                    <div class="tc-choice is-approve">
                        <input type="radio" name="Decision" id="dApprove" value="@((int)CommitteeDecision.Approved)" required>
                        <label for="dApprove"><strong>Approve</strong><span>Award the recommended supplier</span></label>
                    </div>
                    <div class="tc-choice is-reject">
                        <input type="radio" name="Decision" id="dReject" value="@((int)CommitteeDecision.Rejected)">
                        <label for="dReject"><strong>Reject</strong><span>Do not accept the recommendation</span></label>
                    </div>
                    <div class="tc-choice is-return">
                        <input type="radio" name="Decision" id="dReturn" value="@((int)CommitteeDecision.ReturnedForRevision)">
                        <label for="dReturn"><strong>Ask for more details</strong><span>Return the tender to the committee</span></label>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="reason">Justification / notes</label>
                    <textarea class="form-control" id="reason" name="Reason" rows="3" maxlength="2000"></textarea>
                </div>
                <button type="submit" class="btn btn-primary"
                        onclick="return confirm('Your vote cannot be changed after it is recorded. Continue?');">
                    Record my vote
                </button>
            </form>
        </div>
    </section>
}
else if (Model.MyVote is { } mine && mine != CommitteeDecision.Pending)
{
    <div class="alert alert-info">You voted: <partial name="_Badge" model="@mine.ToString()" />. A recorded vote cannot be changed.</div>
}
else if (Model.MyVote is null)
{
    <div class="alert alert-secondary">You are not a voting member on this decision (read-only).</div>
}

    <section class="st-panel" aria-labelledby="td-report">
        <h2 id="td-report">Consolidated evaluation report <span class="td-pill">Round @Model.Report.Round</span></h2>
        <p>@Model.Report.Summary</p>
        @if (!string.IsNullOrWhiteSpace(Model.Report.RecommendationReason))
        {
            <p class="td-reason"><strong>Reason for the recommendation</strong>@Model.Report.RecommendationReason</p>
        }
        <p class="td-by">Prepared by @Model.Report.PreparedBy@if (Model.Report.SubmittedAt is { } submitted) { <text> · submitted @submitted.ToString("yyyy-MM-dd")</text> }</p>
    </section>

    </div>

    <aside class="td-side">
        <section class="st-panel" aria-labelledby="td-votes">
            <h2 id="td-votes">Committee votes</h2>
            <div class="st-donut-row">
                <div class="st-donut" role="img" aria-label="@string.Join(", ", tally.Select(t => t.Label + " " + t.Count))" style="--ring: @Ring()"><span><strong>@voted / @votes.Count</strong>voted</span></div>
                <ul class="st-legend">
                    @foreach (var t in tally)
                    {
                        <li><i data-tone="@t.Tone" aria-hidden="true"></i><span>@t.Label</span><b>@t.Count</b></li>
                    }
                </ul>
            </div>
            <ul class="td-members">
            @foreach (var v in votes)
            {
                <li data-search-item>
                    <div><strong>@(string.IsNullOrWhiteSpace(v.Position) ? "Member" : v.Position)</strong><span>@v.MemberName</span></div>
                    <partial name="_Badge" model="@v.Decision.ToString()" />
                    @if (!string.IsNullOrWhiteSpace(v.Reason)) { <p>@v.Reason</p> }
                    @if (v.DecidedAt is { } when) { <small>@when.ToString("yyyy-MM-dd")</small> }
                </li>
            }
            </ul>
        </section>

        <section class="st-panel" aria-labelledby="td-review">
            <h2 id="td-review">Review before the committee</h2>
            @if (Model.ManagerApprovals.Count == 0)
            {
                <p class="st-empty">No earlier approval steps recorded.</p>
            }
            else
            {
                <ul class="td-members">
                @foreach (var a in Model.ManagerApprovals)
                {
                    <li data-search-item>
                        <div><strong>@a.Level</strong><span>@a.ApproverName</span></div>
                        <partial name="_Badge" model="@a.Status.ToString()" />
                        @if (!string.IsNullOrWhiteSpace(a.Comments)) { <p>@a.Comments</p> }
                        @if (a.DecidedAt is { } when) { <small>@when.ToString("yyyy-MM-dd")</small> }
                    </li>
                }
                </ul>
            }
        </section>

        <section class="st-panel" aria-labelledby="td-criteria">
            <h2 id="td-criteria">Evaluation criteria</h2>
            <ul class="st-bars">
            @foreach (var c in Model.Criteria)
            {
                <li data-search-item><span class="st-bar-label">@c.Name<small class="d-block text-muted">@c.Type</small></span><span class="st-bar-track"><span data-tone="@(c.Type.ToString() == "Financial" ? "warn" : "ok")" style="width: @(c.Weight.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></span></span><b>@c.Weight.ToString("0.##")%</b></li>
            }
            </ul>
        </section>
    </aside>
    </div>

    <div class="td-wide">
    <section class="st-panel st-table-panel" aria-labelledby="td-bids">
        <h2 id="td-bids">Bids compared</h2>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Supplier</th>
                        <th class="text-end">Amount</th>
                        <th class="text-center">Delivery (days)</th>
                        <th class="text-center">Technical</th>
                        <th class="text-center">Financial</th>
                        <th>Weighted score</th>
                        <th>Compliance</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var b in Model.Bids)
                {
                    <tr data-search-item class="@(b.IsRecommended ? "tc-recommended" : "")">
                        <td>
                            <div class="fw-semibold">@b.SupplierName @if (b.IsAwarded) { <span class="badge text-bg-success">Awarded</span> } else if (b.IsRecommended) { <span class="tc-tag">Recommended</span> }</div>
                            <div class="small text-muted">@b.BidNumber | @b.DocumentCount documents</div>
                            @if (!string.IsNullOrWhiteSpace(b.ReportNotes)) { <div class="small">@b.ReportNotes</div> }
                        </td>
                        <td class="text-end">@b.TotalAmount.ToString("N2") @b.Currency</td>
                        <td class="text-center">@b.DeliveryDays</td>
                        <td class="text-center">@b.TechnicalScore?.ToString("0.##")</td>
                        <td class="text-center">@b.FinancialScore?.ToString("0.##")</td>
                        <td class="td-score"><b>@b.WeightedTotal?.ToString("0.##")</b><span class="st-bar-track"><span data-tone="@(b.IsRecommended ? "ok" : "olive")" style="width: @(((b.WeightedTotal ?? 0m) / maxWeighted * 100m).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></span></span></td>
                        <td>@if (b.ComplianceDecision is { } c) { <partial name="_Badge" model="@c.ToString()" /> }</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>

    @if (Model.Request is { } r)
    {
    <section class="st-panel" aria-labelledby="td-request">
        <h2 id="td-request">Original purchase request</h2>
        <p class="td-meta"><strong>@r.RequestNumber - @r.Title</strong><br />@r.DepartmentName | requested by @r.RequestedBy | priority @r.Priority | budget @r.EstimatedBudget.ToString("N2")</p>
        @if (!string.IsNullOrWhiteSpace(r.Description)) { <p>@r.Description</p> }
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead><tr><th>Item</th><th class="text-end">Quantity</th><th>Unit</th></tr></thead>
                <tbody>
                @foreach (var i in r.Items)
                {
                    <tr data-search-item><td>@i.ItemName</td><td class="text-end">@i.Quantity.ToString("0.###")</td><td>@i.Unit</td></tr>
                }
                </tbody>
            </table>
        </div>
    </section>
    }
    </div>

    <a class="btn btn-link ps-0" asp-action="Index">&larr; Back to the dashboard</a>
</div>
</div>

@if (Model.Bids.Count > 0)
{
    <partial name="_BidAnalysisButton" model="@(new BidAnalysisButtonViewModel { Url = Url.Action("AnalyzeBids", "TopCommittee", new { id = Model.TenderId })!, TenderNumber = Model.TenderNumber })" />
}
