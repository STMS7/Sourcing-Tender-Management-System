@using System.Security.Claims
@using Sourcing_Tender_Management_System.Models.Reports
@using Sourcing_Tender_Management_System.Services.Reports
@{
    ViewData["Title"] = "AI Intelligence";
    // A card is drawn only when the user's role may read its data (the same rule the server enforces).
    var roles = User.FindAll(ClaimTypes.Role).Select(c => c.Value).ToList();
    var canTenders = ReportAccess.CanOpen(ReportKind.Tenders, roles);
    var canBids = ReportAccess.CanOpen(ReportKind.Bids, roles);
    // Example questions for the empty chat, only for data this role may open. Unfinished ones are left in the box to complete.
    var examples = new List<(string Label, string Question, bool Finished)>();
    if (canTenders) examples.Add(("Tenders by status", "Tenders by status", true));
    if (canBids) examples.Add(("Bids for a tender", "Show the bids of ", false));
    if (ReportAccess.CanOpen(ReportKind.Suppliers, roles)) examples.Add(("Report about a supplier", "Report about ", false));
    if (!canTenders && ReportAccess.CanOpen(ReportKind.Requests, roles)) examples.Add(("List the requests", "List the requests", true));
    examples.Add(("My clarifications", "Show my clarifications", true));
    examples.Add(("What can I ask?", "What can I ask?", true));
}

<h1 class="h3 mb-1">AI Intelligence</h1>
<p class="text-muted">Built from live system data.@(canBids ? " Pick a tender for its own report, or upload a file to preview it." : " Ask a question, or upload a file to preview it.")</p>

@if (canTenders)
{
<div class="row g-3 mb-3">
    <div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body">
        <div class="text-muted">Total tenders</div><div class="h2 mb-0" id="kpiTotal">-</div></div></div></div>
    <div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body">
        <div class="text-muted">Awarded</div><div class="h2 mb-0" id="kpiAwarded">-</div></div></div></div>
    <div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body">
        <div class="text-muted">Open</div><div class="h2 mb-0" id="kpiOpen">-</div></div></div></div>
    <div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body">
        <div class="text-muted">Days from creation to winner notice</div><div class="h2 mb-0" id="kpiDuration">-</div></div></div></div>
</div>
}

@if (canTenders || canBids)
{
<div class="row g-3 mb-3">
    @if (canTenders)
    {
    <div class="@(canBids ? "col-xl-5" : "col-12")">
        <div class="card h-100"><div class="card-body">
            <h2 class="h5">Tenders by status</h2>
            <div style="position:relative;height:280px"><canvas id="statusChart"></canvas></div>
            <p id="statusEmpty" class="text-muted mb-0" hidden>No tenders to show yet.</p>
        </div></div>
    </div>
    }
    @if (canBids)
    {
    <div class="@(canTenders ? "col-xl-7" : "col-12")">
        <div class="card h-100"><div class="card-body">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                <h2 class="h5 mb-0 me-auto">Tender report</h2>
                <a id="exportBtn" class="btn btn-outline-secondary btn-sm disabled" aria-disabled="true">Excel</a>
                <a id="pdfBtn" class="btn btn-outline-secondary btn-sm disabled" aria-disabled="true">PDF</a>
            </div>
            <label class="visually-hidden" for="tenderPicker">Tender</label>
            <select id="tenderPicker" class="form-select mb-3"></select>
            <div style="position:relative;height:280px"><canvas id="bidChart"></canvas></div>
            <p id="bidEmpty" class="text-muted mb-0" hidden>No submitted bids for this tender.</p>
        </div></div>
    </div>
    }
</div>
}

<style>
    .ai-log { height: 360px; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; padding: 4px; }
    .ai-msg { max-width: 85%; padding: 10px 14px; border-radius: 16px; }
    .ai-msg.user { align-self: flex-end; background: var(--zt-ink); color: var(--zt-card); }
    .ai-msg.bot { align-self: flex-start; background: var(--zt-sage-soft); }
    .ai-cards { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
    .ai-cards div { background: var(--zt-card); border: 1px solid var(--zt-line); border-radius: 12px; padding: 6px 12px; }
    .ai-avatar { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--zt-ink); color: var(--zt-lime, #DCEB4B); }
    .ai-avatar svg { width: 55%; height: 55%; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .ai-welcome { display: flex; flex-direction: column; align-items: center; gap: 12px; margin: auto 0; text-align: center; }
    .ai-welcome .ai-avatar { width: 60px; height: 60px; }
    .ai-hello { font-size: 19px; font-weight: 700; }
    .ai-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; max-width: 520px; }
    .ai-chip { padding: 6px 14px; border: 1px solid var(--zt-line); border-radius: 999px; background: var(--zt-card); color: var(--zt-ink); font-size: 14px; }
    .ai-chip:hover { background: var(--zt-lime, #DCEB4B); }
    .ai-composer { display: flex; align-items: center; gap: 8px; padding: 5px 5px 5px 18px; border: 1px solid var(--zt-line); border-radius: 999px; }
    .ai-composer:focus-within, .ai-chip:focus-visible { outline: 2px solid var(--zt-ink); outline-offset: 1px; }
    .ai-composer input[name="question"] { flex: 1 1 auto; min-width: 0; border: 0; outline: 0; background: transparent; color: var(--zt-ink); box-shadow: none; }
    .ai-send { border: 0; padding: 0; width: 38px; height: 38px; cursor: pointer; }
    .ai-send:disabled { opacity: .45; cursor: default; }
</style>

<div class="card mb-3"><div class="card-body">
    <div class="d-flex align-items-center gap-3 mb-3">
        <span class="ai-avatar" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8zM19 16v4M17 18h4" /></svg></span>
        <div>
            <h2 class="h5 mb-0">Ask the data</h2>
            <div class="text-muted small">Answers come from live system data. The AI only comments and never decides or acts.</div>
        </div>
    </div>
    <div id="chatLog" class="ai-log" aria-live="polite">
        <div id="chatWelcome" class="ai-welcome">
            <span class="ai-avatar" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8zM19 16v4M17 18h4" /></svg></span>
            <div class="ai-hello">How can I help?</div>
            <div class="ai-chips">
                @foreach (var x in examples)
                {
                    <button type="button" class="ai-chip" data-q="@x.Question" data-finished="@(x.Finished ? "1" : "")">@x.Label</button>
                }
            </div>
        </div>
    </div>
    <form id="chatForm" class="ai-composer mt-3">
        @Html.AntiForgeryToken()
        <input id="chatInput" name="question" maxlength="500" autocomplete="off"
               placeholder="Type a question" aria-label="Question" required />
        <button id="chatSend" class="ai-avatar ai-send" type="submit" aria-label="Send question">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6" /></svg>
        </button>
    </form>
</div></div>

<div class="card mb-3"><div class="card-body">
    <h2 class="h5">Preview a file</h2>
    <p class="text-muted">Excel (.xlsx) or PDF, up to 5 MB. The file is read in memory and not stored.</p>
    <form id="uploadForm" class="d-flex flex-wrap gap-2">
        @Html.AntiForgeryToken()
        <input id="uploadFile" type="file" name="file" accept=".xlsx,.pdf" class="form-control" style="flex:1 1 260px" aria-label="Excel or PDF file" required />
        <button class="btn btn-primary" type="submit">Preview</button>
    </form>
    <div id="uploadResult" class="mt-3" aria-live="polite"></div>
</div></div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        const ink = getComputedStyle(document.querySelector('.zt-app') ?? document.body).getPropertyValue('--zt-ink').trim() || '#17402A';
        const byId = id => document.getElementById(id);
        const getJson = url => fetch(url).then(r => { if (!r.ok) throw new Error(r.status); return r.json(); });

        function bar(canvas, labels, values, label) {
            return new Chart(typeof canvas === 'string' ? byId(canvas) : canvas, {
                type: 'bar',
                data: { labels, datasets: [{ label, data: values, backgroundColor: ink, borderRadius: 6 }] },
                options: {
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                }
            });
        }

        // These cards exist only for roles that may read tender data, so each block checks its card first.
        if (byId('kpiTotal')) {
            getJson('/AiIntelligence/TenderStats').then(d => {
                byId('kpiTotal').textContent = d.total;
                byId('kpiAwarded').textContent = d.awarded;
                byId('kpiOpen').textContent = d.open;
            });
            getJson('/AiIntelligence/DurationKpi').then(d => byId('kpiDuration').textContent = d.averageDays);
        }

        if (byId('statusChart')) {
            getJson('/AiIntelligence/TendersByStatus').then(rows => {
                byId('statusEmpty').hidden = rows.length > 0;
                if (rows.length) bar('statusChart', rows.map(r => r.status), rows.map(r => r.count), 'Tenders');
            });
        }

        if (byId('tenderPicker')) {
            let bidChart;
            const picker = byId('tenderPicker');

            const setDownload = (btn, url) => {
                btn.href = url;
                btn.classList.remove('disabled');
                btn.removeAttribute('aria-disabled');
            };

            const loadBids = id => {
                setDownload(byId('exportBtn'), '/AiIntelligence/ExportBids?tenderId=' + id);
                setDownload(byId('pdfBtn'), '/AiIntelligence/ExportBidsPdf?tenderId=' + id);
                getJson('/AiIntelligence/TenderBids?tenderId=' + id).then(rows => {
                    bidChart?.destroy();
                    byId('bidEmpty').hidden = rows.length > 0;
                    bidChart = rows.length ? bar('bidChart', rows.map(r => r.supplier), rows.map(r => r.amount), 'Bid amount') : null;
                });
            };

            getJson('/AiIntelligence/TenderOptions').then(opts => {
                // new Option sets text, not HTML, so a tender title can never inject markup.
                picker.replaceChildren(...opts.map(o => new Option(o.label, o.id)));
                if (opts.length) loadBids(opts[0].id);
            });
            picker.addEventListener('change', () => loadBids(picker.value));
        }

        function showTable(d) {
            const wrap = document.createElement('div');
            wrap.className = 'table-responsive';
            const table = document.createElement('table');
            table.className = 'table table-sm';
            [d.headers, ...d.rows].forEach((row, i) => {
                const tr = table.insertRow();
                row.forEach(v => { const c = tr.insertCell(); c.textContent = v; if (i === 0) c.className = 'fw-bold'; });
            });
            wrap.append(table);
            const note = document.createElement('p');
            note.className = 'text-muted mb-0';
            note.textContent = `Showing ${d.rows.length} of ${d.totalRows} rows`;
            return [wrap, note];
        }

        function showText(d) {
            const note = document.createElement('p');
            note.className = 'text-muted';
            note.textContent = `${d.pages} pages, ${d.characters} characters`;
            const pre = document.createElement('pre');
            pre.style.whiteSpace = 'pre-wrap';
            pre.textContent = d.preview;
            return [note, pre];
        }

        byId('uploadForm').addEventListener('submit', async e => {
            e.preventDefault();
            const out = byId('uploadResult');
            const isPdf = byId('uploadFile').files[0]?.name.toLowerCase().endsWith('.pdf');
            const res = await fetch(isPdf ? '/AiIntelligence/UploadPdf' : '/AiIntelligence/UploadExcel',
                { method: 'POST', body: new FormData(e.target) });
            if (!res.ok) {
                const msg = document.createElement('p');
                msg.className = 'text-danger mb-0';
                msg.setAttribute('role', 'alert');
                msg.textContent = await res.text();
                out.replaceChildren(msg);
                return;
            }
            const d = await res.json();
            out.replaceChildren(...(isPdf ? showText(d) : showTable(d)));
        });

        const log = byId('chatLog');
        let chatContext = '';

        function bubble(kind) {
            const m = document.createElement('div');
            m.className = 'ai-msg ' + kind;
            log.append(m);
            log.scrollTop = log.scrollHeight;
            return m;
        }

        function el(tag, text, cls) {
            const e = document.createElement(tag);
            e.textContent = text;
            if (cls) e.className = cls;
            return e;
        }

        function renderReply(m, r) {
            const parts = [el('strong', r.title)];
            if (r.summary) parts.push(el('p', r.summary, 'mb-1 mt-1'));
            if (r.text) parts.push(el('p', r.text, 'mb-0'));
            if (r.suggestion) {
                const yes = el('button', `Yes: ${r.suggestion}`, 'ai-chip mt-2');
                yes.type = 'button';
                yes.addEventListener('click', () => {
                    if (byId('chatSend').disabled) return;
                    byId('chatInput').value = r.suggestion;
                    byId('chatForm').requestSubmit();
                });
                parts.push(yes);
            }
            if (r.cards) {
                const box = el('div', '', 'ai-cards');
                r.cards.forEach(c => box.append(el('div', `${c.label}: ${c.value}`)));
                parts.push(box);
            }
            if (r.type === 'table') parts.push(...showTable({ headers: r.headers, rows: r.rows, totalRows: r.rows.length }));
            if (r.link) {
                const open = el('a', 'Open full report', 'btn btn-outline-secondary btn-sm mt-2');
                open.href = r.link;
                parts.push(open);
            }
            if (r.notes?.length) {
                const ul = el('ul', '', 'mt-2 mb-0 ps-3');
                r.notes.forEach(n => ul.append(el('li', n)));
                parts.push(ul);
            }
            if (r.tenderId) {
                // Same secured export endpoints as the report card: one data method, many outputs.
                const dl = el('div', '', 'd-flex gap-2 mt-2');
                [['Excel', 'ExportBids'], ['PDF', 'ExportBidsPdf']].forEach(([label, action]) => {
                    const a = el('a', label, 'btn btn-outline-secondary btn-sm');
                    a.href = `/AiIntelligence/${action}?tenderId=${r.tenderId}`;
                    dl.append(a);
                });
                parts.push(dl);
            }
            let canvas;
            if (r.type === 'chart') {
                m.style.width = '85%';
                const box = el('div', '');
                box.style.cssText = 'position:relative;height:220px';
                canvas = document.createElement('canvas');
                box.append(canvas);
                parts.push(box);
            }
            m.replaceChildren(...parts);
            if (canvas) bar(canvas, r.labels, r.values, r.title);   // draw only after it is in the page
        }

        log.querySelectorAll('.ai-chip').forEach(chip => chip.addEventListener('click', () => {
            const input = byId('chatInput');
            if (byId('chatSend').disabled) return;
            input.value = chip.dataset.q;
            if (chip.dataset.finished) byId('chatForm').requestSubmit();
            else input.focus();
        }));

        byId('chatForm').addEventListener('submit', async e => {
            e.preventDefault();
            const input = byId('chatInput'), send = byId('chatSend');
            const q = input.value.trim();
            if (!q) return;
            byId('chatWelcome')?.remove();
            const fd = new FormData(e.target);          // read before clearing the box
            fd.set('context', chatContext);
            bubble('user').textContent = q;
            input.value = '';
            send.disabled = true;
            const m = bubble('bot');
            m.textContent = 'Thinking...';
            try {
                const res = await fetch('/AiIntelligence/Ask', { method: 'POST', body: fd });
                if (res.ok) {
                    const reply = await res.json();
                    chatContext = reply.context ?? chatContext;   // lets "and the lowest one?" refer back
                    renderReply(m, reply);
                }
                else { m.textContent = (await res.text()) || 'Something went wrong. Please try again.'; m.classList.add('text-danger'); }
            } catch {
                m.textContent = 'Could not reach the server.';
                m.classList.add('text-danger');
            }
            send.disabled = false;
            input.focus();
            log.scrollTop = log.scrollHeight;
        });
    </script>
}
