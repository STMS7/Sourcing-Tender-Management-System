@model Sourcing_Tender_Management_System.Models.ProcurementRequest
@using Sourcing_Tender_Management_System.Models
@{ var rows = Model.Items.ToList(); }
@if (ViewData.ModelState.ErrorCount > 0)
{
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
}
<input type="hidden" asp-for="Id" />
<section class="department-form-section"><div class="department-section-heading"><div><span class="department-eyebrow">Step 1</span><h2>Request information</h2></div></div>
<div class="row g-3"><div class="col-md-7"><label asp-for="Title" class="form-label">Title</label><input asp-for="Title" class="form-control" maxlength="200" required /><span asp-validation-for="Title" class="text-danger"></span><label asp-for="Description" class="form-label mt-3">Description / reason</label><textarea asp-for="Description" class="form-control" maxlength="2000" rows="5" required></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
<div class="col-md-5"><label asp-for="Priority" class="form-label">Priority</label><select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<RequestPriority>()"></select><label asp-for="RequiredByDate" class="form-label mt-3">Required by</label><input asp-for="RequiredByDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" required /><span asp-validation-for="RequiredByDate" class="text-danger"></span></div></div></section>
<section class="department-form-section"><div class="department-section-heading"><div><span class="department-eyebrow">Step 2</span><h2>Request Items (at least one)</h2><p>Add at least one item with its quantity and estimated price.</p></div><button type="button" id="addItem" class="btn btn-outline-primary department-add-item">Add another item</button></div>
<div class="table-responsive"><table class="table department-table" id="itemsTable">
<thead><tr><th>Item name</th><th>Specifications</th><th>Quantity</th><th>Unit</th><th>Estimated unit price</th></tr></thead>
<tbody>
@for (int i = 0; i < Model.Items.Count; i++)
{
    <tr>
        <td><input type="hidden" name="Items[@i].CategoryId" value="@rows[i].CategoryId" /><input name="Items[@i].ItemName" value="@rows[i].ItemName" class="form-control" maxlength="250" /></td>
        <td><input name="Items[@i].Specifications" value="@rows[i].Specifications" class="form-control" maxlength="2000" /></td>
        <td><input name="Items[@i].Quantity" value="@rows[i].Quantity" type="number" step="0.001" min="0" class="form-control" /></td>
        <td><input name="Items[@i].Unit" value="@rows[i].Unit" class="form-control" maxlength="30" /></td>
        <td><input name="Items[@i].EstimatedUnitPrice" value="@rows[i].EstimatedUnitPrice" type="number" step="0.01" min="0" class="form-control" /></td>
    </tr>
}
</tbody>
</table></div></section>
<div class="department-form-actions"><a class="btn btn-light" asp-action="Index">Cancel</a><button type="submit" class="btn btn-primary">Save Draft</button></div>
<template id="itemTemplate">
<tr>
<td><input name="Items[__INDEX__].ItemName" class="form-control" maxlength="250" /></td>
<td><input name="Items[__INDEX__].Specifications" class="form-control" maxlength="2000" /></td>
<td><input name="Items[__INDEX__].Quantity" type="number" step="0.001" min="0" class="form-control" value="0" /></td>
<td><input name="Items[__INDEX__].Unit" class="form-control" maxlength="30" /></td>
<td><input name="Items[__INDEX__].EstimatedUnitPrice" type="number" step="0.01" min="0" class="form-control" value="0" /></td>
</tr>
</template>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const add = document.getElementById('addItem');
    if (!add) return;
    add.addEventListener('click', function () {
        const body = document.querySelector('#itemsTable tbody');
        const count = body.querySelectorAll('tr').length;
        if (count >= 30) return;
        body.insertAdjacentHTML('beforeend', document.getElementById('itemTemplate').innerHTML.replaceAll('__INDEX__', count));
    });
});
</script>
