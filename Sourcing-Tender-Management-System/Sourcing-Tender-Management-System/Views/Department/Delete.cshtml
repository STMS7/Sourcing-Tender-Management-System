@model Sourcing_Tender_Management_System.Models.ProcurementRequest
@{ ViewData["Title"] = "Delete Draft"; }
<div class="department-workspace"><section class="department-danger-panel"><span class="department-eyebrow">Draft request</span><h1>Delete @Model.RequestNumber?</h1><p><strong>@Model.Title</strong></p><p>Only a draft without related process records can be deleted. This action cannot be undone.</p><form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="department-page-actions"><a class="btn btn-light" asp-action="Index">Cancel</a><button type="submit" class="btn btn-danger">Delete draft</button></form></section></div>
