@model IEnumerable<Sourcing_Tender_Management_System.Models.ProcurementRequest>
@using Sourcing_Tender_Management_System.Models
@{
    ViewData["Title"] = "Department Dashboard";
}
<h2>Department Dashboard</h2>
<p><a asp-action="Index">My Requests</a> | <a asp-action="Create">Create Request</a> | <a asp-controller="CycleChat" asp-action="Index">Clarifications</a></p>
<table class="table table-bordered">
<tr><th>Total</th><td>@ViewBag.Total</td><th>Draft</th><td>@ViewBag.Draft</td></tr>
<tr><th>Submitted</th><td>@ViewBag.Submitted</td><th>Under Review</th><td>@ViewBag.UnderReview</td></tr>
<tr><th>Returned</th><td>@ViewBag.Returned</td><th>Rejected</th><td>@ViewBag.Rejected</td></tr>
<tr><th>Approved</th><td>@ViewBag.Approved</td><th>Converted</th><td>@ViewBag.Converted</td></tr>
</table>
<h3>Recent requests</h3>
<ul>
@foreach (var r in Model)
{
    <li><a asp-action="Details" asp-route-id="@r.Id">@r.RequestNumber – @r.Title</a> (@r.Status)</li>
}
</ul>
<h3>My latest notifications</h3>
<ul>
@foreach (var n in ((IEnumerable<Notification>)ViewBag.Notifications))
{
    <li>@n.CreatedAt.ToLocalTime(): @n.Title – @n.Message</li>
}
</ul>
