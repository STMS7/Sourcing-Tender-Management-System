@model Sourcing_Tender_Management_System.Models.ProcurementRequest
@using Sourcing_Tender_Management_System.Models
@{
    ViewData["Title"] = "Request Details";

    var editable = Model.Status == ProcurementRequestStatus.Draft || Model.Status == ProcurementRequestStatus.Returned;
    var canAsk = Model.Status == ProcurementRequestStatus.Submitted || Model.Status == ProcurementRequestStatus.UnderReview || Model.Status == ProcurementRequestStatus.Returned || Model.Status == ProcurementRequestStatus.Approved ||
        (Model.Status == ProcurementRequestStatus.ConvertedToTender && Model.Tenders.Any(t => t.Status is TenderStatus.Draft or TenderStatus.Published or TenderStatus.Closed or TenderStatus.UnderEvaluation));
    var reviews = Model.Reviews.OrderByDescending(r => r.ReviewedAt).ToList();
}
<div id="department-details-search-results" class="manager-page ec-page dp-page">
<div class="dp-head">
    <div class="manager-page-heading">
        <a asp-action="Index" class="dp-crumb"><span aria-hidden="true">←</span> My requests</a>
        <h1 class="manager-title mb-1">@Model.Title</h1>
        <div class="d-flex flex-wrap align-items-center gap-2"><partial name="_RequestStatus" model="Model.Status" /><span class="dp-num" title="@Model.RequestNumber">@Model.RequestNumber</span></div>
    </div>
</div>

@if (Model.Tenders.Any())
{
    foreach (var t in Model.Tenders)
    {
        @await Component.InvokeAsync("TenderJourney", new { tenderId = t.Id })
    }
}
else
{
    var (who, what, mine, done) = Model.Status switch
    {
        ProcurementRequestStatus.Draft => ("You", "Check the details, then click “Submit for review”.", true, false),
        ProcurementRequestStatus.Returned => ("You", "Read the review notes, edit the request, then resubmit it.", true, false),
        ProcurementRequestStatus.Rejected => ("Done", "The sourcing officer rejected this request. See the review notes.", false, true),
        ProcurementRequestStatus.Approved => ("Sourcing officer", "The request is approved and will become a tender.", false, false),
        _ => ("Sourcing officer", "The sourcing officer is reviewing your request.", false, false)
    };
    <link rel="stylesheet" href="~/css/tender-journey.css" asp-append-version="true" />
    <section class="tj @(mine ? "tj-mine" : null)" aria-label="Request progress">
        <div class="tj-now mb-0">
            <span class="tj-tag">@(done ? "Finished" : mine ? "Your turn" : "Waiting on")</span>
            <div><strong>@who</strong><span>@what</span></div>
        </div>
    </section>

}
@if (Model.Status == ProcurementRequestStatus.Returned)
{

    <div class="alert alert-warning" role="status">The sourcing officer returned this request. Read the review notes, edit it, then resubmit.</div>
}

<div class="row g-4">
    <div class="col-xl-8">
        <section class="card manager-card mb-4">
            <div class="card-header"><h2 class="h5 mb-0">Overview</h2></div>
            <dl class="dp-facts">
                <div><dt>Priority</dt><dd>@Model.Priority</dd></div>
                <div><dt>Required by</dt><dd>@(Model.RequiredByDate?.ToString("dd MMM yyyy") ?? "—")</dd></div>
                <div><dt>Estimated budget</dt><dd class="money">@Model.EstimatedBudget.ToString("N2")</dd></div>
                <div><dt>Items</dt><dd>@Model.Items.Count</dd></div>
            </dl>
            <h3 class="manager-label px-4 pt-3 mb-0">Description / reason</h3>
            <p class="dp-desc">@Model.Description</p>
        </section>

        <section class="manager-search-panel mb-4" aria-label="Search this request">
            <partial name="_WorkspaceSearch" model="@(new WorkspaceSearchViewModel { Id = "department-details-search", ResultsId = "department-details-search-results", Label = "Search request items and review notes", Placeholder = "Item, specification or note" })" />
        </section>

        <section class="card manager-card mb-4">
            <div class="card-header dp-split"><h2 class="h5 mb-0">Items</h2><span class="badge">@Model.Items.Count</span></div>
            <div class="table-responsive"><table class="table table-hover align-middle mb-0"><caption class="visually-hidden">Requested items</caption>
            <thead><tr><th scope="col">Item</th><th scope="col">Specifications</th><th scope="col" class="text-end">Quantity</th><th scope="col" class="text-end">Unit price</th><th scope="col" class="text-end">Line total</th></tr></thead>
            <tbody>
            @foreach (var i in Model.Items)
            {
                <tr data-search-item><td class="fw-semibold">@i.ItemName</td><td class="preserve-lines">@(string.IsNullOrWhiteSpace(i.Specifications) ? "—" : i.Specifications)</td><td class="text-end money">@i.Quantity.ToString("0.###")</td><td class="text-end money">@i.EstimatedUnitPrice.ToString("N2")</td><td class="text-end money">@((i.Quantity * i.EstimatedUnitPrice).ToString("N2"))</td></tr>
            }
            <tr class="dp-total"><td colspan="5" class="text-end">Estimated total</td><td class="text-end money">@Model.EstimatedBudget.ToString("N2")</td></tr>
            </tbody></table></div>
        </section>

        <section class="card manager-card mb-4">
            <div class="card-header"><h2 class="h5 mb-0">Review notes from Sourcing Officer</h2></div>
            @if (reviews.Count == 0)
            {
                <p class="empty-state">No review notes yet.</p>
            }
            else
            {
                <ol class="dp-timeline">
                @foreach (var r in reviews)
                {
                    <li data-search-item>
                        <span class="badge">@r.Decision</span>
                        <span class="dp-meta d-inline ms-2">@r.ReviewedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm") · @(r.ReviewerUser?.FullName ?? "Sourcing officer")</span>
                        <p>@r.Reason</p>
                    </li>
                }
                </ol>
            }
        </section>
    </div>

    <div class="col-xl-4">
        <div class="dp-sticky">
            <section class="card manager-card mb-4">
                <div class="card-header"><h2 class="h5 mb-0">Actions</h2></div>
                <div class="dp-side-actions">
                    @if (editable)
                    {
                        <form asp-action="Submit" asp-route-id="@Model.Id" method="post"><button type="submit" class="btn btn-primary">@(Model.Status == ProcurementRequestStatus.Returned ? "Resubmit request" : "Submit for review")</button></form>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit request</a>
                    }
                    @if (Model.Status == ProcurementRequestStatus.Draft)
                    {
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Delete draft</a>
                    }
                    @if (canAsk)
                    {
                        <a asp-controller="CycleChat" asp-action="New" asp-route-procurementRequestId="@Model.Id" class="btn btn-outline-primary">Ask for clarification</a>
                    }
                    <a asp-controller="CycleChat" asp-action="Index" class="btn btn-outline-secondary">Messages and clarifications</a>
                    @if (!editable && !canAsk)
                    {
                        <p>This request is @Model.Status.ToString().ToLowerInvariant() and can no longer be changed.</p>
                    }
                </div>
            </section>

            <section class="card manager-card mb-4">
                <div class="card-header dp-split"><h2 class="h5 mb-0">Related tenders</h2><span class="badge">@Model.Tenders.Count</span></div>
                @if (!Model.Tenders.Any())
                {
                    <p class="empty-state">No tender has been created from this request yet.</p>
                }
                else
                {
                    <ul class="dp-feed">
                    @foreach (var t in Model.Tenders)
                    {
                        <li data-search-item><span class="dp-feed-title">@t.TenderNumber</span><span class="dp-meta">@t.Status</span></li>
                    }
                    </ul>
                }
            </section>
        </div>
    </div>

</div>
</div>
