@model IEnumerable<Sourcing_Tender_Management_System.Models.ProcurementRequest>
@using Sourcing_Tender_Management_System.Models
@{
    ViewData["Title"] = "All Requests";
}
<div class="department-workspace">
<header class="department-page-header"><div><span class="department-eyebrow">Department workspace</span><h1>All Requests</h1><p>View, search, and track all purchase requests in your department.</p></div></header>
<form method="get" asp-action="Index" class="department-search-panel zt-search-toolbar" role="search"
      data-live-search data-search-response="document" data-results="department-request-results" data-search-status="department-request-status">
    <label for="department-request-query" class="form-label">Request title or number</label>
    <div class="zt-search-line"><div class="zt-search-shell"><input id="department-request-query" type="search" name="search" value="@ViewBag.Search" class="form-control zt-search-input" placeholder="Search title / number" dir="auto" data-search-input /><partial name="_SearchVoiceTools" /></div><button type="submit" class="btn btn-primary">Search</button><button type="button" class="btn btn-outline-secondary" data-search-reset>Clear</button></div>
    <div class="mt-3" style="max-width:360px"><label for="department-request-filter" class="form-label">Request status</label><select id="department-request-filter" name="status" class="form-select">
        <option value="">All statuses</option>
        @foreach (var status in Enum.GetValues<ProcurementRequestStatus>())
        {
            <option value="@status" selected="@(Convert.ToString(ViewBag.Status) == status.ToString())">@status</option>
        }
    </select></div>
</form>
<p id="department-request-status" role="status" class="small text-secondary"></p>
<div id="department-request-results" aria-busy="false">
<div class="department-panel department-list-panel"><div class="table-responsive"><table class="table department-table">
    <thead><tr><th>Number</th><th>Title</th><th>Priority</th><th>Required</th><th>Budget</th><th>Status</th><th>Actions</th></tr></thead>
    <tbody>
    @foreach (var r in Model)
    {
        <tr data-search-item>
            <td>@r.RequestNumber</td><td>@r.Title</td><td><span class="department-priority">@r.Priority</span></td>
            <td>@r.RequiredByDate?.ToString("yyyy-MM-dd")</td><td>@r.EstimatedBudget</td>
            <td>@r.Status</td>
            <td>
                <div class="department-table-actions"><a class="btn btn-sm btn-outline-primary department-action-details" asp-action="Details" asp-route-id="@r.Id">Details</a>
                @if (r.Status == ProcurementRequestStatus.Draft || r.Status == ProcurementRequestStatus.Returned)
                {
                    <a class="btn btn-sm btn-outline-secondary department-action-edit" asp-action="Edit" asp-route-id="@r.Id">Edit</a>
                    <form asp-action="Submit" asp-route-id="@r.Id" method="post">
                        <button type="submit" class="btn btn-sm btn-primary department-action-submit">Submit</button>
                    </form>
                }
                @if (r.Status == ProcurementRequestStatus.Draft)
                {
                    <a class="btn btn-sm btn-link text-danger department-action-delete" asp-action="Delete" asp-route-id="@r.Id">Delete</a>
                }
                </div></td>
        </tr>
    }
    </tbody>
</table></div>@if (!Model.Any()) { <div class="department-empty-state">No purchase requests found. <a asp-action="Create">Create your first request.</a></div> }</div>
</div>
