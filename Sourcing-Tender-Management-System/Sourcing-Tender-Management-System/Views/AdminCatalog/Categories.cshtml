@model IReadOnlyList<Sourcing_Tender_Management_System.Models.Category>
@{
    ViewData["Title"] = "Categories";
    var currentPage = ViewBag.CurrentPage is int page ? page : 1;
    var totalPages = ViewBag.TotalPages is int pages ? pages : 1;
    var totalCount = ViewBag.TotalCount is int count ? count : Model.Count;
    const int pageSize = 4;
    var firstResult = totalCount == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    var lastResult = Math.Min(currentPage * pageSize, totalCount);
}

<div class="py-4">
    <a class="btn btn-sm btn-outline-primary mb-3" asp-controller="Admin" asp-action="Users">← Back to users</a>
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
        <div>
            <h1 class="mb-1">Categories</h1>
            <p class="text-secondary mb-0">Manage the categories used to match requests, tenders and suppliers.</p>
        </div>
        <button class="btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#add-category-modal">Add category</button>
    </div>
    @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
    @if (TempData["Message"] is string message) { <div class="alert alert-success">@message</div> }

    <div class="modal fade" id="add-category-modal" tabindex="-1" aria-labelledby="add-category-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <div><h2 class="modal-title h4 mb-1" id="add-category-title">Add category</h2><p class="small text-secondary mb-0">Create a category for requests, tenders and suppliers.</p></div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="SaveCategory" method="post">
                    <div class="modal-body">
                        @Html.AntiForgeryToken()<input type="hidden" name="id" value="0" />
                        <div class="mb-3"><label class="form-label" for="new-category-name">Name</label><input id="new-category-name" name="name" class="form-control" required maxlength="150" autofocus /></div>
                        <div class="mb-3"><label class="form-label" for="new-category-description">Description</label><textarea id="new-category-description" name="description" class="form-control" rows="3" maxlength="500"></textarea></div>
                    </div>
                    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" type="submit">Add category</button></div>
                </form>
            </div>
        </div>
    </div>

    <partial name="_WorkspaceSearch" model="@(new WorkspaceSearchViewModel { Id = "category-search", ResultsId = "category-results", Label = "Search categories", Placeholder = "Search name or description", Action = Url.Action("Categories", "AdminCatalog"), SearchValue = ViewBag.Search, Local = false })" />

    <div id="category-results" aria-busy="false">
    <span hidden data-result-count="@totalCount"></span>
    <div class="d-flex justify-content-between px-1 mb-2 small text-secondary"><span>Showing @firstResult–@lastResult of @totalCount categories</span><span>Page @currentPage of @totalPages</span></div>
    <div class="table-responsive shadow-sm rounded-4 zt-admin-table">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Name</th><th>Description</th><th class="text-end">Action</th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.Name</strong></td>
                    <td class="text-secondary">@(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)</td>
                    <td class="text-end"><button class="btn btn-sm btn-outline-primary" type="button" data-edit-category data-id="@item.Id" data-name="@item.Name" data-description="@item.Description">Edit</button></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (Model.Count == 0) { <div class="alert alert-light border mt-3">No categories found.</div> }

    @if (totalPages > 1)
    {
        <nav class="mt-4" aria-label="Category pages"><ul class="pagination justify-content-center flex-wrap">
            <li class="page-item @(currentPage == 1 ? "disabled" : null)"><a class="page-link" asp-action="Categories" asp-route-search="@ViewBag.Search" asp-route-page="@(currentPage - 1)">Previous</a></li>
            @for (var number = 1; number <= totalPages; number++) { <li class="page-item @(number == currentPage ? "active" : null)"><a class="page-link" asp-action="Categories" asp-route-search="@ViewBag.Search" asp-route-page="@number">@number</a></li> }
            <li class="page-item @(currentPage == totalPages ? "disabled" : null)"><a class="page-link" asp-action="Categories" asp-route-search="@ViewBag.Search" asp-route-page="@(currentPage + 1)">Next</a></li>
        </ul></nav>
    }
    </div>

    <div class="modal fade" id="edit-category-modal" tabindex="-1" aria-labelledby="edit-category-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header"><div><h2 class="modal-title h4 mb-1" id="edit-category-title">Edit category</h2><p class="small text-secondary mb-0">Update the category name and description.</p></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                <form asp-action="SaveCategory" method="post">
                    <div class="modal-body">
                        @Html.AntiForgeryToken()<input type="hidden" name="id" data-edit-category-id />
                        <div class="mb-3"><label class="form-label" for="edit-category-name">Name</label><input id="edit-category-name" name="name" class="form-control" required maxlength="150" data-edit-category-name /></div>
                        <div class="mb-3"><label class="form-label" for="edit-category-description">Description</label><textarea id="edit-category-description" name="description" class="form-control" rows="3" maxlength="500" data-edit-category-description></textarea></div>
                    </div>
                    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" type="submit">Save changes</button></div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        var modalElement = document.getElementById('edit-category-modal');
        if (!modalElement) return;
        var modal = bootstrap.Modal.getOrCreateInstance(modalElement);
        document.addEventListener('click', function (event) {
            var button = event.target.closest('[data-edit-category]');
            if (!button) return;
            modalElement.querySelector('[data-edit-category-id]').value = button.dataset.id || '';
            modalElement.querySelector('[data-edit-category-name]').value = button.dataset.name || '';
            modalElement.querySelector('[data-edit-category-description]').value = button.dataset.description || '';
            modal.show();
        });
    })();
</script>
}
