@model IReadOnlyList<Sourcing_Tender_Management_System.Models.AuditLog>
@{ ViewData["Title"] = "Audit log"; }
<div id="audit-search-results">
<h1>Audit log</h1>
<p>Most recent 200 recorded actions.</p>
<partial name="_WorkspaceSearch" model="@(new WorkspaceSearchViewModel { Id = "audit-search", ResultsId = "audit-search-results", Label = "Search the latest 200 recorded actions", Action = Url.Action("AuditLogs", "AdminCatalog"), SearchValue = ViewBag.Search, Local = false })" />
<p class="small text-secondary" data-result-count="@ViewBag.TotalCount">Showing @Model.Count of @ViewBag.TotalCount records · Page @ViewBag.CurrentPage of @ViewBag.TotalPages</p>
<div class="table-responsive zt-admin-table"><table class="table table-striped mb-0"><thead><tr><th>Time (UTC)</th><th>User ID</th><th>Action</th><th>Entity</th><th>Entity ID</th></tr></thead><tbody>
@foreach (var entry in Model)
{
    <tr data-search-item><td>@entry.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td><td>@entry.UserId</td><td>@entry.Action</td><td>@entry.EntityName</td><td>@entry.EntityId</td></tr>
}
</tbody></table></div>

@if ((int)ViewBag.TotalPages > 1)
{
    <nav class="d-flex justify-content-between align-items-center gap-3 mt-3" aria-label="Audit log pages">
        <span class="small text-secondary">Page @ViewBag.CurrentPage of @ViewBag.TotalPages</span>
        <div class="d-flex gap-2">
            @if ((int)ViewBag.CurrentPage > 1)
            {
                <a class="btn btn-outline-secondary btn-sm" asp-action="AuditLogs" asp-route-page="@((int)ViewBag.CurrentPage - 1)" asp-route-search="@ViewBag.Search">Previous</a>
            }
            @if ((int)ViewBag.CurrentPage < (int)ViewBag.TotalPages)
            {
                <a class="btn btn-primary btn-sm" asp-action="AuditLogs" asp-route-page="@((int)ViewBag.CurrentPage + 1)" asp-route-search="@ViewBag.Search">Next</a>
            }
        </div>
    </nav>
}

</div>
