@model IReadOnlyList<Sourcing_Tender_Management_System.Models.Supplier>
@using Sourcing_Tender_Management_System.Models
@{ ViewData["Title"] = "Suppliers"; }
<div id="supplier-catalog-search-results">
<h1>Suppliers</h1>
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
@if (TempData["Message"] is string message) { <div class="alert alert-success">@message</div> }
<p>Suppliers register their own accounts. Review registrations here.</p>
<partial name="_WorkspaceSearch" model="@(new WorkspaceSearchViewModel { Id = "supplier-catalog-search", ResultsId = "supplier-catalog-search-results", Label = "Search supplier registrations" })" />

@foreach (var item in Model)
{
    var isNew = item.Id == 0;
    <details data-search-item class="card mb-2" open="@isNew">
        <summary class="card-header">@(isNew ? "Add supplier" : item.CompanyName)</summary>
        <form asp-action="SaveSupplier" method="post" class="card-body row g-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@item.Id" />
            <div class="col-md-6"><label class="form-label">Company name</label><input name="companyName" value="@item.CompanyName" class="form-control" required maxlength="200" /></div>
            <div class="col-md-6"><label class="form-label">Registration number</label><input name="registrationNumber" value="@item.RegistrationNumber" class="form-control" required maxlength="100" /></div>
            <div class="col-md-6"><label class="form-label">Email</label><input name="email" value="@item.Email" type="email" class="form-control" required maxlength="256" /></div>
            <div class="col-md-6"><label class="form-label">Tax number</label><input name="taxNumber" value="@item.TaxNumber" class="form-control" maxlength="100" /></div>
            <div class="col-md-6"><label class="form-label">License number</label><input name="licenseNumber" value="@item.LicenseNumber" class="form-control" maxlength="100" /></div>
            <div class="col-md-6"><label class="form-label">License expiry</label><input name="licenseExpiresAt" value="@item.LicenseExpiresAt?.ToString("yyyy-MM-dd")" type="date" class="form-control" /></div>
            <div class="col-md-6"><label class="form-label">Legal verification</label><select name="legalVerificationStatus" class="form-select">
                @foreach (var status in Enum.GetValues<DocumentVerificationStatus>())
                { <option value="@status" selected="@(item.LegalVerificationStatus == status)">@status</option> }
            </select></div>
            <div class="col-md-6"><label class="form-label">Phone</label><input name="phoneNumber" value="@item.PhoneNumber" class="form-control" maxlength="30" /></div>
            <div class="col-md-6"><label class="form-label">Address</label><input name="address" value="@item.Address" class="form-control" maxlength="500" /></div>
            <div class="col-md-6"><label class="form-label">Registration status</label><select name="registrationStatus" class="form-select">
                @foreach (var status in Enum.GetValues<SupplierRegistrationStatus>())
                { <option value="@status" selected="@(item.RegistrationStatus == status)">@status</option> }
            </select></div>
            <div class="col-md-6"><label class="form-label">Decision reason</label><input name="reviewReason" value="@item.ReviewReason" class="form-control" maxlength="2000" /></div>
            <div class="col-md-6 form-check ms-3"><input type="checkbox" name="isActive" value="true" checked="@(item.IsActive || item.RegistrationStatus == SupplierRegistrationStatus.Pending)" class="form-check-input" id="activeSupplier-@item.Id" /><label for="activeSupplier-@item.Id">Active after approval</label></div>
            <div class="col-12"><button class="btn btn-primary" type="submit">Save supplier</button></div>
        </form>
        @if (!isNew)
        {
            var categories = (IReadOnlyList<Category>)ViewBag.Categories;
            var links = ((IReadOnlyList<SupplierCategory>)ViewBag.SupplierCategories).Where(x => x.SupplierId == item.Id).ToList();
            var documents = ((IReadOnlyList<SupplierDocument>)ViewBag.SupplierDocuments).Where(x => x.SupplierId == item.Id).ToList();
            <div class="card-body border-top">
                <strong>Registration documents</strong>
                @foreach (var document in documents)
                {
                    <div class="d-flex flex-wrap align-items-center gap-2 my-2">
                        <a asp-action="DownloadSupplierDocument" asp-route-id="@document.Id">@document.DocumentType: @document.FileName</a>
                        <span>@document.VerificationStatus</span>
                        <form asp-action="ReviewSupplierDocument" method="post" class="d-flex gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@document.Id" />
                            <input name="notes" value="@document.VerificationNotes" maxlength="1000" class="form-control" placeholder="Review notes" />
                            <button class="btn btn-sm btn-outline-success" name="status" value="Verified">Verify</button>
                            <button class="btn btn-sm btn-outline-danger" name="status" value="Rejected">Reject</button>
                        </form>
                    </div>
                }
            </div>
            <div class="card-body border-top">
                <strong>Categories:</strong>
                @foreach (var link in links)
                {
                    <form asp-action="RemoveSupplierCategory" method="post" class="d-inline-block me-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="supplierId" value="@item.Id" />
                        <input type="hidden" name="categoryId" value="@link.CategoryId" />
                        <span>@categories.First(x => x.Id == link.CategoryId).Name</span>
                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                    </form>
                }
                <form asp-action="AddSupplierCategory" method="post" class="d-flex gap-2 mt-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="supplierId" value="@item.Id" />
                    <select name="categoryId" class="form-select" style="max-width:300px" required>
                        <option value="">Choose category</option>
                        @foreach (var category in categories.Where(x => links.All(y => y.CategoryId != x.Id)))
                        { <option value="@category.Id">@category.Name</option> }
                    </select>
                    <button type="submit" class="btn btn-outline-primary">Add category</button>
                </form>
            </div>
        }
    </details>
}

</div>
