@model List<TenderInvitation>
@{ ViewData["Title"] = "Tender Invitations"; }
<div id="invitation-search-results">
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h2 mb-0">Tender Invitations</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to dashboard</a>
</div>
<p class="text-muted">Review the tenders your company has been invited to participate in. Dates are shown in UTC.</p>
<partial name="_WorkspaceSearch" model="@(new WorkspaceSearchViewModel { Id = "invitation-search", ResultsId = "invitation-search-results", Label = "Search your tender invitations" })" />
@if (Model.Count == 0)
{
    <div class="alert alert-info" role="status">You have no tender invitations yet. Invitations will appear here when a sourcing officer invites your company.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead><tr><th scope="col">Tender</th><th scope="col">Title</th><th scope="col">Invited on (UTC)</th><th scope="col">Deadline (UTC)</th><th scope="col">Your response</th><th scope="col">Action</th></tr></thead>
            <tbody>
            @foreach (var invitation in Model)
            {
                <tr data-search-item>
                    <td>@invitation.Tender.TenderNumber</td>
                    <td>@invitation.Tender.Title</td>
                    <td>@invitation.InvitedAt.ToString("dd MMM yyyy HH:mm")</td>
                    <td>@invitation.Tender.SubmissionDeadline.ToString("dd MMM yyyy HH:mm")</td>
                    <td><span class="badge bg-secondary">@invitation.Status</span></td>
                    <td><a asp-action="Invitation" asp-route-id="@invitation.Id" class="btn btn-sm btn-outline-primary">View details</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

</div>
