@model SupplierDashboardViewModel
@using Microsoft.EntityFrameworkCore
@inject Sourcing_Tender_Management_System.Data.ApplicationDbContext Db
@{
    ViewData["Title"] = "Dashboard";
    var s = Model.Supplier;
    var (statusClass, statusText) = s.RegistrationStatus switch
    {
        SupplierRegistrationStatus.Approved => ("is-approved", "Approved"),
        SupplierRegistrationStatus.Pending => ("is-returned", "Pending approval"),
        SupplierRegistrationStatus.Rejected => ("is-rejected", "Rejected"),
        _ => ("is-rejected", s.RegistrationStatus.ToString())
    };
    var invitations = await Db.TenderInvitations.AsNoTracking().Include(i => i.Tender)
        .Where(i => i.SupplierId == s.Id && i.Tender.Status != TenderStatus.Draft)
        .OrderByDescending(i => i.InvitedAt).Take(5).ToListAsync();
    var offers = await Db.Bids.AsNoTracking().Include(b => b.Tender)
        .Where(b => b.SupplierId == s.Id)
        .OrderByDescending(b => b.SubmittedAt).Take(5).ToListAsync();
    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Good morning" : hour < 18 ? "Good afternoon" : "Good evening";
    var waiting = invitations.Count(i => i.Status == InvitationStatus.Invited);

    static (string css, string text) InviteChip(InvitationStatus st) => st switch
    {
        InvitationStatus.Invited => ("is-returned", "Reply needed"),
        InvitationStatus.Accepted => ("is-approved", "Accepted"),
        InvitationStatus.Declined => ("is-rejected", "Declined"),
        _ => ("is-draft", st.ToString())
    };
    static (string css, string text) BidChip(BidStatus st) => st switch
    {
        BidStatus.Draft => ("is-draft", "Draft"),
        BidStatus.Submitted => ("is-review", "Submitted"),
        BidStatus.UnderReview or BidStatus.UnderEvaluation => ("is-review", "Under review"),
        BidStatus.Compliant => ("is-approved", "Compliant"),
        BidStatus.Accepted => ("is-converted", "Won"),
        BidStatus.Withdrawn => ("is-draft", "Withdrawn"),
        _ => ("is-rejected", st.ToString())
    };
}
<partial name="_WorkspaceLook" />

<div class="zt-app sp-ws">
<div id="supplier-dashboard-search-results" class="manager-page ec-page dp-page">
    <div class="dp-head">
        <div class="manager-page-heading">
            <p class="manager-kicker mb-1">@greeting</p>
            <h1 class="manager-title mb-1">@s.CompanyName</h1>
            <p class="manager-intro mb-0">@(waiting == 0 ? "Nothing is waiting for your reply." : waiting == 1 ? "One invitation is waiting for your reply." : $"{waiting} invitations are waiting for your reply.")</p>
        </div>
        <div class="actions">
            <span class="dp-status @statusClass">@statusText</span>
            <a asp-action="Invitations" class="btn btn-primary">View invitations</a>
        </div>
    </div>

    @if (ViewBag.DevelopmentBypass == true)
    {
        <div class="alert alert-warning" role="status">Your registration is pending. Access is temporarily enabled for development testing.</div>
    }

    <ul class="zt-bento" aria-label="Summary">
        <li><a data-search-item class="zt-tile @(waiting > 0 ? "is-alert" : null)" asp-action="Invitations"><span class="zt-tile-label">Tender invitations</span><span class="zt-tile-value">@Model.Invitations</span><span class="zt-tile-note">@(waiting > 0 ? $"{waiting} need a reply" : "Sent to your company")</span></a></li>
        <li><a data-search-item class="zt-tile" asp-action="Offers"><span class="zt-tile-label">My offers</span><span class="zt-tile-value">@Model.Offers</span><span class="zt-tile-note">Submitted or saved</span></a></li>
        <li><a data-search-item class="zt-tile @(Model.Questions > 0 ? "is-alert" : null)" asp-controller="Messages" asp-action="Index"><span class="zt-tile-label">Messages</span><span class="zt-tile-value">@Model.Questions</span><span class="zt-tile-note">@(Model.Questions > 0 ? "Waiting for your reply" : "Nothing to answer")</span></a></li>
        <li><a data-search-item class="zt-tile" asp-action="Notifications"><span class="zt-tile-label">Notifications</span><span class="zt-tile-value">@Model.UnreadNotifications</span><span class="zt-tile-note">Unread</span></a></li>
    </ul>

    <section class="manager-search-panel mb-4" aria-label="Search the dashboard">
        <partial name="_WorkspaceSearch" model="@(new WorkspaceSearchViewModel { Id = "supplier-dashboard-search", ResultsId = "supplier-dashboard-search-results", Label = "Search invitations, offers and company profile", Placeholder = "Tender, offer or profile detail" })" />
    </section>

    <div class="row g-4">
        <div class="col-xl-8">
            <section class="card manager-card mb-4" aria-labelledby="sd-inv">
                <div class="card-header dp-split"><h2 id="sd-inv" class="h5 mb-0">Latest invitations</h2><a class="dp-more" asp-action="Invitations">View all →</a></div>
                @if (invitations.Count == 0)
                {
                    <p class="empty-state">No invitations yet. When Zaytouna invites you to a tender, it will appear here.</p>
                }
                else
                {
                    <div class="table-responsive"><table class="table table-hover align-middle mb-0">
                        <caption class="visually-hidden">Latest invitations</caption>
                        <thead><tr><th scope="col">Tender</th><th scope="col">Deadline</th><th scope="col">Status</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
                        <tbody>
                        @foreach (var i in invitations)
                        {
                            var chip = InviteChip(i.Status);
                            var daysLeft = (i.Tender.SubmissionDeadline - DateTime.UtcNow).TotalDays;
                            <tr data-search-item>
                                <td><a class="dp-req-title" asp-action="Invitation" asp-route-id="@i.Id">@i.Tender.Title</a><span class="dp-num dp-num-wide" title="@i.Tender.TenderNumber">@i.Tender.TenderNumber</span></td>
                                <td class="text-nowrap"><time class="device-local-time" datetime="@DateTime.SpecifyKind(i.Tender.SubmissionDeadline, DateTimeKind.Utc).ToString("o")">@i.Tender.SubmissionDeadline.ToString("dd MMM yyyy")</time>
                                    <span class="dp-meta mt-0 @(daysLeft is >= 0 and < 3 ? "text-danger fw-semibold" : null)">@(daysLeft < 0 ? "Closed" : Math.Ceiling(daysLeft) + " days left")</span></td>
                                <td><span class="dp-status @chip.css">@chip.text</span></td>
                                <td class="text-end"><a class="btn btn-sm @(i.Status == InvitationStatus.Invited ? "btn-primary" : "btn-outline-primary")" asp-action="Invitation" asp-route-id="@i.Id">@(i.Status == InvitationStatus.Invited ? "Respond" : "Open")</a></td>
                            </tr>
                        }
                        </tbody>
                    </table></div>
                }
            </section>

            <section class="card manager-card mb-4" aria-labelledby="sd-off">
                <div class="card-header dp-split"><h2 id="sd-off" class="h5 mb-0">My recent offers</h2><a class="dp-more" asp-action="Offers">View all →</a></div>
                @if (offers.Count == 0)
                {
                    <p class="empty-state">You haven’t submitted an offer yet. Open an invitation to start one.</p>
                }
                else
                {
                    <div class="table-responsive"><table class="table table-hover align-middle mb-0">
                        <caption class="visually-hidden">My recent offers</caption>
                        <thead><tr><th scope="col">Offer</th><th scope="col" class="text-end">Total</th><th scope="col">Status</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
                        <tbody>
                        @foreach (var b in offers)
                        {
                            var chip = BidChip(b.Status);
                            <tr data-search-item>
                                <td><a class="dp-req-title" asp-action="OfferDetails" asp-route-id="@b.Id">@b.Tender.Title</a><span class="dp-num dp-num-wide" title="@b.BidNumber">@b.BidNumber</span></td>
                                <td class="text-end money fw-semibold">@b.TotalAmount.ToString("N2") @b.Currency</td>
                                <td><span class="dp-status @chip.css">@chip.text</span></td>
                                <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="OfferDetails" asp-route-id="@b.Id">Details</a></td>
                            </tr>
                        }
                        </tbody>
                    </table></div>
                }
            </section>
        </div>

        <div class="col-xl-4">
            <section class="card manager-card mb-4" aria-labelledby="sd-journey">
                <div class="card-header"><h2 id="sd-journey" class="h5 mb-0">Your journey</h2></div>
                @{
                    var approved = s.RegistrationStatus == SupplierRegistrationStatus.Approved;
                    var steps = new (bool Done, bool Now, string Title, string Note)[]
                    {
                        (true, false, "Registered", s.RegisteredAt.ToString("dd MMM yyyy")),
                        (approved, !approved, "Approved by Zaytouna", approved ? "You can bid on tenders" : "Waiting for administrator review"),
                        (Model.Invitations > 0, approved && Model.Invitations == 0, "First invitation", Model.Invitations > 0 ? $"{Model.Invitations} received" : "We invite suppliers by category"),
                        (Model.Offers > 0, Model.Invitations > 0 && Model.Offers == 0, "First offer", Model.Offers > 0 ? $"{Model.Offers} submitted" : "Reply to an invitation with your best offer")
                    };
                }
                <ol class="dp-timeline">
                    @foreach (var st in steps)
                    {
                        <li data-search-item class="@(st.Done ? "is-done" : st.Now ? "is-now" : null)">
                            <span class="fw-semibold d-block">@(st.Done ? "✓ " : null)@st.Title</span>
                            <span class="dp-meta mt-0">@st.Note</span>
                        </li>
                    }
                </ol>
            </section>

            <section class="card manager-card mb-4" aria-labelledby="sd-prof">
                <div class="card-header"><h2 id="sd-prof" class="h5 mb-0">Company profile</h2></div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <caption class="visually-hidden">Company profile</caption>
                        <tbody>
                            <tr data-search-item><th scope="row">Registration no.</th><td class="text-break">@s.RegistrationNumber</td></tr>
                            <tr data-search-item><th scope="row">Email</th><td class="text-break">@s.Email</td></tr>
                            <tr data-search-item><th scope="row">Phone</th><td>@(s.PhoneNumber ?? "Not provided")</td></tr>
                            <tr data-search-item><th scope="row">Address</th><td class="text-break">@(s.Address ?? "Not provided")</td></tr>
                            <tr data-search-item><th scope="row">Legal verification</th><td>@s.LegalVerificationStatus</td></tr>
                            <tr data-search-item><th scope="row">Registered</th><td><time class="device-local-time" datetime="@DateTime.SpecifyKind(s.RegisteredAt, DateTimeKind.Utc).ToString("o")">@s.RegisteredAt.ToString("dd MMM yyyy")</time></td></tr>
                        </tbody>
                    </table>
                </div>
                @if (!string.IsNullOrWhiteSpace(s.ReviewReason))
                {
                    <div class="alert alert-warning m-3 mb-3"><strong>Administrator note:</strong> @s.ReviewReason</div>
                }
            </section>
        </div>
    </div>
</div>
</div>
