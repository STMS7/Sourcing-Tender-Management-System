@model SupplierDashboardViewModel
@{
    ViewData["Title"] = "Supplier Dashboard";
    var statusClass = Model.Supplier.RegistrationStatus == SupplierRegistrationStatus.Approved ? "bg-success"
        : Model.Supplier.RegistrationStatus == SupplierRegistrationStatus.Pending ? "bg-warning text-dark" : "bg-danger";
}
<div id="supplier-dashboard-search-results">
<div class="mb-4">
    <h1 class="h2">Supplier Dashboard</h1>
    <p class="text-muted">Welcome, @Model.Supplier.CompanyName. Here is an overview of your supplier account.</p>
</div>
@if (ViewBag.DevelopmentBypass == true)
{
    <div class="alert alert-warning" role="status">Your registration is pending. Access is temporarily enabled for development testing.</div>
}
<partial name="_WorkspaceSearch" model="@(new WorkspaceSearchViewModel { Id = "supplier-dashboard-search", ResultsId = "supplier-dashboard-search-results", Label = "Search dashboard summaries and company profile" })" />
<div class="row g-3 mb-4">
    <div data-search-item class="col-md-4">
        <div class="card h-100"><div class="card-body">
            <h2 class="h6 text-muted">Tender invitations</h2>
            <p class="display-6 mb-2">@Model.Invitations</p>
            <p class="small text-muted mb-0">All tender invitations sent to your company.</p>
            <a asp-action="Invitations" class="btn btn-outline-primary mt-3">View invitations</a>
        </div></div>
    </div>
    <div data-search-item class="col-md-4">
        <div class="card h-100"><div class="card-body">
            <h2 class="h6 text-muted">My offers</h2>
            <p class="display-6 mb-2">@Model.Offers</p>
            <p class="small text-muted mb-0">All offers submitted or saved by your company.</p>
            <a asp-action="Offers" class="btn btn-outline-primary mt-3">My offers</a>
        </div></div>
    </div>
    <div data-search-item class="col-md-4">
        <div class="card h-100"><div class="card-body">
            <h2 class="h6 text-muted">Pending clarifications</h2>
            <p class="display-6 mb-2">@Model.Questions</p>
            <p class="small text-muted mb-0">Clarification requests awaiting your response.</p>
            <a asp-action="Questions" class="btn btn-outline-primary mt-3">Clarifications</a>
        </div></div>
    </div>
</div>
<div data-search-item class="card mb-4"><div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
    <div><h2 class="h5 mb-1">Notifications</h2><p class="text-muted mb-0">Unread notifications: <strong>@Model.UnreadNotifications</strong></p></div>
    <a asp-action="Notifications" class="btn btn-outline-primary">My notifications</a>
</div></div>
<div data-search-item class="card mb-4">
    <div class="card-header"><h2 class="h5 mb-0">Company profile</h2></div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Company name</dt><dd class="col-sm-8">@Model.Supplier.CompanyName</dd>
            <dt class="col-sm-4">Registration number</dt><dd class="col-sm-8">@Model.Supplier.RegistrationNumber</dd>
            <dt class="col-sm-4">Company email</dt><dd class="col-sm-8">@Model.Supplier.Email</dd>
            <dt class="col-sm-4">Phone number</dt><dd class="col-sm-8">@(Model.Supplier.PhoneNumber ?? "Not provided")</dd>
            <dt class="col-sm-4">Address</dt><dd class="col-sm-8">@(Model.Supplier.Address ?? "Not provided")</dd>
            <dt class="col-sm-4">Registration status</dt><dd class="col-sm-8"><span class="badge @statusClass">@Model.Supplier.RegistrationStatus</span></dd>
            <dt class="col-sm-4">Legal verification</dt><dd class="col-sm-8">@Model.Supplier.LegalVerificationStatus</dd>
            <dt class="col-sm-4">Registered on (UTC)</dt><dd class="col-sm-8">@Model.Supplier.RegisteredAt.ToString("dd MMM yyyy HH:mm")</dd>
        </dl>
        @if (!string.IsNullOrWhiteSpace(Model.Supplier.ReviewReason))
        {
            <div class="alert alert-info mt-3 mb-0"><strong>Administrator note:</strong> @Model.Supplier.ReviewReason</div>
        }
    </div>
</div>

</div>
