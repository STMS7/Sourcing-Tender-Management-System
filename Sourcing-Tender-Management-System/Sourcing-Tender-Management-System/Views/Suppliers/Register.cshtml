async function rebuild(){renderPages();if(!pages.length){setFile(null);return}
var tries=[[1800,.82],[1400,.7],[1100,.6],[900,.5]],blob=null;
for(var t=0;t<tries.length;t++){var imgs=[];for(var i=0;i<pages.length;i++){var j=toJpeg(pages[i].img,tries[t][0],tries[t][1]);imgs.push({w:j.w,h:j.h,bytes:b64bytes(j.url)})}blob=buildPdf(imgs);if(blob.size<=4.8*1024*1024)break}
setFile(new File([blob],'company-document.pdf',{type:'application/pdf'}),'photos')}
function renderPages(){pagesEl.hidden=!pages.length;pagesEl.innerHTML='';pages.forEach(function(p,i){var d=document.createElement('div');d.className='rg-page';d.innerHTML='<img alt="Page '+(i+1)+'"><span>'+(i+1)+'</span><button type="button" aria-label="Remove page '+(i+1)+'">&times;</button>';d.querySelector('img').src=p.thumb;
d.querySelector('button').onclick=function(){pages.splice(i,1);rebuild()};pagesEl.appendChild(d)});
if(pages.length){var add=document.createElement('button');add.type='button';add.className='rg-page-add';add.innerHTML='+ Add<br>page';add.onclick=function(){document.getElementById('rg-imgs').click()};pagesEl.appendChild(add)}}
async function addImages(files){var err=document.getElementById('rg-ferr');for(var i=0;i<files.length;i++){var f=files[i];if(!/^image\//.test(f.type)){continue}
try{var url=URL.createObjectURL(f),im=await loadImg(url);var c=toJpeg(im,1800,.85),img=await loadImg(c.url);pages.push({img:img,thumb:toJpeg(im,260,.7).url});URL.revokeObjectURL(url)}catch(e){err.textContent='One of the photos could not be read. Try a JPG or PNG.';err.hidden=false}}
