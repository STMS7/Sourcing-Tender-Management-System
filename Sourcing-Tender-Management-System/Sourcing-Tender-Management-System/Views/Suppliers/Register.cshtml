if(!f)msg='Please add your company registration document: a PDF, photos, or a camera photo.';else if(!/\.pdf$/i.test(f.name))msg='The document must be a PDF file.';else if(f.size>5*1024*1024)msg='The document must be 5 MB or smaller.';
err.textContent=msg;err.hidden=!msg;return !msg}
