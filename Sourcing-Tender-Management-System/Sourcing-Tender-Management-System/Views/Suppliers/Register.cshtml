<script>
// Address helpers: current location or a pin on the map, written into the Address field.
(function(){
var addr=document.getElementById('Address'),st=document.getElementById('rg-loc-status'),geo=document.getElementById('rg-geo'),pick=document.getElementById('rg-pick'),wrap=document.getElementById('rg-map-wrap'),map=null,pin=null,L0=null;
function say(t,c){st.textContent=t;st.className='rg-loc-status'+(c?' '+c:'')}
function loadLeaflet(cb){if(window.L)return cb();var css=document.createElement('link');css.rel='stylesheet';css.href='https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';document.head.appendChild(css);
var js=document.createElement('script');js.src='https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';js.onload=cb;js.onerror=function(){say('The map could not load. Check your internet connection.','err')};document.head.appendChild(js)}
function fill(lat,lng){say('Finding the address…');
fetch('https://nominatim.openstreetmap.org/reverse?format=jsonv2&accept-language=en&lat='+lat+'&lon='+lng,{headers:{'Accept':'application/json'}})
.then(function(r){return r.json()}).then(function(d){var name=(d&&d.display_name)||'';write(name,lat,lng);say('Location added to the address.','ok')})
.catch(function(){write('',lat,lng);say('Pin saved. Add the street name yourself if you like.','ok')})}
function write(name,lat,lng){var coords='Location: '+(+lat).toFixed(5)+', '+(+lng).toFixed(5);var txt=(name?name+'\n':'')+coords;addr.value=txt.slice(0,500);addr.dispatchEvent(new Event('input',{bubbles:true}))}
function place(lat,lng,zoom){if(!map)return;if(!pin){pin=L.marker([lat,lng],{draggable:true}).addTo(map);pin.on('dragend',function(){var p=pin.getLatLng();fill(p.lat,p.lng)})}else pin.setLatLng([lat,lng]);map.setView([lat,lng],zoom||map.getZoom())}
function openMap(cb){wrap.hidden=false;pick.setAttribute('aria-expanded','true');loadLeaflet(function(){if(!map){map=L.map('rg-map',{scrollWheelZoom:false}).setView([32.0,35.9],8);
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'&copy; OpenStreetMap contributors'}).addTo(map);
map.on('click',function(e){place(e.latlng.lat,e.latlng.lng);fill(e.latlng.lat,e.latlng.lng)})}setTimeout(function(){map.invalidateSize();if(cb)cb()},60)})}
pick.addEventListener('click',function(){if(!wrap.hidden&&!cb){wrap.hidden=true;pick.setAttribute('aria-expanded','false');return}openMap()});var cb=null;
geo.addEventListener('click',function(){if(!navigator.geolocation){say('Your browser cannot share its location.','err');return}
geo.disabled=true;say('Asking your browser for your location…');
navigator.geolocation.getCurrentPosition(function(p){geo.disabled=false;var la=p.coords.latitude,lo=p.coords.longitude;openMap(function(){place(la,lo,16)});fill(la,lo)},
function(e){geo.disabled=false;say(e.code===1?'Location permission was blocked. You can pick on the map instead.':'Your location could not be found. Try the map instead.','err')},{enableHighAccuracy:true,timeout:12000})});
})();
</script>
