          </div>
        </section>

        <div class="rg-cam" id="rg-cam" hidden role="dialog" aria-modal="true" aria-label="Take a photo of your document">
          <div class="rg-cam-box">
            <div class="rg-cam-top"><b>Take a photo</b><span id="rg-cam-count">0 pages</span><button type="button" class="rg-cam-x" id="rg-cam-close" aria-label="Close camera">&times;</button></div>
