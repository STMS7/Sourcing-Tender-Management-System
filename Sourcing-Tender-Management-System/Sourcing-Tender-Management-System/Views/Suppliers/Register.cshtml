              <dl><div><dt>Company name</dt><dd data-v="CompanyName"></dd></div><div><dt>Registration number</dt><dd data-v="RegistrationNumber"></dd></div><div><dt>Tax number</dt><dd data-v="TaxNumber"></dd></div><div><dt>License number</dt><dd data-v="LicenseNumber"></dd></div><div><dt>License expiry</dt><dd data-v="LicenseExpiresAt"></dd></div><div><dt>Phone</dt><dd data-v="PhoneNumber"></dd></div><div style="grid-column:1/-1"><dt>Address</dt><dd data-v="Address"></dd></div></dl></div>
            <div class="rg-rev"><div class="rg-rev-h"><span>Account</span><button type="button" data-go="1">Edit</button></div>
              <dl><div><dt>Contact person</dt><dd data-v="FullName"></dd></div><div><dt>Email</dt><dd data-v="Email"></dd></div><div><dt>Password</dt><dd>&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;</dd></div></dl></div>
            <div class="rg-rev"><div class="rg-rev-h"><span>Document</span><button type="button" data-go="2">Edit</button></div>
              <dl><div style="grid-column:1/-1"><dt>Registration certificate</dt><dd data-v="OfficialDocument"></dd></div></dl></div>
          </div>
          <div class="rg-next-note"><i>!</i><span><b>What happens next?</b> An administrator reviews your company and document. You&rsquo;ll be able to sign in to the supplier portal as soon as your account is approved.</span></div>
        </section>

        <div class="rg-nav">
          <button type="button" class="rg-btn ghost" id="rg-back" hidden>&larr; Back</button>
          <span class="rg-count" id="rg-count">1 / 4</span>
          <button type="button" class="rg-btn primary" id="rg-next">Next &rarr;</button>
          <button type="submit" class="rg-btn gold" id="rg-submit" hidden>Submit for approval</button>
        </div>
      </form>
      <p class="rg-login">Already have an account? <a href="/Auth/Login">Sign in</a></p>
    </div>
  </main>
</div>
