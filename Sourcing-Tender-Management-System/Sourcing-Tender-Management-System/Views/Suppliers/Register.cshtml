@model SupplierRegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Supplier Registration";
}
<!DOCTYPE html>
<html lang="en">
<head>
<title>Become a supplier — Zaytouna</title>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" type="image/svg+xml" href="/landing/logo/zaytouna-emblem.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@@12..96,500;12..96,600;12..96,700&family=DM+Mono:wght@@400;500&family=DM+Sans:opsz,wght@@9..40,400;9..40,500;9..40,600;9..40,700&display=swap" rel="stylesheet">
<style>
:root{--cream:#F5F0E1;--white:#FFFDF7;--deep:#3D4A2A;--green:#6B7B3A;--gold:#C9A84C;--grey:#7A7F6A;--beige:#E4DCC8;--light:#E8EBD9;--ink:#2B331F;--red:#A8442A}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;background:var(--cream);color:var(--ink);font-family:'DM Sans',system-ui,sans-serif}
a{color:var(--green)}
.rg{display:grid;grid-template-columns:minmax(300px,420px) 1fr;min-height:100vh}
.rg-side{position:relative;overflow:hidden;background:var(--deep);color:#F5F0E1;padding:36px 36px 30px;display:flex;flex-direction:column}
.rg-side::after{content:"";position:absolute;right:-120px;bottom:-120px;width:360px;height:360px;border-radius:50%;background:radial-gradient(closest-side,rgba(201,168,76,.22),transparent);pointer-events:none}
.rg-brand{display:flex;align-items:center;gap:12px;color:#F5F0E1;text-decoration:none}
.rg-brand img{width:54px;height:54px;object-fit:contain}
.rg-brand b{display:block;font-family:'Bricolage Grotesque',sans-serif;font-size:21px}.rg-brand b i{color:var(--gold);font-style:normal}
.rg-brand small{font-family:'DM Mono',monospace;font-size:10px;letter-spacing:.18em;text-transform:uppercase;opacity:.7}
.rg-side h1{margin:46px 0 10px;font-family:'Bricolage Grotesque',sans-serif;font-weight:600;font-size:clamp(28px,2.6vw,38px);line-height:1.08}
.rg-side h1 em{font-style:normal;color:var(--gold)}
.rg-side>p{margin:0 0 34px;font-size:15px;line-height:1.6;color:#D6DAC5}
.rg-steps{list-style:none;margin:0;padding:0;display:grid;gap:4px}
.rg-steps li{position:relative;display:grid;grid-template-columns:38px 1fr;gap:12px;align-items:center;padding:10px 0;color:#AEB59C}
.rg-steps li:not(:last-child)::after{content:"";position:absolute;left:18px;top:46px;height:calc(100% - 34px);width:2px;background:rgba(245,240,225,.15)}
.rg-steps li.done:not(:last-child)::after{background:var(--gold)}
.rg-num{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;border:1.5px solid rgba(245,240,225,.3);font-family:'DM Mono',monospace;font-size:13px;transition:background .3s,border-color .3s,color .3s}
.rg-steps b{display:block;font-size:15px;color:inherit}.rg-steps small{font-size:12.5px;opacity:.75}
.rg-steps li.on{color:#F5F0E1}.rg-steps li.on .rg-num{background:var(--gold);border-color:var(--gold);color:var(--deep);font-weight:600}
.rg-steps li.done{color:#E8EBD9}.rg-steps li.done .rg-num{background:transparent;border-color:var(--gold);color:var(--gold)}
.rg-steps li.wait .rg-num{border-style:dashed}
.rg-side-foot{margin-top:auto;padding-top:30px;font-size:13px;color:#AEB59C}.rg-side-foot a{color:#F5F0E1}
.rg-main{display:flex;align-items:flex-start;justify-content:center;padding:48px 40px}
.rg-card{width:100%;max-width:760px}
.rg-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}
.rg-kicker{font-family:'DM Mono',monospace;font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--green)}
.rg-home{font-size:14px;color:var(--grey);text-decoration:none}.rg-home:hover{color:var(--deep)}
.rg-bar{height:6px;border-radius:6px;background:var(--beige);overflow:hidden;margin-bottom:28px}
.rg-bar i{display:block;height:100%;width:25%;border-radius:6px;background:linear-gradient(90deg,var(--green),var(--gold));transition:width .5s cubic-bezier(.2,.8,.2,1)}
.rg-panel{background:var(--white);border:1px solid var(--beige);border-radius:24px;padding:36px 38px;box-shadow:0 30px 60px -44px rgba(61,74,42,.5)}
.rg-step{display:none;animation:rg-in .45s cubic-bezier(.2,.8,.2,1)}
.rg-step.on{display:block}
@@keyframes rg-in{from{opacity:0;transform:translateX(18px)}to{opacity:1;transform:none}}
.rg-step h2{margin:0 0 6px;font-family:'Bricolage Grotesque',sans-serif;font-weight:600;font-size:30px;color:var(--deep)}
.rg-step>p{margin:0 0 26px;color:var(--grey);font-size:15px;line-height:1.55}
.rg-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px 20px}
.rg-full{grid-column:1/-1}
.rg-f label{display:block;margin-bottom:7px;font-size:14px;font-weight:600;color:var(--deep)}
.rg-f label .req{color:var(--gold)}
.rg-f.is-req>label::after{content:" *";color:var(--gold)}
.rg-f input,.rg-f textarea{width:100%;font:inherit;font-size:15.5px;color:var(--ink);background:#FBF8EF;border:1.5px solid var(--beige);border-radius:14px;padding:13px 15px;transition:border-color .2s,box-shadow .2s,background .2s}
.rg-f textarea{min-height:90px;resize:vertical}
.rg-f input:focus,.rg-f textarea:focus{outline:none;border-color:var(--green);background:#fff;box-shadow:0 0 0 4px rgba(107,123,58,.15)}
.rg-f .input-validation-error{border-color:var(--red);background:#FDF3EF}
.rg-f .field-validation-error,.rg-f .text-danger{display:block;margin-top:6px;font-size:13px;color:var(--red)}
.rg-hint{margin-top:6px;font-size:12.5px;color:var(--grey)}
.rg-summary{margin:0 0 22px;padding:14px 18px;border-radius:14px;background:#FDF3EF;border:1px solid #EBC9BD;color:var(--red);font-size:14px}
.rg-summary ul{margin:0;padding-left:18px}.rg-summary.validation-summary-valid{display:none}
.rg-dev{margin:0 0 20px;padding:12px 16px;border-radius:14px;background:#FBF1D6;border:1px solid #EBD9A4;color:#6A5414;font-size:14px}
.rg-meter{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-top:10px}
.rg-meter i{height:5px;border-radius:5px;background:var(--beige);transition:background .3s}
.rg-meter[data-s="1"] i:nth-child(-n+1){background:var(--red)}.rg-meter[data-s="2"] i:nth-child(-n+2){background:var(--gold)}.rg-meter[data-s="3"] i:nth-child(-n+3){background:#9AAA4E}.rg-meter[data-s="4"] i{background:var(--green)}
.rg-rules{display:flex;flex-wrap:wrap;gap:6px 14px;margin-top:10px;font-size:12.5px;color:var(--grey)}
.rg-rules span::before{content:"○ ";color:var(--beige)}.rg-rules span.ok{color:var(--green)}.rg-rules span.ok::before{content:"● ";color:var(--green)}
.rg-opts{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.rg-f .rg-opt,.rg-opt{display:flex;flex-direction:column;align-items:flex-start;gap:6px;margin:0;padding:20px 18px;border:2px dashed var(--beige);border-radius:20px;background:#FBF8EF;text-align:left;cursor:pointer;font:inherit;color:var(--ink);transition:border-color .2s,background .2s,transform .2s}
.rg-opt:hover,.rg-opts.over .rg-opt{border-color:var(--green);background:var(--light);transform:translateY(-2px)}
.rg-opt-ico{display:grid;place-items:center;width:50px;height:50px;margin-bottom:6px;border-radius:14px;background:var(--light);color:var(--deep)}
.rg-opt:hover .rg-opt-ico{background:var(--deep);color:var(--gold)}
.rg-opt b{font-size:15.5px;color:var(--deep)}.rg-opt small{font-size:12.5px;color:var(--grey);line-height:1.4}
.rg-drop-hint{margin:10px 0 0;text-align:center;font-size:12.5px;color:var(--grey)}
.rg-pages{display:flex;flex-wrap:wrap;gap:10px;margin-top:14px}
.rg-page{position:relative;width:86px;height:112px;border-radius:10px;overflow:hidden;border:1.5px solid var(--beige);background:#fff;box-shadow:0 8px 16px -12px rgba(61,74,42,.6)}
.rg-page img{width:100%;height:100%;object-fit:cover}
.rg-page span{position:absolute;left:6px;bottom:6px;padding:1px 7px;border-radius:99px;background:rgba(61,74,42,.85);color:#F5F0E1;font:600 11px 'DM Mono',monospace}
.rg-page button{position:absolute;right:5px;top:5px;width:24px;height:24px;border-radius:50%;border:0;background:rgba(255,253,247,.95);color:var(--red);font-size:16px;line-height:1;cursor:pointer}
.rg-page-add{display:grid;place-items:center;width:86px;height:112px;border-radius:10px;border:1.5px dashed var(--green);background:var(--light);color:var(--deep);font:600 12px 'DM Sans',sans-serif;cursor:pointer;text-align:center;padding:6px}
.rg-file-x{margin-left:auto;width:32px;height:32px;border-radius:50%;border:0;background:var(--white);color:var(--red);font-size:20px;line-height:1;cursor:pointer}
.rg-cam{position:fixed;inset:0;z-index:50;display:grid;place-items:center;padding:16px;background:rgba(30,36,20,.75);backdrop-filter:blur(4px)}
.rg-cam[hidden]{display:none}
.rg-cam-box{width:min(720px,100%);background:var(--white);border-radius:24px;overflow:hidden;box-shadow:0 40px 80px -30px rgba(0,0,0,.6)}
.rg-cam-top{display:flex;align-items:center;gap:12px;padding:14px 18px;border-bottom:1px solid var(--beige)}
.rg-cam-top b{font-family:'Bricolage Grotesque',sans-serif;font-size:19px;color:var(--deep)}.rg-cam-top span{font:500 12px 'DM Mono',monospace;color:var(--grey)}
.rg-cam-x{margin-left:auto;width:36px;height:36px;border-radius:50%;border:1.5px solid var(--beige);background:none;font-size:20px;cursor:pointer;color:var(--deep)}
.rg-cam-view{position:relative;background:#111;aspect-ratio:4/3}
.rg-cam-view video{width:100%;height:100%;object-fit:cover;display:block}
.rg-cam-frame{position:absolute;inset:8% 14%;border:2px dashed rgba(245,240,225,.8);border-radius:12px;box-shadow:0 0 0 999px rgba(0,0,0,.25)}
.rg-cam-flash{position:absolute;inset:0;background:#fff;opacity:0;pointer-events:none}
.rg-cam-flash.on{animation:rg-flash .35s ease-out}
@@keyframes rg-flash{0%{opacity:.85}100%{opacity:0}}
.rg-cam-bar{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:14px 18px}
.rg-shutter{width:68px;height:68px;border-radius:50%;border:5px solid var(--beige);background:var(--gold);cursor:pointer;box-shadow:inset 0 0 0 4px var(--white);transition:transform .15s}
.rg-shutter:active{transform:scale(.92)}
.rg-cam-tip{margin:0;padding:0 18px 16px;font-size:13px;color:var(--grey);text-align:center}
@@media (max-width:700px){.rg-opts{grid-template-columns:1fr}.rg-cam-bar .rg-btn{padding:0 14px;min-height:44px;font-size:13.5px}}
.rg-file{display:none;align-items:center;gap:14px;margin-top:14px;padding:14px 16px;border-radius:16px;background:var(--light);border:1px solid #D5DBBE}
.rg-file.on{display:flex}
.rg-file i{display:grid;place-items:center;width:42px;height:42px;border-radius:12px;background:var(--deep);color:var(--gold);font-style:normal;font-family:'DM Mono',monospace;font-size:11px;font-weight:600}
.rg-file b{display:block;font-size:14.5px;color:var(--deep);word-break:break-all}.rg-file small{font-size:12.5px;color:var(--grey)}
.rg-loc{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:10px}
.rg-loc-btn{display:inline-flex;align-items:center;gap:8px;min-height:38px;padding:0 14px;border-radius:999px;border:1.5px solid var(--beige);background:var(--white);color:var(--deep);font:600 13.5px 'DM Sans',sans-serif;cursor:pointer;transition:border-color .2s,background .2s}
.rg-loc-btn:hover,.rg-loc-btn[aria-expanded="true"]{border-color:var(--green);background:var(--light)}
.rg-loc-btn[disabled]{opacity:.6;cursor:wait}
.rg-loc-status{font-size:13px;color:var(--grey)}.rg-loc-status.err{color:var(--red)}.rg-loc-status.ok{color:var(--green)}
.rg-map-wrap{margin-top:12px;border:1.5px solid var(--beige);border-radius:16px;overflow:hidden;background:var(--light)}
#rg-map{height:280px}
.rg-map-hint{padding:9px 14px;font-size:12.5px;color:var(--grey);background:var(--white);border-top:1px solid var(--beige)}
.leaflet-container{font-family:'DM Sans',sans-serif}
.rg-review{display:grid;gap:14px}
.rg-rev{border:1px solid var(--beige);border-radius:18px;padding:18px 20px;background:#FBF8EF}
.rg-rev-h{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
.rg-rev-h span{font-family:'DM Mono',monospace;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--green)}
.rg-rev-h button{border:0;background:none;font:600 13.5px 'DM Sans',sans-serif;color:var(--green);cursor:pointer;text-decoration:underline;text-underline-offset:3px}
.rg-rev dl{margin:0;display:grid;grid-template-columns:repeat(2,1fr);gap:10px 20px}
.rg-rev dt{font-size:12px;color:var(--grey)}.rg-rev dd{margin:2px 0 0;font-size:14.5px;font-weight:600;color:var(--ink);word-break:break-word}
.rg-rev dd.empty{color:#B4B7A6;font-weight:400}
.rg-next-note{display:flex;gap:14px;align-items:flex-start;margin-top:18px;padding:16px 18px;border-radius:16px;background:#FBF1D6;border:1px solid #EBD9A4;font-size:14px;line-height:1.5;color:#5E4C12}
.rg-next-note i{flex:none;display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--gold);color:var(--deep);font-style:normal;font-weight:700}
.rg-nav{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:30px;padding-top:24px;border-top:1px solid var(--beige)}
.rg-btn{display:inline-flex;align-items:center;gap:10px;min-height:50px;padding:0 26px;border-radius:999px;border:0;font:700 15.5px 'DM Sans',sans-serif;cursor:pointer;text-decoration:none;transition:background .2s,transform .2s,box-shadow .2s}
.rg-btn.primary{background:var(--deep);color:#F5F0E1}.rg-btn.primary:hover{background:var(--green);transform:translateY(-1px)}
.rg-btn.gold{background:var(--gold);color:var(--deep);box-shadow:0 14px 30px -16px rgba(201,168,76,.9)}.rg-btn.gold:hover{transform:translateY(-1px)}
.rg-btn.ghost{background:transparent;color:var(--deep);border:1.5px solid var(--beige)}.rg-btn.ghost:hover{border-color:var(--deep)}
.rg-btn[hidden]{display:none}
.rg-count{font-family:'DM Mono',monospace;font-size:12.5px;color:var(--grey)}
.rg-login{margin-top:20px;text-align:center;font-size:14px;color:var(--grey)}
@@media (max-width:900px){.rg{grid-template-columns:1fr}.rg-side{padding:24px 22px}.rg-side h1{margin-top:24px}.rg-steps{grid-auto-flow:column;grid-auto-columns:1fr;overflow-x:auto}.rg-steps li{grid-template-columns:1fr;justify-items:center;text-align:center}.rg-steps li::after{display:none}.rg-steps small,.rg-side-foot{display:none}.rg-main{padding:24px 14px}.rg-panel{padding:26px 20px}.rg-grid,.rg-rev dl{grid-template-columns:1fr}}
@@media (prefers-reduced-motion:reduce){.rg-step{animation:none}.rg-bar i{transition:none}}
</style>

</head>
<body>
<div class="rg">
  <aside class="rg-side">
    <a class="rg-brand" href="/"><img src="/landing/logo/zaytouna-emblem-white-transparent.svg" alt=""><span><b>Zaytouna<i>.</i></b><small>Sourcing portal</small></span></a>
    <h1>Become a <em>Zaytouna</em> supplier.</h1>
    <p>Four short steps. We review every application by hand, then open the portal for you.</p>
    <ol class="rg-steps" id="rg-steps">
      <li data-s="0" class="on"><span class="rg-num">1</span><span><b>Company</b><small>Who you are</small></span></li>
      <li data-s="1"><span class="rg-num">2</span><span><b>Account</b><small>How you sign in</small></span></li>
      <li data-s="2"><span class="rg-num">3</span><span><b>Document</b><small>Your registration certificate</small></span></li>
      <li data-s="3"><span class="rg-num">4</span><span><b>Review</b><small>Check and submit</small></span></li>
      <li class="wait"><span class="rg-num">&#10003;</span><span><b>Admin approval</b><small>We review your application</small></span></li>
    </ol>
    <div class="rg-side-foot">Already registered? <a href="/Auth/Login">Sign in</a></div>
  </aside>

  <main class="rg-main">
    <div class="rg-card">
      <div class="rg-top"><span class="rg-kicker" id="rg-kicker">Step 1 of 4</span><a class="rg-home" href="/">&larr; Back to home</a></div>
      <div class="rg-bar" aria-hidden="true"><i id="rg-bar"></i></div>

      <form class="rg-panel" id="rg-form" asp-controller="Suppliers" asp-action="Register" method="post" enctype="multipart/form-data" novalidate>
        @if (ViewBag.DevelopmentBypass == true)
        {
            <div class="rg-dev">Development testing: administrator approval is temporarily deferred. Your application will still be recorded as Pending.</div>
        }
        <div asp-validation-summary="ModelOnly" class="rg-summary" role="alert"></div>

        <!-- Step 1 -->
        <section class="rg-step on" data-step="0" aria-labelledby="rg-h1">
          <h2 id="rg-h1">Company information</h2>
          <p>Tell us about your company. Fields marked <b style="color:var(--gold)">*</b> are required.</p>
          <div class="rg-grid">
              <div class="rg-f is-req"><label asp-for="CompanyName"></label>
                <input asp-for="CompanyName" autocomplete="organization" required />
                <span asp-validation-for="CompanyName"></span></div>
              <div class="rg-f is-req"><label asp-for="RegistrationNumber"></label>
                <input asp-for="RegistrationNumber" required />
                <span asp-validation-for="RegistrationNumber"></span></div>
              <div class="rg-f"><label asp-for="TaxNumber"></label>
                <input asp-for="TaxNumber"  />
                <span asp-validation-for="TaxNumber"></span></div>
              <div class="rg-f"><label asp-for="LicenseNumber"></label>
                <input asp-for="LicenseNumber"  />
                <span asp-validation-for="LicenseNumber"></span></div>
              <div class="rg-f"><label asp-for="LicenseExpiresAt"></label>
                <input asp-for="LicenseExpiresAt"  />
                <span asp-validation-for="LicenseExpiresAt"></span></div>
              <div class="rg-f"><label asp-for="PhoneNumber"></label>
                <input asp-for="PhoneNumber" autocomplete="tel" />
                <span asp-validation-for="PhoneNumber"></span></div>
              <div class="rg-f rg-full"><label asp-for="Address"></label>
                <textarea asp-for="Address" rows="3" maxlength="500" autocomplete="street-address" id="Address" placeholder="Street, building, city"></textarea>
                <div class="rg-loc">
                  <button type="button" class="rg-loc-btn" id="rg-geo"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/><circle cx="12" cy="12" r="8"/></svg>Use my current location</button>
                  <button type="button" class="rg-loc-btn" id="rg-pick" aria-expanded="false" aria-controls="rg-map-wrap"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>Pick on the map</button>
                  <span class="rg-loc-status" id="rg-loc-status" role="status"></span>
                </div>
                <div class="rg-map-wrap" id="rg-map-wrap" hidden><div id="rg-map"></div><div class="rg-map-hint">Click the map or drag the pin to your company&rsquo;s location.</div></div>
                <span asp-validation-for="Address"></span></div>
          </div>
        </section>

        <!-- Step 2 -->
        <section class="rg-step" data-step="1" aria-labelledby="rg-h2">
          <h2 id="rg-h2">Contact &amp; account</h2>
          <p>The person we contact about tenders, and the email and password used to sign in.</p>
          <div class="rg-grid">
              <div class="rg-f is-req"><label asp-for="FullName"></label>
                <input asp-for="FullName" autocomplete="name" required />
                <span asp-validation-for="FullName"></span></div>
              <div class="rg-f is-req"><label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="email" required />
                <span asp-validation-for="Email"></span></div>
              <div class="rg-f is-req"><label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="new-password" required id="Password" aria-describedby="rg-pw-rules" />
                <div class="rg-meter" id="rg-meter" data-s="0" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
                <div class="rg-rules" id="rg-pw-rules"><span data-r="len">6+ characters</span><span data-r="up">Uppercase</span><span data-r="low">Lowercase</span><span data-r="num">Number</span><span data-r="sym">Symbol</span></div>
                <span asp-validation-for="Password"></span></div>
              <div class="rg-f is-req"><label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" autocomplete="new-password" required />
                <span asp-validation-for="ConfirmPassword"></span></div>
          </div>
        </section>

        <!-- Step 3 -->
        <section class="rg-step" data-step="2" aria-labelledby="rg-h3">
          <h2 id="rg-h3">Official document</h2>
          <p>Your company registration certificate. Upload a PDF, upload photos, or take a photo with your camera. Photos are turned into one PDF for you.</p>
          <div class="rg-f">
            <input asp-for="OfficialDocument" type="file" accept="application/pdf,.pdf" id="OfficialDocument" hidden />
            <input type="file" id="rg-pdf" accept="application/pdf,.pdf" hidden />
            <input type="file" id="rg-imgs" accept="image/*" multiple hidden />
            <input type="file" id="rg-camfile" accept="image/*" capture="environment" hidden />
            <div class="rg-opts" id="rg-drop">
              <label class="rg-opt" for="rg-pdf"><span class="rg-opt-ico"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z"/><path d="M14 3v5h5M9 14h6M9 17h4"/></svg></span><b>Upload a PDF</b><small>Already scanned? Choose the file.</small></label>
              <label class="rg-opt" for="rg-imgs"><span class="rg-opt-ico"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="m21 16-5-5-9 9"/></svg></span><b>Upload photos</b><small>JPG or PNG, one or more pages.</small></label>
