@model SourcingManagerDashboardViewModel
@{
    ViewData["Title"] = "Sourcing Manager";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <p class="text-uppercase text-secondary small fw-semibold mb-1">Decision workspace</p>
        <h1 class="h2 mb-1">Sourcing Manager</h1>
        <p class="text-secondary mb-0">Review the committee's consolidated evaluation and record a traceable decision.</p>
    </div>
    <div class="text-end"><span class="badge text-bg-primary fs-6">@Model.PendingReports.Count awaiting review</span></div>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<section class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3"><h2 class="h5 mb-0">Reports awaiting your decision</h2></div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Tender</th><th>Submitted</th><th>Prepared by</th><th>Recommended supplier</th><th>Estimated value</th><th></th></tr></thead>
            <tbody>
            @if (Model.PendingReports.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-secondary py-5">There are no evaluation reports waiting for review.</td></tr>
            }
            else
            {
                @foreach (var report in Model.PendingReports)
                {
                    <tr>
                        <td><strong>@report.Tender.TenderNumber</strong><div class="small text-secondary">@report.Tender.Title</div></td>
                        <td>@(report.SubmittedAt?.ToLocalTime().ToString("dd MMM yyyy, HH:mm") ?? "—")</td>
                        <td>@report.PreparedByUser.FullName</td>
                        <td>@(report.RecommendedBid?.Supplier.CompanyName ?? "No supplier selected")</td>
                        <td>@report.Tender.EstimatedValue.ToString("N2")</td>
                        <td class="text-end"><a class="btn btn-primary btn-sm" asp-action="Details" asp-route-id="@report.Id">Review report</a></td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>

<section class="card shadow-sm border-0">
    <div class="card-header bg-white py-3"><h2 class="h5 mb-0">Recent decisions</h2></div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light"><tr><th>Tender</th><th>Report round</th><th>Decision status</th><th>Updated</th><th></th></tr></thead>
            <tbody>
            @if (Model.RecentReports.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-secondary py-4">No prior manager decisions.</td></tr>
            }
            else
            {
                @foreach (var report in Model.RecentReports)
                {
                    <tr>
                        <td><strong>@report.Tender.TenderNumber</strong><div class="small text-secondary">@report.Tender.Title</div></td>
                        <td>@report.Round</td>
                        <td><span class="badge text-bg-secondary">@report.Status</span></td>
                        <td>@((report.SubmittedAt ?? report.CreatedAt).ToLocalTime().ToString("dd MMM yyyy, HH:mm"))</td>
                        <td class="text-end"><a class="btn btn-outline-secondary btn-sm" asp-action="Details" asp-route-id="@report.Id">Open</a></td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>
