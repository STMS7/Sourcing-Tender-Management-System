@model SourcingManagerDashboardViewModel
@inject Sourcing_Tender_Management_System.Data.ApplicationDbContext Db
@{
    ViewData["Title"] = "Sourcing Manager";
    // The manager also sits on each evaluation committee; surface those tasks here so they are not missed.
    var committeeTasks = await new Sourcing_Tender_Management_System.Controllers.EvaluationCommitteeController(Db)
        { ControllerContext = new Microsoft.AspNetCore.Mvc.ControllerContext { HttpContext = Context } }.ActionNeededCountAsync();
}

<div id="manager-search-results" class="manager-page">
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div class="manager-page-heading">
        <h1 class="manager-title mb-1">Sourcing Manager</h1>
    </div>
    <div class="text-end"><span class="badge fs-6">@Model.PendingReports.Count awaiting review</span></div>
</div>

<ul class="zt-bento" aria-label="Manager summary">
    <li><div class="zt-tile @(Model.PendingReports.Count > 0 ? "is-alert" : "")"><span class="zt-tile-label">Reports awaiting your decision</span><span class="zt-tile-value">@Model.PendingReports.Count</span></div></li>
    <li><div class="zt-tile @(Model.TopDecisionsToForward.Count > 0 ? "is-alert" : "")"><span class="zt-tile-label">Top Committee decisions to forward</span><span class="zt-tile-value">@Model.TopDecisionsToForward.Count</span></div></li>
    <li><a class="zt-tile @(committeeTasks > 0 ? "is-alert" : "")" asp-controller="EvaluationCommittee" asp-action="Index" style="text-decoration:none"><span class="zt-tile-label">Evaluation committee tasks</span><span class="zt-tile-value">@committeeTasks</span><span class="zt-tile-note">@(committeeTasks > 0 ? "Accept or deny agreed bids →" : "Nothing waiting")</span></a></li>
    <li><div class="zt-tile"><span class="zt-tile-label">Recent decisions</span><span class="zt-tile-value">@Model.RecentReports.Count</span><span class="zt-tile-note">Latest 10 shown below</span></div></li>
</ul>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<section class="manager-search-panel mb-4" aria-label="Search manager reports">
    <partial name="_WorkspaceSearch" model="@(new WorkspaceSearchViewModel { Id = "manager-search", ResultsId = "manager-search-results", Label = "Search reports", Placeholder = "Tender, supplier, or decision" })" />
</section>
<section class="card manager-card mb-4">
    <div class="card-header bg-white py-3"><h2 class="h5 mb-0">Reports awaiting your decision</h2></div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Tender</th><th>Submitted</th><th>Prepared by</th><th>Recommended supplier</th><th>Estimated value</th><th></th></tr></thead>
            <tbody>
            @if (Model.PendingReports.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-secondary py-5">There are no evaluation reports waiting for review.</td></tr>
            }
            else
            {
                @foreach (var report in Model.PendingReports)
                {
                    <tr data-search-item>
                        <td><strong>@report.Tender.TenderNumber</strong><div class="small text-secondary">@report.Tender.Title</div></td>
                        <td>@(report.SubmittedAt?.ToLocalTime().ToString("dd MMM yyyy, HH:mm") ?? "—")</td>
                        <td>@report.PreparedByUser.FullName</td>
                        <td>@(report.RecommendedBid?.Supplier.CompanyName ?? "No supplier selected")</td>
                        <td>@report.Tender.EstimatedValue.ToString("N2")</td>
                        <td class="text-end"><a class="btn btn-primary btn-sm" asp-action="Details" asp-route-id="@report.Id">Review report</a></td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>

<section class="card manager-card mb-4">
    <div class="card-header bg-white py-3"><h2 class="h5 mb-0">Top Committee decisions to forward to the sourcing officer</h2></div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light"><tr><th>Tender</th><th>Report round</th><th>Top Committee decision</th><th>Chosen supplier</th><th></th></tr></thead>
            <tbody>
            @if (Model.TopDecisionsToForward.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-secondary py-4">No Top Committee decisions are waiting to be forwarded.</td></tr>
            }
            else
            {
                @foreach (var report in Model.TopDecisionsToForward)
                {
                    <tr data-search-item>
                        <td><strong>@report.Tender.TenderNumber</strong><div class="small text-secondary">@report.Tender.Title</div></td>
                        <td>@report.Round</td>
                        <td><span class="badge text-bg-info">@(report.Status switch { RecommendationStatus.CommitteeApproved => "Approved", RecommendationStatus.CommitteeRejected => "Rejected", _ => "Returned for details" })</span></td>
                        <td>@(report.RecommendedBid?.Supplier.CompanyName ?? "—")</td>
                        <td class="text-end">
                            <form asp-action="ForwardTopDecision" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@report.Id" />
                                <button type="submit" class="btn btn-primary btn-sm">Forward to sourcing officer</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>

<section class="card manager-card">
    <div class="card-header bg-white py-3"><h2 class="h5 mb-0">Recent decisions</h2></div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light"><tr><th>Tender</th><th>Report round</th><th>Decision status</th><th>Updated</th><th></th></tr></thead>
            <tbody>
            @if (Model.RecentReports.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-secondary py-4">No prior manager decisions.</td></tr>
            }
            else
            {
                @foreach (var report in Model.RecentReports)
                {
                    <tr data-search-item>
                        <td><strong>@report.Tender.TenderNumber</strong><div class="small text-secondary">@report.Tender.Title</div></td>
                        <td>@report.Round</td>
                        <td><span class="badge text-bg-secondary">@System.Text.RegularExpressions.Regex.Replace(report.Status.ToString(), "(?<=[a-z])(?=[A-Z])", " ")</span></td>
                        <td>@((report.SubmittedAt ?? report.CreatedAt).ToLocalTime().ToString("dd MMM yyyy, HH:mm"))</td>
                        <td class="text-end"><a class="btn btn-outline-secondary btn-sm" asp-action="Details" asp-route-id="@report.Id">Open</a></td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>

</div>
