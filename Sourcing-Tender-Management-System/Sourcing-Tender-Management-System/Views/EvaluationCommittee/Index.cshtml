@model List<EvaluationCommitteeTenderRow>
@using Sourcing_Tender_Management_System.Services
@{
    ViewData["Title"] = "Evaluation committee";
    var needAction = Model.Where(r => r.ActionNeeded).ToList();
    var inProgress = Model.Where(r => !r.ActionNeeded && !r.Completed).ToList();
    var completed = Model.Where(r => r.Completed).Take(5).ToList();
    var underEvaluation = Model.Count(r => r.Tender.Status == TenderStatus.UnderEvaluation);
}
<link rel="stylesheet" href="~/css/evaluation-committee.css" asp-append-version="true" />
<div class="manager-page ec-page">
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div class="manager-page-heading">
        <h1 class="manager-title mb-1">Evaluation committee</h1>
        <p class="manager-intro mb-0">@(needAction.Count == 0 ? "Nothing is waiting for you right now." : needAction.Count == 1 ? "One tender is waiting for you." : $"{needAction.Count} tenders are waiting for you.")</p>
    </div>
    <a asp-action="Tenders" class="btn btn-outline-primary">All my tenders</a>
</div>
<ul class="zt-bento" aria-label="Committee summary">
    <li><div class="zt-tile"><span class="zt-tile-label">Assigned tenders</span><span class="zt-tile-value">@Model.Count</span></div></li>
    <li><div class="zt-tile @(needAction.Count > 0 ? "is-alert" : "")"><span class="zt-tile-label">Your action needed</span><span class="zt-tile-value">@needAction.Count</span></div></li>
    <li><div class="zt-tile"><span class="zt-tile-label">Under evaluation</span><span class="zt-tile-value">@underEvaluation</span></div></li>
    <li><div class="zt-tile"><span class="zt-tile-label">Report sent</span><span class="zt-tile-value">@Model.Count(r => r.Completed)</span></div></li>
</ul>
@if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }

<section class="card manager-card mb-4">
    <div class="card-header bg-white py-3"><h2 class="h5 mb-0">Needs your action</h2></div>
    @if (needAction.Count == 0) { <p class="empty-state">You are up to date. New tenders and decisions will appear here.</p> }
    else { <partial name="_DashboardRows" model="needAction" view-data="@(new ViewDataDictionary(ViewData) { ["Caption"] = "Tenders that need your action" })" /> }
</section>

<section class="card manager-card mb-4">
    <div class="card-header bg-white py-3"><h2 class="h5 mb-0">In progress</h2></div>
    @if (inProgress.Count == 0) { <p class="empty-state">No other tenders are in progress.</p> }
    else { <partial name="_DashboardRows" model="inProgress" view-data="@(new ViewDataDictionary(ViewData) { ["Caption"] = "Tenders in progress" })" /> }
</section>

@if (completed.Count > 0)
{
<section class="card manager-card mb-4">
    <div class="card-header bg-white py-3"><h2 class="h5 mb-0">Recently completed</h2></div>
    <partial name="_DashboardRows" model="completed" view-data="@(new ViewDataDictionary(ViewData) { ["Caption"] = "Recently completed tenders" })" />
</section>
}
</div>
