@model List<EvaluationCommitteeTenderRow>
@using Sourcing_Tender_Management_System.Services
@{
    ViewData["Title"] = "Evaluation committee";
}
<div id="evaluation-search-results" class="manager-page">
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div class="manager-page-heading">
        <h1 class="manager-title mb-1">Tender preparation and evaluation</h1>
        <p class="manager-intro mb-0">Technical and financial members approve criteria and weights while the tender is a draft. After bidding and compliance, all four members evaluate the compliant offers.</p>
    </div>
    <div class="text-end"><span class="badge fs-6">@ViewBag.ActionCount need your action</span></div>
</div>
<ul class="zt-bento" aria-label="Committee summary">
    <li><div class="zt-tile"><span class="zt-tile-label">Assigned tenders</span><span class="zt-tile-value">@ViewBag.TotalCount</span></div></li>
    <li><div class="zt-tile @((int)ViewBag.ActionCount > 0 ? "is-alert" : "")"><span class="zt-tile-label">Your action needed</span><span class="zt-tile-value">@ViewBag.ActionCount</span></div></li>
    <li><div class="zt-tile"><span class="zt-tile-label">Under evaluation</span><span class="zt-tile-value">@ViewBag.EvaluationCount</span></div></li>
</ul>
@if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
<section class="manager-search-panel mb-4" aria-label="Search assigned tenders">
    <partial name="_WorkspaceSearch" model="@(new WorkspaceSearchViewModel { Id = "evaluation-search", ResultsId = "evaluation-search-results", Label = "Search tenders", Placeholder = "Tender, role, or stage" })" />
</section>
<section class="card manager-card mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center"><h2 class="h5 mb-0">Assigned tenders</h2>@if ((int)ViewBag.TotalCount > 0) { var first = (((int)ViewBag.CurrentPage - 1) * 7) + 1; var last = Math.Min((int)ViewBag.TotalCount, (int)ViewBag.CurrentPage * 7); <small>@first–@last of @ViewBag.TotalCount</small> }</div>
@if ((int)ViewBag.TotalCount == 0) { <p class="empty-state">No tenders are assigned to you for evaluation.</p> }
else {
<div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th scope="col">Tender</th><th scope="col">Your role</th><th scope="col">Status</th><th scope="col">Stage</th><th scope="col">Agreed weights</th></tr></thead><tbody>
@foreach (var row in Model) {
<tr data-search-item class="@(row.ActionNeeded ? "ec-action-row" : null)"><td><a asp-action="Evaluate" asp-route-id="@row.Tender.Id">@row.Tender.Title</a>@if (row.ActionNeeded) { <span class="ec-action-dot">Action needed</span> }</td>
<td>@CommitteeWeighting.RoleLabel(row.Role)</td>
<td><span class="badge">@row.Tender.Status</span></td>
<td>@row.Stage @if (row.ActionNeeded) { <strong class="text-danger">· your action needed</strong> }</td>
<td>@(CommitteeWeighting.Agree(CommitteeWeighting.ReadProposals(row.Tender.EvaluationCriteria)) is { } w ? $"{w.Technical}% / {w.Financial}%" : "Not yet")</td></tr>
}
</tbody></table></div>
}
</section>
@if ((int)ViewBag.TotalPages > 1) {
<nav class="zt-pagination-bar" aria-label="Assigned tender pages"><ul class="pagination mb-0">
    <li class="page-item @((int)ViewBag.CurrentPage == 1 ? "disabled" : null)"><a class="page-link" asp-action="Index" asp-route-page="@((int)ViewBag.CurrentPage - 1)">Previous</a></li>
    @for (var number = 1; number <= (int)ViewBag.TotalPages; number++) { <li class="page-item @(number == (int)ViewBag.CurrentPage ? "active" : null)"><a class="page-link" asp-action="Index" asp-route-page="@number">@number</a></li> }
    <li class="page-item @((int)ViewBag.CurrentPage == (int)ViewBag.TotalPages ? "disabled" : null)"><a class="page-link" asp-action="Index" asp-route-page="@((int)ViewBag.CurrentPage + 1)">Next</a></li>
</ul></nav>
}
</div>
