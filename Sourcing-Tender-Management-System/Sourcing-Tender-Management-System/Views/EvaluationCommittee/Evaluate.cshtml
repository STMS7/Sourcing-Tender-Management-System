@model EvaluationCommitteeViewModel
@using Sourcing_Tender_Management_System.Services
@{
    var tender = Model.Tender;
    var open = tender.Status == TenderStatus.UnderEvaluation;
    var preparing = tender.Status == TenderStatus.Draft && tender.EvaluationCriteriaLockedAt != null;
    var offersReleased = tender.Status is TenderStatus.UnderEvaluation or TenderStatus.AwaitingManagerReview or TenderStatus.AwaitingCommitteeDecision or TenderStatus.Awarded;
    string BidLabel(int? id) => Model.Bids.FirstOrDefault(b => b.Id == id) is { } b ? b.Supplier.CompanyName : "Not chosen";
    string ReviewLabel(CommitteeWeighting.ReviewState s) => s switch
    {
        CommitteeWeighting.ReviewState.Accepted => "Accepted",
        CommitteeWeighting.ReviewState.Denied => "Denied",
        _ => "Pending"
    };
    var criteria = tender.EvaluationCriteria.Where(c => !CommitteeWeighting.IsWeightProposal(c)).OrderBy(c => c.Type).ThenBy(c => c.Name).ToList();
    var myType = Model.MyRole == CommitteeMemberRole.TechnicalRepresentative ? CriterionType.Technical : CriterionType.Financial;
    var myCriteria = criteria.Where(c => c.Type == myType).ToList();
    var myReview = Model.Reviews.GetValueOrDefault(Model.MyRole);
    ViewData["Title"] = "Evaluate " + tender.Title;
}
<link rel="stylesheet" href="~/css/evaluation-committee.css" asp-append-version="true" />
<div id="evaluation-details-search-results" class="manager-page ec-page">
<p><a asp-action="Tenders" class="link-secondary text-decoration-none">&larr; Back to my tenders</a></p>
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4 manager-detail-head">
    <div>
        <h1 class="manager-title mb-1">@tender.Title</h1>
        <div class="manager-intro">You are the <strong>@CommitteeWeighting.RoleLabel(Model.MyRole)</strong> on this tender.</div>
    </div>
    <span class="badge fs-6">@System.Text.RegularExpressions.Regex.Replace(tender.Status.ToString(), "(?<=[a-z])(?=[A-Z])", " ")</span>
</div>
@{
    // The member's own progress decides "Your turn"; the role alone would still say so after they acted.
    bool? journeyTurn = null; string? journeyActor = null; string? journeyAction = null;
    if (preparing && Model.AgreedWeights == null) journeyTurn = !Model.IsReviewer && Model.MyProposal == null;
    else if (open && Model.AgreedBidId == null)
    {
        journeyTurn = !Model.IsReviewer && Model.MyChoiceBidId == null;
        journeyActor = "Technical + financial members";
        journeyAction = Model.IsReviewer ? "They each choose a bid; you review it once they agree." : Model.MyChoiceBidId == null ? "Choose the bid you recommend below. The other member must choose the same one." : "You chose a bid. Waiting for the other member to choose the same bid.";
    }
    else if (open)
    {
        journeyTurn = Model.IsReviewer && Model.Reviews.GetValueOrDefault(Model.MyRole) == CommitteeWeighting.ReviewState.Pending;
        journeyActor = "Manager + department representative";
        journeyAction = journeyTurn == true ? "Accept or deny the agreed bid below." : "Waiting for the manager and department representative to accept the agreed bid.";
    }
}
@await Component.InvokeAsync("TenderJourney", new { tenderId = tender.Id, yourTurn = journeyTurn, actor = journeyActor, action = journeyAction })
@if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }

<section class="manager-search-panel mb-4" aria-label="Search this tender">
    <partial name="_WorkspaceSearch" model="@(new WorkspaceSearchViewModel { Id = "evaluation-details-search", ResultsId = "evaluation-details-search-results", Label = "Search this tender", Placeholder = "Bid, item, or criterion" })" />
</section>
@if (Model.SubmittedReport is { } report) {
<section class="card manager-card mb-4">
<div class="card-header bg-white py-3"><h2 class="h5 mb-0">Submitted report</h2></div>
<div class="card-body">
<div class="alert alert-success mb-0" role="status">Report status: <strong>@System.Text.RegularExpressions.Regex.Replace(report.Status.ToString(), "(?<=[a-z])(?=[A-Z])", " ")</strong></div>
</div>
</section>
}

<section class="card manager-card mb-4">
<div class="card-header bg-white py-3"><h2 class="h5 mb-0">Step 1 — @(preparing ? "Pre-publication approval (technical and financial members)" : "Approved evaluation weights")</h2></div>
<div class="card-body">
<p class="manager-intro">Each member proposes a technical and a financial weight (total 100%). The agreed weight of each type is the average of both members' proposals.</p>
@if (preparing) { <p class="alert alert-info">Propose only the overall Technical/Financial split. The two values must total 100%. The final split is the average of the Technical and Financial members' proposals and applies to all four committee members.</p> }
@if (Model.AgreedWeights is { } agreed) {
<div class="table-responsive"><table class="table align-middle mb-0"><caption>Agreed weights are final.</caption><thead><tr><th scope="col">Member</th><th scope="col">Technical</th><th scope="col">Financial</th></tr></thead><tbody>
@foreach (var p in Model.Proposals) { <tr><td>@CommitteeWeighting.RoleLabel(p.Role)</td><td>@p.Technical%</td><td>@p.Financial%</td></tr> }
<tr class="table-primary"><th scope="row">Agreed (average)</th><td><strong>@agreed.Technical%</strong></td><td><strong>@agreed.Financial%</strong></td></tr>
</tbody></table></div>
} else if (Model.IsReviewer) {
<p class="mb-0">Waiting for the technical and financial members to submit their weights.</p>
} else {
<p>Your proposal: @(Model.MyProposal is { } mine ? $"technical {mine.Technical}%, financial {mine.Financial}%" : "not submitted").
Other member: @(Model.OtherProposalSubmitted ? "submitted (hidden until both submit)" : "not submitted").</p>
@if (preparing) {
<form asp-action="SubmitWeights" method="post" class="border p-3">
<input type="hidden" name="tenderId" value="@tender.Id" />
<h3 class="h5">Propose the overall evaluation split</h3>
<div class="row g-3">
<div class="col-md-4"><label for="technicalWeight" class="form-label">Technical weight (%)</label><input id="technicalWeight" name="technicalWeight" type="number" min="0" max="100" step="0.01" required class="form-control" value="@Model.MyProposal?.Technical" /></div>
<div class="col-md-4"><label for="financialWeight" class="form-label">Financial weight (%)</label><input id="financialWeight" name="financialWeight" type="number" min="0" max="100" step="0.01" required class="form-control" value="@Model.MyProposal?.Financial" /></div>
</div>
<p class="small mt-3">Example: Technical 60% and Financial 40%. Both members submit independently; the system calculates their average.</p>
<div class="actions mt-3"><button type="submit" class="btn btn-primary">@(Model.MyProposal == null ? "Submit split proposal" : "Update split proposal")</button></div>
</form>
}
}
</div>
</section>

@if (open) {
<section class="card manager-card mb-4">
<div class="card-header bg-white py-3"><h2 class="h5 mb-0">Step 2 — Agreed bid (technical and financial members)</h2></div>
<div class="card-body">
@if (Model.LastDenial is { } denial) {
<div class="alert alert-warning" role="alert">@CommitteeWeighting.RoleLabel(denial.Role) denied the previous agreed bid on @denial.At.ToString("dd MMM yyyy HH:mm") UTC. Reason: @denial.Reason. The technical and financial members must choose again.</div>
}
@if (Model.AgreedBidId is int agreedBid) {
<div class="alert alert-success mb-0" role="status">Technical and financial members agreed on <strong>@BidLabel(agreedBid)</strong>.</div>
} else if (Model.IsReviewer) {
<p class="mb-0">Waiting for the technical and financial members to agree on one bid.</p>
} else {
<p>Your choice: @BidLabel(Model.MyChoiceBidId). Other member: @(Model.OtherChoiceBidId == null ? "not chosen" : Model.BothChosen ? BidLabel(Model.OtherChoiceBidId) : "chosen").</p>
@if (Model.BothChosen) { <div class="alert alert-warning" role="alert">The two members chose different bids. Discuss and change a choice until both match.</div> }
@if (Model.AgreedWeights == null) { <p class="manager-intro mb-0">Bids can be chosen after both members submit weights.</p> }
}
</div>
</section>

<section class="card manager-card mb-4">
<div class="card-header bg-white py-3"><h2 class="h5 mb-0">Step 3 — Sourcing manager and department decision</h2></div>
<div class="card-body">
@if (Model.AgreedBidId == null) {
<p class="manager-intro mb-0">Starts after the technical and financial members agree on a bid.</p>
} else {
<ul>@foreach (var role in CommitteeWeighting.Reviewers) { <li>@CommitteeWeighting.RoleLabel(role): <strong>@ReviewLabel(Model.Reviews.GetValueOrDefault(role))</strong></li> }</ul>
@if (Model.IsReviewer) {
<p>Your decision: <strong>@ReviewLabel(myReview)</strong>. All four members must agree on the same bid before the report goes to the sourcing officer.</p>
<div class="row g-3">
<div class="col-md-6"><form asp-action="Review" method="post" class="border p-3 h-100">
<input type="hidden" name="tenderId" value="@tender.Id" /><input type="hidden" name="decision" value="accept" />
<p>Accept <strong>@BidLabel(Model.AgreedBidId)</strong>.</p>
<button type="submit" class="btn btn-success" disabled="@(myReview == CommitteeWeighting.ReviewState.Accepted)">@(myReview == CommitteeWeighting.ReviewState.Accepted ? "Accepted" : "Accept")</button>
</form></div>
<div class="col-md-6"><form asp-action="Review" method="post" class="border p-3 h-100">
<input type="hidden" name="tenderId" value="@tender.Id" /><input type="hidden" name="decision" value="deny" />
<label for="deny-reason" class="form-label">Reason for denying</label>
<textarea id="deny-reason" name="reason" maxlength="900" required class="form-control mb-2" rows="2"></textarea>
<button type="submit" class="btn btn-outline-danger">Deny — technical and financial choose again</button>
</form></div>
</div>
}
}
</div>
</section>
}

@if (offersReleased) {
<section class="card manager-card mb-4">
<div class="card-header bg-white py-3"><h2 class="h5 mb-0">Compliant bids</h2></div>
@if (Model.Bids.Count == 0) { <p class="empty-state">No compliant bids were forwarded.</p> }
@foreach (var bid in Model.Bids) {
<article data-search-item id="bid-@bid.Id" class="manager-bid">
<h3>@bid.Supplier.CompanyName @if (bid.Id == Model.AgreedBidId) { <span class="badge">Agreed</span> } else if (bid.Id == Model.MyChoiceBidId) { <span class="badge">Your choice</span> }</h3>
<p><strong>Total:</strong> @bid.TotalAmount.ToString("N2") @bid.Currency · <strong>Delivery:</strong> @bid.DeliveryDays days · <strong>Valid until:</strong> @(bid.ValidUntil?.ToString("dd MMM yyyy") ?? "Not specified")</p>
<p><strong>Payment terms:</strong> @bid.PaymentTerms</p>
<p class="preserve-lines"><strong>Technical summary:</strong> @bid.TechnicalSummary</p>
<div class="table-responsive mb-4"><table class="table align-middle"><caption>Cost components in @bid.Currency</caption><thead><tr><th scope="col">Tax</th><th scope="col">Fees</th><th scope="col">Shipping</th><th scope="col">Installation</th><th scope="col">Maintenance</th></tr></thead><tbody><tr><td>@bid.TaxAmount.ToString("N2")</td><td>@bid.FeesAmount.ToString("N2")</td><td>@bid.ShippingAmount.ToString("N2")</td><td>@bid.InstallationAmount.ToString("N2")</td><td>@bid.MaintenanceAmount.ToString("N2")</td></tr></tbody></table></div>
<div class="table-responsive mb-4"><table class="table table-hover align-middle"><thead><tr><th scope="col">Item</th><th scope="col">Quantity</th><th scope="col">Unit price</th><th scope="col">Line total</th><th scope="col">Technical response</th></tr></thead><tbody>
@foreach (var item in tender.Items) {
    var offered = bid.Items.FirstOrDefault(i => i.TenderItemId == item.Id);
    <tr data-search-item><td>@item.ItemName<br /><small>@item.Specifications</small></td><td>@item.Quantity @item.Unit</td><td>@(offered?.UnitPrice.ToString("N2") ?? "Not quoted")</td><td>@(offered?.TotalPrice.ToString("N2") ?? "Not quoted")</td><td class="preserve-lines">@offered?.TechnicalResponse @offered?.BrandOrModel</td></tr>
}
</tbody></table></div>
@if (bid.Documents.Count > 0) { <p><strong>Documents:</strong> @string.Join(", ", bid.Documents.Select(d => d.FileName))</p> }
@if (open && !Model.IsReviewer && Model.AgreedWeights != null && Model.AgreedBidId == null && bid.Id != Model.MyChoiceBidId) {
<form asp-action="ChooseBid" method="post"><input type="hidden" name="tenderId" value="@tender.Id" /><input type="hidden" name="bidId" value="@bid.Id" /><button type="submit" class="btn btn-primary" aria-label="Choose bid from @bid.Supplier.CompanyName">Choose this bid</button></form>
}
</article>
}
</section>

} else {
    <p class="alert alert-info">Supplier offers stay sealed until bidding closes, compliance is completed and the sourcing officer forwards them for evaluation.</p>
}
<section class="card manager-card mb-4">
<div class="card-header bg-white py-3"><h2 class="h5 mb-0">Preparation details</h2></div>
<div class="card-body">
<p class="preserve-lines">@tender.Description</p>
<p><strong>Deadline:</strong> @tender.SubmissionDeadline.ToString("dd MMM yyyy HH:mm") UTC</p>
<p class="preserve-lines"><strong>Terms:</strong> @tender.TermsAndConditions</p>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th scope="col">Item</th><th scope="col">Quantity</th><th scope="col">Specifications</th></tr></thead><tbody>
@foreach (var item in tender.Items) { <tr data-search-item><td>@item.ItemName</td><td>@item.Quantity @item.Unit</td><td class="preserve-lines">@item.Specifications</td></tr> }
</tbody></table></div>
<p class="mb-0"><strong>Required documents:</strong> @(tender.DocumentRequirements.Count == 0 ? "None configured" : string.Join(", ", tender.DocumentRequirements.Select(d => d.DocumentType + (d.IsMandatory ? " (mandatory)" : " (optional)"))))</p>
</div>
</section>
@if (criteria.Count > 0) {
<section class="card manager-card mb-5">
<div class="card-header bg-white py-3"><h2 class="h5 mb-0">Tender evaluation criteria</h2></div>
<div class="card-body">
<ul class="mb-0">@foreach (var c in criteria) {
    var assigned = !preparing || (c.Type == myType ? Model.MyProposal != null : Model.OtherProposalSubmitted);
    <li data-search-item><strong>@c.Name</strong> (@c.Type, @(assigned ? c.Weight.ToString("0.##") + "%" : "pending committee"), maximum score @c.MaximumScore)<p class="preserve-lines">@c.Description</p></li>
}</ul>
</div>
</section>
}
</div>

@if (offersReleased && Model.Bids.Count > 0)
{
    <partial name="_BidAnalysisButton" model="@(new BidAnalysisButtonViewModel { Url = Url.Action("AnalyzeBids", "EvaluationCommittee", new { tenderId = tender.Id })!, TenderNumber = tender.TenderNumber })" />
}
