@* Frame of the profile pages ("Manage your account"). Overrides the default Identity UI frame so the
   built-in pages (Profile, Email, Password, 2FA, Personal data) and Biometrics share the workspace look.
   Suppliers keep the plain frame inside their own portal theme. *@
@using Microsoft.AspNetCore.Identity
@using Sourcing_Tender_Management_System.Models
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout != null)
        Layout = parentLayout.ToString();
    else
        Layout = "/Areas/Identity/Pages/_Layout.cshtml";

    var supplier = User.IsInRole("Supplier");
    var me = await UserManager.GetUserAsync(User);
    var name = string.IsNullOrWhiteSpace(me?.FullName) ? User.Identity?.Name ?? "" : me!.FullName;
    var initial = string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1].ToUpperInvariant();
    var roles = me == null ? new List<string>() : (await UserManager.GetRolesAsync(me)).ToList();
    var currentPage = ((ViewContext.RouteData.Values["page"] as string) ?? "").Split('/').Last();
    var menu = new List<(string Page, string Label, string Icon)>
    {
        ("Index", "Profile", "M12 12a4 4 0 100-8 4 4 0 000 8zM4 20c1-4 4-6 8-6s7 2 8 6"),
        ("Email", "Email", "M3 5h18v14H3zM3 6l9 7 9-7"),
        ("ChangePassword", "Password", "M6 11h12v10H6zM8 11V7a4 4 0 018 0v4"),
    };
    if ((await SignInManager.GetExternalAuthenticationSchemesAsync()).Any())
        menu.Add(("ExternalLogins", "External logins", "M10 14a5 5 0 007 0l3-3a5 5 0 00-7-7l-1 1M14 10a5 5 0 00-7 0l-3 3a5 5 0 007 7l1-1"));
    menu.Add(("TwoFactorAuthentication", "Two-factor authentication", "M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"));
    menu.Add(("PersonalData", "Personal data", "M6 3h9l4 4v14H6zM14 3v5h5M9 13h6M9 17h6"));
    menu.Add(("Biometrics", "Biometrics", "M12 11v4M8 9a4 4 0 018 0v6a4 4 0 01-8 0M4 12a8 8 0 0116 0"));
    bool IsActive(string page) => string.Equals(currentPage, page, StringComparison.OrdinalIgnoreCase) ||
        (page == "TwoFactorAuthentication" && currentPage is "EnableAuthenticator" or "Disable2fa" or "GenerateRecoveryCodes" or "ResetAuthenticator" or "ShowRecoveryCodes") ||
        (page == "PersonalData" && currentPage is "DeletePersonalData" or "DownloadPersonalData");
    string Pretty(string role) => System.Text.RegularExpressions.Regex.Replace(role, "(?<=[a-z])(?=[A-Z])", " ");
}
@if (supplier)
{
    <h1>Manage your account</h1>
    <div class="row mt-3">
        <div class="col-md-3"><partial name="_ManageNav" /></div>
        <div class="col-md-9">@RenderBody()</div>
    </div>
}
else
{
<div class="manager-page ec-page dp-page pf-page">
    <div class="dp-head">
        <div class="manager-page-heading">
            <h1 class="manager-title mb-1">My profile</h1>
            <p class="manager-intro mb-0">Manage your account details, sign-in and security settings.</p>
        </div>
    </div>

    <section class="manager-card pf-hero mb-4" aria-label="Account summary">
        <span class="pf-avatar" aria-hidden="true">@initial</span>
        <div class="pf-who">
            <strong>@name</strong>
            <span>@me?.Email</span>
            @if (roles.Count > 0)
            {
                <span class="pf-roles">@foreach (var r in roles) { <span class="badge">@Pretty(r)</span> }</span>
            }
        </div>
        <dl class="pf-facts">
            <div><dt>Email</dt><dd>@(me?.EmailConfirmed == true ? "Confirmed" : "Not confirmed")</dd></div>
            <div><dt>Two-factor</dt><dd>@(me?.TwoFactorEnabled == true ? "On" : "Off")</dd></div>
        </dl>
    </section>

    <div class="row g-4">
        <div class="col-lg-4 col-xl-3">
            <nav class="card manager-card pf-nav" aria-label="Account settings">
                <div class="card-header"><h2 class="h5 mb-0">Settings</h2></div>
                <div class="pf-menu">
                @foreach (var item in menu)
                {
                    var on = IsActive(item.Page);
                    <a asp-page="./@item.Page" class="@(on ? "is-active" : null)" aria-current="@(on ? "page" : null)">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="@item.Icon"></path></svg>
                        <span>@item.Label</span>
                    </a>
                }
                </div>
            </nav>
        </div>
        <div class="col-lg-8 col-xl-9">
            <section class="card manager-card pf-body">
                @RenderBody()
            </section>
        </div>
    </div>
</div>
}
@section Scripts {
    @RenderSection("Scripts", required: false)
}
