@using Sourcing_Tender_Management_System.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model SupplierOfferViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sample image fixture</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body>
<main class="container py-4" style="max-width:900px">
    <h1 class="h3">Sample image fixture</h1>
    <p>Synthetic UI preview. No database connection.</p>
    <form method="post" enctype="multipart/form-data" data-bid-pricing>
        <label for="price">Unit price (test quantity 1)</label>
        <input id="price" name="Items[0].UnitPrice" type="number" min="0.01" step="0.01" value="100" data-item-quantity="1" class="form-control mb-2" />
        <label for="shipping">Shipping amount</label>
        <input id="shipping" name="ShippingAmount" type="number" min="0" step="0.01" value="10" class="form-control mb-2" />
        <partial name="~/Views/Suppliers/_BidPricingSummary.cshtml" />
        <partial name="~/Views/Suppliers/_SampleImageUpload.cshtml" model="Model" />
    </form>
    <partial name="~/Views/Suppliers/_SampleImages.cshtml" model="@((bool)ViewData["Empty"]! ? Array.Empty<BidSampleImage>() : new[] { new BidSampleImage { Id = 1, FileName = "Sample photograph.png", FileSize = 1000 }, new BidSampleImage { Id = 2, FileName = "عينة-منتج-باسم-طويل-للتحقق-من-التفاف-النص.png", FileSize = 2000 } })" />
</main>
<script src="/js/supplier-bid-pricing.js" defer></script>
</body>
</html>
